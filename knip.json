{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": ["types"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs,sh}", "functions/**/*.ts!", "e2e/**/*.ts"],
      "project": ["contracts/**/*.ts", "e2e/**/*.ts"],
      "ignoreDependencies": ["@sentry/cli", "serve"]
    },
    "packages/game-engine": {
      "entry": ["type-tests/**/*.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/api-worker": {
      "entry": [
        "src/e2e/index.ts!",
        "src/games/undercover/dbSchema.ts!",
        "src/platform/ai/dbSchema.ts!",
        "type-tests/**/*.ts!"
      ],
      "project": ["src/**/*.ts!", "type-tests/**/*.ts!"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/web": {
      "project": ["src/**/*.{ts,tsx}!"],
      "ignoreUnresolved": ["^~icons/"],
      "ignoreDependencies": ["@iconify-json/ion", "@svgr/plugin-jsx"]
    }
  }
}
