# Cloudflare Pages custom headers

# Vite emits content-hashed filenames under /assets/; PWA icons there are versioned by the
# manifest. Deploy builds load them from the CDN, while preview builds serve them from Pages.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate on every request
# (stale HTML references deleted JS bundles → white screen)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache


# WeChat domain verification file
/HVChYlYloJ.txt
  Content-Type: text/plain
  Cache-Control: no-cache, no-store, must-revalidate

# Security headers for all responses
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
