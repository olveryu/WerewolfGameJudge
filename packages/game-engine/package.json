{
  "name": "@werewolf/game-engine",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./models/*": {
      "types": "./src/models/*.ts",
      "default": "./dist/models/*.js"
    },
    "./models/roles": {
      "types": "./src/models/roles/index.ts",
      "default": "./dist/models/roles/index.js"
    },
    "./models/roles/*": {
      "types": "./src/models/roles/*.ts",
      "default": "./dist/models/roles/*.js"
    },
    "./models/actions/*": {
      "types": "./src/models/actions/*.ts",
      "default": "./dist/models/actions/*.js"
    },
    "./engine/*": {
      "types": "./src/engine/*.ts",
      "default": "./dist/engine/*.js"
    },
    "./engine/store": {
      "types": "./src/engine/store/index.ts",
      "default": "./dist/engine/store/index.js"
    },
    "./engine/store/*": {
      "types": "./src/engine/store/*.ts",
      "default": "./dist/engine/store/*.js"
    },
    "./games/werewolf/commands": {
      "types": "./src/games/werewolf/commands/types.ts",
      "default": "./dist/games/werewolf/commands/types.js"
    },
    "./games/catalog": {
      "types": "./src/games/catalog.ts",
      "default": "./dist/games/catalog.js"
    },
    "./games/werewolf/public": {
      "types": "./src/games/werewolf/public.ts",
      "default": "./dist/games/werewolf/public.js"
    },
    "./games/fibking/public": {
      "types": "./src/games/fibking/public.ts",
      "default": "./dist/games/fibking/public.js"
    },
    "./games/werewolf/domain/handlers/commandHandlers": {
      "types": "./src/games/werewolf/domain/handlers/commandHandlers.ts",
      "default": "./dist/games/werewolf/domain/handlers/commandHandlers.js"
    },
    "./engine/state/*": {
      "types": "./src/engine/state/*.ts",
      "default": "./dist/engine/state/*.js"
    },
    "./engine/reducer/*": {
      "types": "./src/engine/reducer/*.ts",
      "default": "./dist/engine/reducer/*.js"
    },
    "./protocol/*": {
      "types": "./src/protocol/*.ts",
      "default": "./dist/protocol/*.js"
    },
    "./platform/protocol/*": {
      "types": "./src/platform/protocol/*.ts",
      "default": "./dist/platform/protocol/*.js"
    },
    "./platform/engine": {
      "types": "./src/platform/engine/index.ts",
      "default": "./dist/platform/engine/index.js"
    },
    "./platform/room/seating": {
      "types": "./src/platform/room/seating/index.ts",
      "default": "./dist/platform/room/seating/index.js"
    },
    "./platform/room/roster": {
      "types": "./src/platform/room/roster.ts",
      "default": "./dist/platform/room/roster.js"
    },
    "./resolvers/*": {
      "types": "./src/resolvers/*.ts",
      "default": "./dist/resolvers/*.js"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "default": "./dist/utils/*.js"
    },
    "./growth": {
      "types": "./src/growth/index.ts",
      "default": "./dist/growth/index.js"
    },
    "./growth/*": {
      "types": "./src/growth/*.ts",
      "default": "./dist/growth/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --no-coverage --forceExit"
  },
  "devDependencies": {}
}
