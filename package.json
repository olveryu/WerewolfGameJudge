{
  "name": "werewolfgamejudge",
  "version": "2.9.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:all": "pnpm -r --include-workspace-root run test",
    "e2e": "playwright test --reporter=list",
    "e2e:core": "pnpm exec playwright test --workers=1 --reporter=line --trace=on --max-failures=1",
    "types:pages": "wrangler types functions/types.d.ts --config wrangler.jsonc --env-file env/pages-types.env --env-interface PagesBindings --strict-vars=false",
    "types:pages:check": "wrangler types functions/types.d.ts --config wrangler.jsonc --env-file env/pages-types.env --env-interface PagesBindings --strict-vars=false --check",
    "typecheck": "pnpm run types:pages:check && tsc --noEmit && tsc -p functions/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "knip": "knip",
    "fix": "pnpm run lint:fix && pnpm run format:write",
    "quality": "turbo run build typecheck lint knip format test && pnpm run validate:agents",
    "e2e:night": "playwright test --reporter=list werewolf-night-flow restart",
    "e2e:ui": "playwright test --ui",
    "dev": "concurrently -n worker,web -c blue,green \"pnpm --filter @game-judge/api-worker run dev\" \"VITE_CF_API_URL=http://localhost:8787 pnpm --filter @game-judge/web run dev\"",
    "release": "bash scripts/release.sh",
    "new-game": "node scripts/new-game.mjs",
    "validate:agents": "node scripts/validate-agent-files.mjs",
    "badges:generate": "node scripts/generate-badges.mjs",
    "badges:validate": "node scripts/generate-badges.mjs --validate-only",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.4",
    "@game-judge/game-engine": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@sentry/cli": "^3.8.2",
    "@types/node": "^25.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "glob": "^13.0.6",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^16.4.0",
    "miniprogram-ci": "^2.1.31",
    "prettier": "^3.8.3",
    "serve": "^14.2.7",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-icons": "^24.0.0",
    "vitest": "~4.1.10",
    "wrangler": "^4.160.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
