/** 为共享资料卡控件返回公开的席位身份。 */
function get__GAME_PASCAL__ProfileTarget(
  state: __GAME_PASCAL__State,
  seat: number,
): RoomProfileTarget | null {
  return getRoomProfileTarget(
    state.roster,
    seat,
    (botSeat) => `__GAME_ID__-bot:${state.roomCode}:${botSeat}`,
    getBotDisplayName,
  );
}

export interface __GAME_PASCAL__SeatSourceInput {
  readonly state: __GAME_PASCAL__State;
  readonly revision: number;
  readonly userId: string;
  readonly controlledSeat: number | null;
}

interface __GAME_PASCAL__SeatTapInput {
  readonly state: __GAME_PASCAL__State;
  readonly seat: number;
  readonly currentSeat: number | null;
  readonly disabledReason?: string;
}

/** Project __GAME_PASCAL__ seating into the shared room seat-tap contract. */
export function get__GAME_PASCAL__SeatTapIntent(input: __GAME_PASCAL__SeatTapInput) {
  return getRoomSeatTapIntent({
    seat: input.seat,
    currentSeat: input.currentSeat,
    target: get__GAME_PASCAL__ProfileTarget(input.state, input.seat),
    disabledReason: input.disabledReason,
  });
}

function create__GAME_PASCAL__SeatDataSource(
  input: __GAME_PASCAL__SeatSourceInput,
): RoomSeatDataSource {
  const { state, revision, userId, controlledSeat } = input;
  return {
    count: state.config.numberOfPlayers,
    revision: `${revision}:${controlledSeat ?? 'self'}`,
    getSeat(seat): RoomSeatViewModel {
      if (!Number.isSafeInteger(seat) || seat < 0 || seat >= state.config.numberOfPlayers)
        throw new Error('__GAME_PASCAL__ seat out of range');
      const occupant = state.roster[seat];
      const human = occupant != null && !isBotOccupant(occupant) ? occupant : undefined;
      const target = get__GAME_PASCAL__ProfileTarget(state, seat);
      const player =
        human !== undefined
          ? toRoomSeatPlayer({ kind: 'human', userId: human.userId, ...human.profile })
          : target === null
            ? null
            : toRoomSeatPlayer({
                kind: 'bot',
                userId: target.userId,
                displayName: target.rosterName,
              });
      return {
        seat,
        player,
        isSelf: human?.userId === userId,
        highlight: controlledSeat === seat ? 'controlled' : 'none',
        secondaryLabel: null,
        showReadyBadge: false,
        // TODO(gameplay): 逐座阶段徽标（当前行动者、已提交等）在这里投影，
        // 只许走 statusBadge / secondaryLabel 出口，不许在座位表下方加阶段层。
        statusBadge: null,
        isStatusEmphasized: false,
        showLevel: state.phase.kind === 'lobby',
        decorationsEnabled: state.phase.kind === 'lobby',
        disabledReason:
          player === null && state.phase.kind !== 'lobby' ? '游戏进行中不能入座' : undefined,
      };
    },
  };
}

/** 公共状态条：舞台阶段的公开进度归这里（倒计时数字由工作区呈现）。 */
function create__GAME_PASCAL__StatusRibbon(
  state: __GAME_PASCAL__State,
): RoomStatusRibbonModel | null {
  const phase = state.phase;
  if (phase.kind === 'stage')
    // TODO(gameplay): 状态条文案随玩法阶段补齐（本游戏自有声音）。
    return { kind: 'message', icon: 'guide', text: '舞台进行中', supportingText: null };
  if (phase.kind === 'ended')
    return { kind: 'message', icon: 'guide', text: '本局已结束', supportingText: null };
  return {
    kind: 'message',
    icon: 'guide',
    text: `等待入座 · ${get__GAME_PASCAL__OccupiedSeatCount(state)}/${state.config.numberOfPlayers}`,
    supportingText: null,
  };
}

export interface __GAME_PASCAL__RoomShellModelInput {
  readonly roomCode: string;
  readonly capabilities: RoomCapabilities;
  readonly onBack: () => void;
  readonly onTitlePress: () => void;
  readonly onTitleLongPress: () => void;
