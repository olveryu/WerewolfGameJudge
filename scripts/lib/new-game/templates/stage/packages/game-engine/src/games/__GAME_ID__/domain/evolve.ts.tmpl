/** Applies __GAME_PASCAL__ domain events; reset paths clear all game-owned state. */

import { applyRosterChanges } from '../../../platform/room/seating';
import type { __GAME_PASCAL__State } from '../state/types';
import type { __GAME_PASCAL__Event } from './decision';

/** Resets mutable game data while preserving room configuration and seats. */
function reset__GAME_PASCAL__Game(state: __GAME_PASCAL__State): __GAME_PASCAL__State {
  return {
    ...state,
    phase: { kind: 'lobby' },
    phaseRevision: state.phaseRevision + 1,
    xpSettled: false,
  };
}

/** Evolves a committed domain event without persistence or broadcasts. */
export function evolve__GAME_PASCAL__State(
  state: __GAME_PASCAL__State,
  event: __GAME_PASCAL__Event,
): __GAME_PASCAL__State {
  const bumped = { ...state, phaseRevision: state.phaseRevision + 1 };
  switch (event.type) {
    case '__GAME_ID__.seats.changed':
      return { ...bumped, roster: applyRosterChanges(state.roster, event.changes) };
    case '__GAME_ID__.config.updated':
      return { ...bumped, config: event.config };
    case '__GAME_ID__.game.started':
      return {
        ...reset__GAME_PASCAL__Game(state),
        phaseRevision: state.phaseRevision + 1,
        phase: { kind: 'stage', deadlineAt: event.deadlineAt },
        gameSequence: event.gameSequence,
      };
    case '__GAME_ID__.phase.expired': {
      if (state.phase.kind !== 'stage') return state;
      // TODO(gameplay): 骨架只有一个舞台阶段，到期结算即终局；真实阶段链
      // 落地时改为推进到下一阶段（只有最后一个阶段的结算才发 game.ended）。
      return { ...bumped, phase: { kind: 'ended' }, xpSettled: true };
    }
    // TODO(gameplay): 玩法事件在这里逐个落状态；阶段推进只许由事件驱动。
    case '__GAME_ID__.game.ended': {
      if (state.phase.kind === 'ended') return state;
      return { ...bumped, phase: { kind: 'ended' }, xpSettled: true };
    }
    case '__GAME_ID__.game.returnedToLobby':
      return reset__GAME_PASCAL__Game(state);
  }
}
