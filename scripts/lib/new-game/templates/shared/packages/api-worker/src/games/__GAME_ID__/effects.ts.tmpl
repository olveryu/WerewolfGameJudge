/** Worker-side execution for __GAME_PASCAL__ effects: game-completed growth settlement. */

import {
//#cap stageDeadline
  __GAME_UPPER___REASONS,
//#end
  type __GAME_PASCAL__Effect,
  type __GAME_PASCAL__InternalCommand,
  type __GAME_PASCAL__State,
} from '@game-judge/game-engine/games/__GAME_ID__/public';
import { z } from 'zod';

import {
  gameCompletionPayloadSchema,
  publishGameRewards,
} from '../../features/account/settleGameRewards';
//#cap stageDeadline
import { createSettleDueHandler } from '../../platform/gameModules/settleDue';
//#end
import type { WorkerEffectContext } from '../../platform/gameModules/workerModule';

const gameCompletedEffectSchema = z.strictObject({
  type: z.literal('__GAME_ID__.game.completed'),
  payload: gameCompletionPayloadSchema,
});

//#cap stageDeadline
const settleDueEffectSchema = z.strictObject({
  type: z.literal('__GAME_ID__.settle.due'),
  payload: z.strictObject({
    gameSequence: z.int().nonnegative(),
    deadlineAt: z.int().nonnegative(),
  }),
});

//#end
export const __GAME_CAMEL__EffectSchema: z.ZodType<__GAME_PASCAL__Effect> = z.union([
  gameCompletedEffectSchema,
//#cap stageDeadline
  settleDueEffectSchema,
//#end
]);

//#cap stageDeadline
type __GAME_PASCAL__SettleDueEffect = Extract<
  __GAME_PASCAL__Effect,
  { type: '__GAME_ID__.settle.due' }
>;

/**
 * A settle command rejected on the phase or deadline guard means the
 * arming it targeted is already gone (a client expire or the host
 * settled first, or the phase moved on): the delivery is done, not
 * failed.
 */
const SUPERSEDED_SETTLE_REASONS: readonly string[] = [
  __GAME_UPPER___REASONS.phase,
  __GAME_UPPER___REASONS.deadline,
];

/**
 * Scheduled stage-deadline settlement through the shared settle.due
 * handler. The staleness gate compares the payload's pinned arming
 * field by field (game sequence, deadline): if the room has moved on
 * (already settled, new game), the delivery is a no-op — never settle
 * whatever stage happens to be current.
 */
const handle__GAME_PASCAL__SettleDueEffect = createSettleDueHandler<
  __GAME_PASCAL__State,
  __GAME_PASCAL__SettleDueEffect['payload'],
  __GAME_PASCAL__InternalCommand
>({
  namespace: '__GAME_ID__:settle',
  label: '__GAME_PASCAL__ settle',
  command: { type: '__GAME_ID__.phase.settleExpired' },
  supersededReasons: SUPERSEDED_SETTLE_REASONS,
  isCurrent: (state, payload) => {
    const phase = state.phase;
    return (
      state.gameSequence === payload.gameSequence &&
      phase.kind === 'playing' &&
      phase.deadlineAt === payload.deadlineAt
    );
  },
});

//#end
/**
 * Deliver one validated __GAME_PASCAL__ effect. Exactly-once for the
 * completion effect is enforced in three layers: the engine emits it
 * at most once per game (xpSettled), the effect outbox dedupes on the
 * business key, and settleGameRewards is idempotent on the settlement
 * id.
 */
export async function handle__GAME_PASCAL__Effect(
  effect: __GAME_PASCAL__Effect,
  context: WorkerEffectContext<__GAME_PASCAL__State, __GAME_PASCAL__InternalCommand>,
): Promise<void> {
  switch (effect.type) {
    case '__GAME_ID__.game.completed':
      await publishGameRewards(
        { ...effect.payload, kind: 'completion', gameType: '__GAME_ID__' },
        context,
      );
      return;
//#cap stageDeadline
    case '__GAME_ID__.settle.due':
      await handle__GAME_PASCAL__SettleDueEffect(effect, context);
      return;
//#end
  }
}
