/** Strict external schemas for the __GAME_PASCAL__ Worker module boundary. */

import {
  __GAME_UPPER___CONFIG_SCHEMA,
  type __GAME_PASCAL__Config,
  type __GAME_PASCAL__InternalCommand,
  type __GAME_PASCAL__PublicCommand,
} from '@game-judge/game-engine/games/__GAME_ID__/public';
import { z } from 'zod';

import { definePublicCommandOptions } from '../../platform/room/commandOptions';
import { ROOM_PUBLIC_COMMAND_SCHEMAS } from '../../platform/room/commandSchemas';
import { configSchemaToZod } from '../../platform/room/configSchemaZod';

const __GAME_CAMEL__ConfigSchema: z.ZodType<__GAME_PASCAL__Config> =
  configSchemaToZod(__GAME_UPPER___CONFIG_SCHEMA);

export const __GAME_CAMEL__CreateConfigSchema: z.ZodType<__GAME_PASCAL__Config> =
  __GAME_CAMEL__ConfigSchema;

const __GAME_CAMEL__PublicCommandOptions = definePublicCommandOptions<__GAME_PASCAL__PublicCommand>()([
  ...ROOM_PUBLIC_COMMAND_SCHEMAS,
  z.strictObject({
    type: z.literal('__GAME_ID__.config.update'),
    config: __GAME_CAMEL__ConfigSchema,
  }),
//#cap identityViewing
  z.strictObject({ type: z.literal('__GAME_ID__.roles.assign') }),
//#end
  z.strictObject({ type: z.literal('__GAME_ID__.game.begin') }),
//#cap identityViewing
  z.strictObject({ type: z.literal('__GAME_ID__.role.viewed') }),
//#end
//#cap botTestScaffold
  z.strictObject({ type: z.literal('__GAME_ID__.bots.markAllBotsViewed') }),
//#end
//#cap publicExpire
  z.strictObject({ type: z.literal('__GAME_ID__.phase.expire') }),
//#end
  z.strictObject({ type: z.literal('__GAME_ID__.game.returnToLobby') }),
//#cap audioOrchestration
  z.strictObject({
    type: z.literal('__GAME_ID__.audio.ack'),
    audioBatchId: z.number().int().nonnegative(),
  }),
//#end
  z.strictObject({ type: z.literal('__GAME_ID__.gameplay.example') }),
]);

export const __GAME_CAMEL__PublicCommandSchema: z.ZodType<__GAME_PASCAL__PublicCommand> =
  z.discriminatedUnion('type', __GAME_CAMEL__PublicCommandOptions);

//#cap !stageDeadline
/** The skeleton has no worker-originated commands yet (see the engine commands/types.ts). */
export const __GAME_CAMEL__InternalCommandSchema: z.ZodType<__GAME_PASCAL__InternalCommand> =
  z.never();
//#end
//#cap stageDeadline
/**
 * Worker-originated commands: dispatched only by the settle effect
 * handler as the system actor when a scheduled deadline effect is due.
 */
export const __GAME_CAMEL__InternalCommandSchema: z.ZodType<__GAME_PASCAL__InternalCommand> =
  z.discriminatedUnion('type', [
    z.strictObject({ type: z.literal('__GAME_ID__.phase.settleExpired') }),
  ]);
//#end
