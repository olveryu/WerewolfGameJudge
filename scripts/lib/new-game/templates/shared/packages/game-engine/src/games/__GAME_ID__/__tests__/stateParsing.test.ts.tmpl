/** State parsing round-trips the current shape and rejects foreign game identity. */

import { __GAME_CAMEL__Engine } from '../engine';
import { parse__GAME_PASCAL__State } from '../state/parseState';
import { DEFAULT___GAME_UPPER___CONFIG } from '../state/types';

describe('__GAME_PASCAL__ state parser', () => {
  it('accepts a lobby state unchanged', () => {
    const state = __GAME_CAMEL__Engine.createInitialState(
      { ...DEFAULT___GAME_UPPER___CONFIG },
      { roomCode: '1234', hostUserId: 'host', nowMs: 0, commandId: 'create' },
    );
    const persisted = JSON.parse(JSON.stringify(state)) as unknown;
    expect(parse__GAME_PASCAL__State(persisted)).toEqual(state);
  });

  it('rejects a state carrying another game identity', () => {
    const state = __GAME_CAMEL__Engine.createInitialState(
      { ...DEFAULT___GAME_UPPER___CONFIG },
      { roomCode: '1234', hostUserId: 'host', nowMs: 0, commandId: 'create' },
    );
    const foreign = { ...(JSON.parse(JSON.stringify(state)) as object), gameType: 'werewolf' };
    expect(() => parse__GAME_PASCAL__State(foreign)).toThrow();
  });
//#cap identityViewing
  it('rejects missing or non-terminal review completion records', () => {
    const state = __GAME_CAMEL__Engine.createInitialState(
      { ...DEFAULT___GAME_UPPER___CONFIG },
      { roomCode: '1234', hostUserId: 'host', nowMs: 0, commandId: 'create' },
    );
    expect(() => parse__GAME_PASCAL__State({ ...state, reviewCompletedUserIds: undefined })).toThrow();
    expect(() => parse__GAME_PASCAL__State({ ...state, reviewCompletedUserIds: ['host'] })).toThrow();
  });
//#end
//#cap stageDeadline
  it('rejects a playing state with a missing deadline', () => {
    const state = __GAME_CAMEL__Engine.createInitialState(
      { ...DEFAULT___GAME_UPPER___CONFIG },
      { roomCode: '1234', hostUserId: 'host', nowMs: 0, commandId: 'create' },
    );
    expect(() => parse__GAME_PASCAL__State({ ...state, phase: { kind: 'playing' } })).toThrow(
      /deadlineAt/,
    );
  });
//#end
});
