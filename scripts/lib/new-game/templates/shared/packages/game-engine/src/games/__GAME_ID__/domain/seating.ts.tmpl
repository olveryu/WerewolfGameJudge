/** Lobby-only __GAME_PASCAL__ seating over the shared room-command skeleton. */

import { type CommandContext, reject } from '../../../platform/engine';
import { decideRoomCommands } from '../../../platform/room/roomCommands';
import type { __GAME_PASCAL__Command } from '../commands/types';
import { type __GAME_PASCAL__State, isValid__GAME_PASCAL__Config } from '../state/types';
import { commit__GAME_PASCAL__, __GAME_UPPER___REASONS, type __GAME_PASCAL__Decision } from './decision';

type RoomCommand = Extract<__GAME_PASCAL__Command, { readonly type: `room.${string}` | '__GAME_ID__.config.update' }>;

/** Decides lobby and profile changes with authenticated ownership. */
export function decide__GAME_PASCAL__Room(
  state: __GAME_PASCAL__State,
  command: RoomCommand,
  context: CommandContext,
): __GAME_PASCAL__Decision {
  return decideRoomCommands({
    facts: {
      roster: state.roster,
      seatCount: state.config.numberOfPlayers,
      hostUserId: state.hostUserId,
    },
    command,
    context,
    options: {
      lobbyRejection: state.phase.kind !== 'lobby' ? reject(__GAME_UPPER___REASONS.phase) : null,
      phaseReason: __GAME_UPPER___REASONS.phase,
      configReason: __GAME_UPPER___REASONS.config,
      occupiedReason: __GAME_UPPER___REASONS.occupied,
      profileLanding: { kind: 'rosterChange' },
      resolveConfigFacts: (resolved) =>
        resolved.type === '__GAME_ID__.config.update'
          ? {
              invalidReason: isValid__GAME_PASCAL__Config(resolved.config) ? null : __GAME_UPPER___REASONS.config,
              newSeatCount: resolved.config.numberOfPlayers,
              buildEvent: () => ({ type: '__GAME_ID__.config.updated', config: { ...resolved.config } }),
            }
          : null,
      buildSeatsChangedEvent: (changes) => ({ type: '__GAME_ID__.seats.changed', changes }),
      commit: commit__GAME_PASCAL__,
    },
  });
}
