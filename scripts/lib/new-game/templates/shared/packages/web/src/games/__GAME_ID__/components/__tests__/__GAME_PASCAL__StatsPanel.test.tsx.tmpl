import { render, screen } from '@testing-library/react';
import { it, expect, vi } from 'vitest';

import { __GAME_PASCAL__StatsPanel } from '../__GAME_PASCAL__StatsPanel';

const query = vi.hoisted(() => {
  const state: {
    data: { gameType: '__GAME_ID__'; gamesPlayed: number } | undefined;
    isPending: boolean;
    isError: boolean;
  } = { data: undefined, isPending: false, isError: false };
  return state;
});
vi.mock('@tanstack/react-query', async (importOriginal) => ({
  ...await importOriginal<typeof import('@tanstack/react-query')>(),
  useQuery: () => query,
}));

it('reports loading/error/empty counts and avoids duplicate profile game counts', () => {
  const onGamesPlayedChange = vi.fn();
  query.isPending = true;
  const view = render(<__GAME_PASCAL__StatsPanel userId="user" onGamesPlayedChange={onGamesPlayedChange} />);
  expect(onGamesPlayedChange).toHaveBeenLastCalledWith(null);
  query.isPending = false;
  query.isError = true;
  view.rerender(<__GAME_PASCAL__StatsPanel userId="user" onGamesPlayedChange={onGamesPlayedChange} />);
  expect(screen.getByRole('alert')).toHaveTextContent('__GAME_DISPLAY_NAME__战绩加载失败');
  expect(onGamesPlayedChange).toHaveBeenLastCalledWith(null);
  query.isError = false;
  query.data = { gameType: '__GAME_ID__', gamesPlayed: 0 };
  view.rerender(<__GAME_PASCAL__StatsPanel userId="user" onGamesPlayedChange={onGamesPlayedChange} />);
  expect(screen.getByText('暂无__GAME_DISPLAY_NAME__战绩')).toBeInTheDocument();
  expect(onGamesPlayedChange).toHaveBeenLastCalledWith(0);
  query.data = { gameType: '__GAME_ID__', gamesPlayed: 2 };
  view.rerender(<__GAME_PASCAL__StatsPanel userId="user" onGamesPlayedChange={onGamesPlayedChange} />);
  expect(screen.queryByText('2局')).not.toBeInTheDocument();
  expect(onGamesPlayedChange).toHaveBeenLastCalledWith(2);
  view.rerender(<__GAME_PASCAL__StatsPanel userId="user" />);
  expect(screen.getByText('2局')).toBeInTheDocument();
});
