/**
 * __GAME_DISPLAY_NAME__路由解析；导航宿主收到校验过的游戏参数。
 */

import { defineGameNavigation } from '@/features/navigation/model/GameNavigationContribution';
import {
  createStandardConfigRouteParser,
  createStandardGuideRouteParser,
  type StandardConfigRouteParams,
} from '@/features/navigation/model/standardRouteParsers';

export type __GAME_PASCAL__ConfigRouteParams = StandardConfigRouteParams<'__GAME_ID__'>;

/** 只解析创建或活跃房间的设置编辑路由。 */
export const parse__GAME_PASCAL__ConfigRouteParams = createStandardConfigRouteParser({
  gameType: '__GAME_ID__',
  displayName: '__GAME_PASCAL__',
});

const parseGuide = createStandardGuideRouteParser({
  gameType: '__GAME_ID__',
  displayName: '__GAME_PASCAL__',
});

export const __GAME_CAMEL__GameNavigation = defineGameNavigation({
  gameType: '__GAME_ID__',
  config: { kind: 'screen', parseParams: parse__GAME_PASCAL__ConfigRouteParams },
  guide: { kind: 'screen', parseParams: parseGuide },
  notepad: { kind: 'unsupported' },
});
