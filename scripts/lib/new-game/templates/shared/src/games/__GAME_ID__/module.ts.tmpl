/**
 * 注册完整的__GAME_DISPLAY_NAME__客户端：使用共享房间基础设施。
 */

import {
  get__GAME_PASCAL__UserSeat,
  __GAME_UPPER___CONFIG_SCHEMA,
  __GAME_UPPER___STATE_CODEC,
  type __GAME_PASCAL__Command,
  type __GAME_PASCAL__State,
} from '@game-judge/game-engine/games/__GAME_ID__/public';

import { defineClientGameModule } from '@/games/model/defineClientGameModule';

import { __GAME_CAMEL__HomeContribution } from './home';
import {
  __GAME_CAMEL__GameNavigation,
  parse__GAME_PASCAL__ConfigRouteParams,
} from './navigation/__GAME_CAMEL__GameNavigation';
import { __GAME_PASCAL__RoomScreen } from './room/__GAME_PASCAL__RoomScreen';
import { get__GAME_PASCAL__RoomCommandFailureMessage } from './room/__GAME_CAMEL__RoomCommandFailureMessage';
import { __GAME_PASCAL__RulesScreen } from './screens/__GAME_PASCAL__RulesScreen';

// TODO(gameplay): 玩法配置项（时长、模式等）按设计文档加进引擎 __GAME_UPPER___CONFIG_SCHEMA。

export const create__GAME_PASCAL__UiModule = defineClientGameModule<
  '__GAME_ID__',
  __GAME_PASCAL__State,
  __GAME_PASCAL__Command
>({
  gameType: '__GAME_ID__',
  stateCodec: __GAME_UPPER___STATE_CODEC,
  home: __GAME_CAMEL__HomeContribution,
  navigation: __GAME_CAMEL__GameNavigation,
  RoomScreen: __GAME_PASCAL__RoomScreen,
  config: (define) =>
    define({
      schema: __GAME_UPPER___CONFIG_SCHEMA,
      parseRouteParams: parse__GAME_PASCAL__ConfigRouteParams,
      readConfig: (state) => (state.phase.kind === 'lobby' ? state.config : null),
      buildUpdateCommand: (config) => ({ type: '__GAME_ID__.config.update', config }),
      getFailureMessage: get__GAME_PASCAL__RoomCommandFailureMessage,
      creationLabel: '创建__GAME_DISPLAY_NAME__房间',
    }),
  GuideScreen: __GAME_PASCAL__RulesScreen,
  isUserSeated: (state, userId) => get__GAME_PASCAL__UserSeat(state, userId) !== null,
  canSwitchAccount: (state) => state.phase.kind === 'lobby',
});
