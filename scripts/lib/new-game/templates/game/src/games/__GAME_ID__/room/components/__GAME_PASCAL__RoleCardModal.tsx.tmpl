/**
 * __GAME_DISPLAY_NAME__身份卡弹窗：走共享 RevealAnimationGate（身份查看协议）。
 *
 * 锚点是服务端 roleViewedSeats：本人尚未查看时首次打开才播装备动画，
 * 查看落记录后（含回看）恒静态。
 */
import { RevealAnimationGate } from '@/features/room/components/RevealAnimationGate';
import { RoleCardSimple } from '@/features/room/components/RoleCardSimple';
import type { RevealEffectType } from '@/features/room/components/RoleRevealEffects/types';
import type { RevealRoleData } from '@/features/room/model/RevealRoleData';

import { toRevealRoleData } from '../../components/__GAME_PASCAL__RoleCardAdapter';

export function __GAME_PASCAL__RoleCardModal({
  visible,
  identity,
  effectType,
  shouldPlay,
  allRoles,
  remainingCards,
  onClose,
}: {
  readonly visible: boolean;
  readonly identity: string | null;
  /** 卡片主人的装备揭示动画；预览或接管机器人时为 null。 */
  readonly effectType?: RevealEffectType | null;
  /** 服务端锚点：该座位尚未查看身份时为 true（首次查看才播动画）。 */
  readonly shouldPlay: boolean;
  /** 动画候选池：本局完整身份分布。 */
  readonly allRoles: readonly RevealRoleData[];
  /** 桌上未看牌数（已占座位数 − 已查看数）。 */
  readonly remainingCards: number;
  readonly onClose: () => void;
}) {
  const role = identity != null ? toRevealRoleData(identity) : null;

  if (role == null) {
    return <RoleCardSimple visible={visible} role={role} onClose={onClose} confirmText="知道了" />;
  }

  return (
    <RevealAnimationGate
      visible={visible}
      effectType={effectType ?? null}
      shouldPlay={shouldPlay}
      role={role}
      allRoles={allRoles}
      remainingCards={remainingCards}
    >
      <RoleCardSimple visible={visible} role={role} onClose={onClose} confirmText="知道了" />
    </RevealAnimationGate>
  );
}
