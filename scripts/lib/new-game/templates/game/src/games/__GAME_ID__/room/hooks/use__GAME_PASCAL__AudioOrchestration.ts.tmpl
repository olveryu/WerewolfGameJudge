/**
 * __GAME_DISPLAY_NAME__播报 — 共享房间音频运行核（RoomAudioOrchestrator）的 React 薄绑定。
 *
 * 生命周期（队列识别、顺序播放、durable ack、ack 后 recheck 链式续播）已搬入共享核心
 * （src/features/room/audio/RoomAudioOrchestrator），全平台只此一份。本 hook 只做适配：
 * - queue source：直接读 link 权威快照的 state.pendingAudioEffects。必须读快照而非 React
 *   prop：ack 提交后 link 先应用新快照再返回结果，核心的 ack 后 recheck 只有读快照才能同步
 *   看到已清的队列。link 非 ready 或播放器未就绪时快照为 null（核心静默）。
 * - player port：本游戏音频运行时（__GAME_PASCAL__AudioRuntime）的 playEffect；
 *   stopBgm 供核心在 night_end 播报前停 BGM（天亮时序，全游戏统一）；
 *   播放器与音频资源 registry 是本游戏资产，骨架只定 port 形状，运行时由
 *   use__GAME_PASCAL__RoomState 的调用点注入（骨架阶段传 null，绑定静默）。
 * - ack port：`__GAME_ID__.audio.ack` 以 durable 命令发送，由 RoomLink 跨连接重放直到服务端裁决。
 */

import type { AudioEffect, __GAME_PASCAL__State } from '@game-judge/game-engine/games/__GAME_ID__/public';
import { useEffect, useRef } from 'react';

import {
  RoomAudioOrchestrator,
  type RoomAudioQueueSnapshot,
  type RoomAudioQueueSource,
} from '@/features/room/audio/RoomAudioOrchestrator';
import { log } from '@/utils/logger';

import type { __GAME_PASCAL__RoomSession } from '../../model/__GAME_PASCAL__RoomSession';

const __GAME_CAMEL__AudioLog = log.extend('__GAME_PASCAL__Audio');

/**
 * 本游戏的音频运行时：把一条队列 effect 真正播出声的资产侧接口。
 * TODO(gameplay): 用本游戏播放器 + 资源 registry 实现本接口，并在
 * use__GAME_PASCAL__RoomState 的绑定调用点传入（缺资源必须 fail-fast，
 * 不许静默跳过——资源的缺失是编程错误，不是运行时状况）。
 */
export interface __GAME_PASCAL__AudioRuntime {
  /** 播放一条 effect，播完（或被平台播放器跳过）后 resolve。 */
  playEffect(effect: AudioEffect): Promise<void>;
  /** 停止正在播的播报（绑定卸载时调用）。 */
  stopNarration(): void;
  /** 停止房主 BGM（幂等）；共享核心在 NIGHT_END_AUDIO_KEY 播报前调用，天亮时序全游戏统一。 */
  stopBgm(): void;
}

interface Use__GAME_PASCAL__AudioOrchestrationDeps {
  readonly session: __GAME_PASCAL__RoomSession;
  readonly isHost: boolean;
  /** 本游戏音频运行时；null 表示资产未就绪，绑定保持静默。 */
  readonly audio: __GAME_PASCAL__AudioRuntime | null;
}

type __GAME_PASCAL__AudioCore = RoomAudioOrchestrator<AudioEffect, __GAME_PASCAL__State>;

export function use__GAME_PASCAL__AudioOrchestration(
  deps: Use__GAME_PASCAL__AudioOrchestrationDeps,
): void {
  const { session, isHost, audio } = deps;
  const sessionRef = useRef(session);
  const isHostRef = useRef(isHost);
  const audioRef = useRef(audio);
  const abortedRef = useRef(false);
  const coreRef = useRef<__GAME_PASCAL__AudioCore | null>(null);
  const listenersRef = useRef(
    new Set<(snapshot: RoomAudioQueueSnapshot<AudioEffect> | null) => void>(),
  );

  // Sync latest inputs and poke the core with the current snapshot on every
  // render: host/player changes arrive as props, queue/connection changes
  // arrive through the queue source's session forwarding below.
  useEffect(() => {
    sessionRef.current = session;
    isHostRef.current = isHost;
    audioRef.current = audio;

    const readSnapshot = (): RoomAudioQueueSnapshot<AudioEffect> | null => {
      const current = sessionRef.current.getSnapshot();
      if (current.phase !== 'ready' || audioRef.current === null) return null;
      return { pendingAudioEffects: current.room.state.pendingAudioEffects };
    };

    if (coreRef.current === null) {
      const queueSource: RoomAudioQueueSource<AudioEffect> = {
        getSnapshot: readSnapshot,
        subscribe: (listener) => {
          listenersRef.current.add(listener);
          const unsubscribeSession = sessionRef.current.subscribe(() => listener(readSnapshot()));
          return () => {
            listenersRef.current.delete(listener);
            unsubscribeSession();
          };
        },
      };
      coreRef.current = new RoomAudioOrchestrator<AudioEffect, __GAME_PASCAL__State>({
        queueSource,
        player: {
          playEffect: (effect) => {
            const player = audioRef.current;
            if (player === null) {
              throw new Error(
                '[FAIL-FAST] __GAME_PASCAL__ audio playback requires a ready audio runtime',
              );
            }
            return player.playEffect(effect);
          },
          stopBgm: () => {
            const player = audioRef.current;
            if (player === null) {
              throw new Error('[FAIL-FAST] __GAME_PASCAL__ BGM stop requires a ready audio runtime');
            }
            player.stopBgm();
          },
        },
        ack: {
          dispatch: () =>
            sessionRef.current.dispatch(
              { type: '__GAME_ID__.audio.ack' },
              { controlledSeat: null, label: '播报确认', durable: true },
            ),
        },
        isHost: () => isHostRef.current,
        isAborted: () => abortedRef.current,
        logger: __GAME_CAMEL__AudioLog,
        onError: (error, label) =>
          __GAME_CAMEL__AudioLog.warn('__GAME_ID__ audio orchestration failed', { label, error }),
      });
    }

    const snapshot = readSnapshot();
    for (const listener of listenersRef.current) listener(snapshot);
  });

  // Unmount: stop the lifecycle (timers, subscriptions, retained ack) and
  // stop any in-flight narration, mirroring the shipped bindings' cleanup.
  useEffect(
    () => () => {
      abortedRef.current = true;
      coreRef.current?.dispose();
      coreRef.current = null;
      audioRef.current?.stopNarration();
    },
    [],
  );
}
