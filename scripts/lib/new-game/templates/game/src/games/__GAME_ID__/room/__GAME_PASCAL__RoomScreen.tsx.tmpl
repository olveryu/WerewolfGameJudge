import { StyleSheet, Text, View } from 'react-native';

//#cap identityViewing
import { Button } from '@/components/Button';
import { RevealRoleCardModal } from '@/features/room/components/RevealRoleCardModal';
//#end
import { RoomEntryBoundary } from '@/features/room/components/RoomEntryBoundary';
import { RoomGameSummary, RoomGuideButton } from '@/features/room/components/RoomGameSummary';
import { RoomShell } from '@/features/room/components/RoomShell';
//#cap publicExpire
import { StageFrame } from '@/features/room/components/StageFrame';
//#end
import type { RoomEntryController } from '@/features/room/controllers/useRoomEntryController';
//#cap identityViewing
import { resolveViewIdentityAction } from '@/features/room/model/RoomBottomActions';
//#end
//#cap publicExpire
import { formatCountdownSeconds } from '@/features/room/model/formatCountdown';
//#end
import type { GameRoomScreenProps } from '@/features/room/model/RoomUiModule';
import { exitRoomFlow } from '@/features/room/navigation/roomFlowNavigation';
import type { __GAME_PASCAL__RoomSession } from '@/games/__GAME_ID__/model/__GAME_PASCAL__RoomSession';
//#cap identityViewing
import { borderRadius, colors, fixed, spacing, textStyles } from '@/theme';
//#end
//#cap !identityViewing
import { colors, spacing, textStyles } from '@/theme';
//#end

//#cap identityViewing
import { toRevealRoleData } from '../components/__GAME_PASCAL__RoleCardAdapter';
//#end
import {
  use__GAME_PASCAL__RoomState,
  type __GAME_PASCAL__RoomScreenState,
} from './hooks/use__GAME_PASCAL__RoomState';

type __GAME_PASCAL__RoomScreenProps = GameRoomScreenProps<'__GAME_ID__'> & {
  readonly session: __GAME_PASCAL__RoomSession;
};

/** 使用平台入场生命周期处理直链、加入与重连。 */
export function __GAME_PASCAL__RoomScreen(props: __GAME_PASCAL__RoomScreenProps) {
  return (
    <RoomEntryBoundary
      room={props.room}
      session={props.session}
      onExit={() => exitRoomFlow(props.navigation)}
    >
      {(entryController) => (
        <__GAME_PASCAL__RoomContent {...props} entryController={entryController} />
      )}
    </RoomEntryBoundary>
  );
}

function __GAME_PASCAL__RoomContent(
  props: __GAME_PASCAL__RoomScreenProps & { readonly entryController: RoomEntryController },
) {
  const screen = use__GAME_PASCAL__RoomState(props);
  const config = screen.state.config;
  const isLobby = screen.state.phase.kind === 'lobby';
  return (
    <RoomShell
      model={screen.shellModel}
      content={
        isLobby
          ? {
              kind: 'seats',
              contextHeader: null,
              afterSeatBoard: null,
              sideInspector: null,
              beforeSeatBoard: (
                <RoomGameSummary
                  icon="__GAME_ICON_NAME__"
                  title={`__GAME_DISPLAY_NAME__ · ${config.numberOfPlayers}人局`}
                  subtitle="__GAME_SUBTITLE__"
                  headerRight={
                    <RoomGuideButton onPress={screen.openRules} label="查看__GAME_DISPLAY_NAME__玩法" />
                  }
                />
              ),
            }
          : {
              kind: 'workspace',
              element: <__GAME_PASCAL__StageArea screen={screen} />,
            }
      }
      leadingExtraActions={null}
      trailingExtraActions={null}
//#cap identityViewing
      gameOverlays={
        <RevealRoleCardModal
          visible={screen.roleCardVisible}
          roleKey={screen.viewModel?.myIdentity ?? null}
          toRoleData={toRevealRoleData}
          effectType={null}
          shouldPlay={screen.roleCardShouldPlay}
          allRoles={screen.roleCardAllRoles}
          remainingCards={screen.roleCardRemainingCards}
          onClose={() => screen.setRoleCardVisible(false)}
        />
      }
//#end
//#cap !identityViewing
      gameOverlays={null}
//#end
    />
  );
}

//#cap identityViewing
/**
 * 对局工作区（座位表之外的阶段层）。TODO(gameplay): 玩法阶段 UI 在这里
 * 按落点总规则组装——公共步进进度归底部进度行、个人指令归底部消息、个人
 * 动作归底部按钮、逐座状态归座位徽标、一次性信息归弹窗；座位表下方
 * 不加阶段层（afterSeatBoard 恒为 null，CI 扫描钉死）。
 */
function __GAME_PASCAL__StageArea({
  screen,
}: {
  readonly screen: __GAME_PASCAL__RoomScreenState;
}) {
  const phase = screen.state.phase;
  // 查看动作定义走共享解析（身份模板同形态）：此处是 stage 区表面渲染。
  const viewIdentityAction = resolveViewIdentityAction({
    isVisible: phase.kind !== 'ended',
    label: '查看我的身份',
    onPress: screen.onViewRolePress,
  });
  return (
    <View style={styles.stageArea}>
      <Text style={styles.stageTitle}>
        {phase.kind === 'viewing'
          ? '身份查看'
          : phase.kind === 'ended'
            ? '本局已结束'
            : '对局进行中'}
      </Text>
      <Text style={styles.stageHint}>
        {phase.kind === 'viewing'
          ? '点下方按钮查看你的身份；全员查看完后由房主开始游戏。'
          : 'TODO(gameplay):玩法阶段界面随玩法状态机落地。'}
      </Text>
      {viewIdentityAction !== null ? (
        <Button variant="secondary" size="lg" onPress={viewIdentityAction.onPress}>
          {viewIdentityAction.label}
        </Button>
      ) : null}
    </View>
  );
}
//#end
//#cap !identityViewing
/**
 * 舞台工作区（座位表之外的阶段层）：阶段内容一律走共享 StageFrame
 * （限宽居中、标题头钉顶不滚、内容区滚动），标题与倒计时经 header
 * 插槽注入、呈现各家自理。TODO(gameplay): 玩法阶段 UI 在这里按落点
 * 总规则组装——公共步进进度归底部进度行、个人指令归底部消息、个人动作
 * 归底部按钮、逐座状态归座位徽标、一次性信息归弹窗；座位表下方不加
 * 阶段层（afterSeatBoard 恒为 null，CI 扫描钉死）。
 */
function __GAME_PASCAL__StageArea({
  screen,
}: {
  readonly screen: __GAME_PASCAL__RoomScreenState;
}) {
  const phase = screen.state.phase;
  return (
    <StageFrame
      header={
        <View style={styles.stageHeader}>
          <Text style={styles.stageTitle}>
            {phase.kind === 'ended' ? '本局已结束' : '舞台进行中'}
          </Text>
          {screen.remainingSeconds !== null ? (
            <Text style={styles.stageCountdown} accessibilityLabel="本阶段剩余时间">
              {formatCountdownSeconds(screen.remainingSeconds)}
            </Text>
          ) : null}
        </View>
      }
    >
      <Text style={styles.stageHint}>TODO(gameplay):玩法阶段界面随玩法状态机落地。</Text>
    </StageFrame>
  );
}
//#end

const styles = StyleSheet.create({
//#cap identityViewing
  stageArea: {
    width: '100%',
    alignItems: 'center',
    gap: spacing.small,
    padding: spacing.medium,
    backgroundColor: colors.surface,
    borderRadius: borderRadius.medium,
    borderWidth: fixed.borderWidth,
    borderColor: colors.border,
  },
//#end
//#cap publicExpire
  stageHeader: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
    gap: spacing.small,
  },
//#end
  stageTitle: {
    ...textStyles.subtitleSemibold,
    color: colors.text,
  },
//#cap publicExpire
  stageCountdown: {
    ...textStyles.titleBold,
    color: colors.text,
    fontVariant: ['tabular-nums'],
  },
//#end
  stageHint: {
    ...textStyles.secondary,
    color: colors.textSecondary,
    textAlign: 'center',
  },
});
