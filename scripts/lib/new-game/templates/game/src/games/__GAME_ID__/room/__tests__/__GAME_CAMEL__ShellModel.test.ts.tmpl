import {
  DEFAULT___GAME_UPPER___CONFIG,
  type __GAME_PASCAL__Command,
  __GAME_CAMEL__Engine,
  type __GAME_PASCAL__State,
} from '@game-judge/game-engine/games/__GAME_ID__/public';

import type { RoomSeatController } from '@/features/room/controllers/useRoomSeatController';
//#cap identityViewing
import { resolveHostConsolePrimary } from '@/features/room/model/resolveHostConsolePrimary';
//#end
import {
  createBotTakeoverCapability,
  createRoomSetupCapabilities,
  type RoomCapabilities,
} from '@/features/room/model/RoomCapabilities';

import {
  create__GAME_PASCAL__HostManagement,
  create__GAME_PASCAL__RoomShellModel,
} from '../__GAME_CAMEL__RoomAdapter';

type CommandContext = Parameters<typeof __GAME_CAMEL__Engine.decide>[2];

function drive(state: __GAME_PASCAL__State, command: __GAME_PASCAL__Command, userId = 'host') {
  const context: CommandContext = {
    actor: { kind: 'user', userId },
    controlledSeat: null,
    nowMs: 1000,
    commandId: command.type,
    randomSeed: 'seed',
  };
  const decision = __GAME_CAMEL__Engine.decide(state, command, context);
  if (decision.kind === 'reject') throw new Error(`rejected: ${decision.reason}`);
  return decision.events.reduce(__GAME_CAMEL__Engine.evolve, state);
}

function lobbyState(withBots: boolean): __GAME_PASCAL__State {
  let state = __GAME_CAMEL__Engine.createInitialState(
    { ...DEFAULT___GAME_UPPER___CONFIG, numberOfPlayers: 4 },
    { roomCode: '1234', hostUserId: 'host', nowMs: 1000, commandId: 'create' },
  );
  state = drive(state, { type: 'room.seat.take', seat: 0, profile: { displayName: '房主' } });
  if (withBots) state = drive(state, { type: 'room.seat.fillBots' });
  return state;
}
//#cap identityViewing

function viewingState(): __GAME_PASCAL__State {
  let state = lobbyState(true);
  state = drive(state, { type: '__GAME_ID__.roles.assign' });
  return state;
}
//#end

function capabilities(): RoomCapabilities {
  return {
    ...createRoomSetupCapabilities({
      isSetup: true,
      isHost: true,
      mySeat: 0,
      supportsBots: true,
      hasOccupiedSeats: true,
      isRoomFull: false,
      requestTakeSeat: jest.fn(),
      requestMoveSeat: jest.fn(),
      leaveSeat: jest.fn(),
      kickSeat: jest.fn(),
      clearSeats: jest.fn(),
      fillBots: jest.fn(),
      configureGame: jest.fn(),
      shareRoom: jest.fn(),
    }),
    canViewProfiles: { isAllowed: true, execute: jest.fn() },
    canTakeOverBots: createBotTakeoverCapability(true, jest.fn()),
  };
}

const seatController: RoomSeatController = {
  pendingAction: null,
  isSubmitting: false,
  requestTakeSeat: jest.fn(),
  requestMoveSeat: jest.fn(),
  confirm: jest.fn(async () => undefined),
  cancel: jest.fn(),
};

const share = {
  isVisible: false,
  roomCode: '1234',
  roomUrl: 'https://example.test/1234',
  open: jest.fn(),
  close: jest.fn(),
  copyLink: jest.fn(async () => undefined),
  shareImage: jest.fn(async () => undefined),
};

describe('create__GAME_PASCAL__RoomShellModel', () => {
  it('assembles the lobby shell from the hook projections', () => {
    const state = lobbyState(true);
    const caps = capabilities();
    const hostManagement = { sections: [] };
    const onSeatPress = jest.fn();
    const model = create__GAME_PASCAL__RoomShellModel({
      roomCode: '1234',
      capabilities: caps,
      onBack: jest.fn(),
      onTitlePress: jest.fn(),
      onTitleLongPress: jest.fn(),
      user: { id: 'host', avatarUrl: null },
      gachaStatus: null,
      onUserActionPress: jest.fn(),
      connection: { status: 'live', pendingCommandCount: 0, onManualReconnect: jest.fn() },
      state,
      revision: 5,
      userId: 'host',
      controlledSeat: null,
      seatsVisuallyDisabled: false,
      onSeatPress,
      onBotSeatLongPress: null,
      seatController,
      profileSelection: null,
      onProfileClose: jest.fn(),
      onProfileLeaveSeat: jest.fn(),
      share,
      isLobby: true,
      isHost: true,
      mySeat: 0,
      hostManagement,
      releaseBot: jest.fn(),
    });
    expect(model.roomCode).toBe('1234');
    // The shell phase anchor carries the __GAME_ID__ phase kind verbatim.
    expect(model.phase).toBe('lobby');
    expect(model.seats.source.count).toBe(4);
    expect(model.seats.onSeatPress).toBe(onSeatPress);
    expect(model.seatConfirmation).toBeNull();
    expect(model.profile).toBeNull();
    expect(model.share).toBe(share);
    expect(model.hostManagement).toBe(hostManagement);
    expect(model.controlledSeat).toBeNull();
  });
//#cap identityViewing

  it('exposes the viewing phase on the shell model', () => {
    const model = create__GAME_PASCAL__RoomShellModel({
      roomCode: '1234',
      capabilities: capabilities(),
      onBack: jest.fn(),
      onTitlePress: jest.fn(),
      onTitleLongPress: jest.fn(),
      user: { id: 'host', avatarUrl: null },
      gachaStatus: null,
      onUserActionPress: jest.fn(),
      connection: { status: 'live', pendingCommandCount: 0, onManualReconnect: jest.fn() },
      state: viewingState(),
      revision: 5,
      userId: 'host',
      controlledSeat: null,
      seatsVisuallyDisabled: false,
      onSeatPress: jest.fn(),
      onBotSeatLongPress: null,
      seatController,
      profileSelection: null,
      onProfileClose: jest.fn(),
      onProfileLeaveSeat: jest.fn(),
      share,
      isLobby: false,
      isHost: true,
      mySeat: 0,
      hostManagement: { sections: [] },
      releaseBot: jest.fn(),
    });
    expect(model.phase).toBe('viewing');
  });
//#end
//#cap internalSettleOnly

  it('shows the shared ended wait to a seated non-host player once ended', () => {
    let state = viewingState();
    state = drive(state, { type: '__GAME_ID__.role.viewed' });
    state = drive(state, { type: '__GAME_ID__.bots.markAllBotsViewed' });
    state = drive(state, { type: '__GAME_ID__.game.begin' });
    const playing = state.phase;
    if (playing.kind !== 'playing') throw new Error('expected playing phase');
    if (playing.deadlineAt === null) throw new Error('expected an armed stage deadline');
    const settleContext: CommandContext = {
      actor: { kind: 'system', effectId: 'effect:1' },
      controlledSeat: null,
      nowMs: playing.deadlineAt,
      commandId: '__GAME_ID__.phase.settleExpired',
      randomSeed: 'seed',
    };
    const decision = __GAME_CAMEL__Engine.decide(
      state,
      { type: '__GAME_ID__.phase.settleExpired' },
      settleContext,
    );
    if (decision.kind === 'reject') throw new Error(`rejected: ${decision.reason}`);
    state = decision.events.reduce(__GAME_CAMEL__Engine.evolve, state);
    if (state.phase.kind !== 'ended') throw new Error('expected ended phase');
    const shellInput = {
      roomCode: '1234',
      capabilities: capabilities(),
      onBack: jest.fn(),
      onTitlePress: jest.fn(),
      onTitleLongPress: jest.fn(),
      user: { id: 'host', avatarUrl: null },
      gachaStatus: null,
      onUserActionPress: jest.fn(),
      connection: { status: 'live', pendingCommandCount: 0, onManualReconnect: jest.fn() },
      state,
      revision: 9,
      controlledSeat: null,
      seatsVisuallyDisabled: false,
      onSeatPress: jest.fn(),
      onBotSeatLongPress: null,
      seatController,
      profileSelection: null,
      onProfileClose: jest.fn(),
      onProfileLeaveSeat: jest.fn(),
      share,
      isLobby: false,
      hostManagement: { sections: [] },
      releaseBot: jest.fn(),
    } as const;
    const playerModel = create__GAME_PASCAL__RoomShellModel({
      ...shellInput,
      userId: 'bot-user',
      isHost: false,
      mySeat: 2,
    });
    expect(playerModel.bottomActions).toMatchObject({
      kind: 'stacked',
      message: '等待房主操作（再来一局 / 返回大厅）',
    });
    const hostModel = create__GAME_PASCAL__RoomShellModel({
      ...shellInput,
      userId: 'host',
      isHost: true,
      mySeat: 0,
    });
    expect(hostModel.bottomActions).toMatchObject({ kind: 'stacked', message: null });
  });
//#end
//#cap !identityViewing

  it('assembles the shell once the game has started', () => {
    let state = lobbyState(true);
    state = drive(state, { type: '__GAME_ID__.game.begin' });
    const model = create__GAME_PASCAL__RoomShellModel({
      roomCode: '1234',
      capabilities: capabilities(),
      onBack: jest.fn(),
      onTitlePress: jest.fn(),
      onTitleLongPress: jest.fn(),
      user: { id: 'host', avatarUrl: null },
      gachaStatus: null,
      onUserActionPress: jest.fn(),
      connection: { status: 'live', pendingCommandCount: 0, onManualReconnect: jest.fn() },
      state,
      revision: 6,
      userId: 'host',
      controlledSeat: null,
      seatsVisuallyDisabled: false,
      onSeatPress: jest.fn(),
      onBotSeatLongPress: null,
      seatController,
      profileSelection: null,
      onProfileClose: jest.fn(),
      onProfileLeaveSeat: jest.fn(),
      share,
      isLobby: false,
      isHost: true,
      mySeat: 0,
      hostManagement: null,
      releaseBot: jest.fn(),
    });
    expect(model.bottomActions).toEqual({
      kind: 'stacked',
      message: null,
      progress: null,
      layout: { primary: [], secondary: [], ghost: [] },
    });
  });
//#end
});

describe('create__GAME_PASCAL__HostManagement', () => {
//#cap identityViewing
  it('gates the viewing-stage begin on the full view record and offers the bot scaffold', () => {
    const state = viewingState();
    const model = create__GAME_PASCAL__HostManagement({
      state,
      isHost: true,
      capabilities: capabilities(),
      isSubmitting: false,
      submit: jest.fn(async () => true),
    });
    expect(model?.sections.map((section) => section.key)).toEqual(['game', 'bot-viewing', 'room']);
    const begin = model?.sections[0]?.actions[0];
    expect(begin).toMatchObject({
      isEnabled: false,
      disabledReason: '0/4 位玩家已查看身份，等待剩余玩家',
    });
  });

  it('enables begin once every seat has viewed', () => {
    let state = viewingState();
    state = drive(state, { type: '__GAME_ID__.role.viewed' });
    state = drive(state, { type: '__GAME_ID__.bots.markAllBotsViewed' });
    const model = create__GAME_PASCAL__HostManagement({
      state,
      isHost: true,
      capabilities: capabilities(),
      isSubmitting: false,
      submit: jest.fn(async () => true),
    });
    expect(model?.sections.map((section) => section.key)).toEqual(['game', 'room']);
    expect(model?.sections[0]?.actions[0]).toMatchObject({ isEnabled: true });
  });
//#end
//#cap !identityViewing
  it('keeps only room actions in the host panel during the stage phase', () => {
    let state = lobbyState(true);
    state = drive(state, { type: '__GAME_ID__.game.begin' });
    const model = create__GAME_PASCAL__HostManagement({
      state,
      isHost: true,
      capabilities: capabilities(),
      isSubmitting: false,
      submit: jest.fn(async () => true),
    });
    expect(model?.sections.map((section) => section.key)).toEqual(['room']);
  });
//#end
//#cap identityViewing

  describe('console primary', () => {
    const build = (state: __GAME_PASCAL__State) =>
      create__GAME_PASCAL__HostManagement({
        state,
        isHost: true,
        capabilities: capabilities(),
        isSubmitting: false,
        submit: jest.fn(async () => true),
      });

    it('blocks identity assignment in a non-full lobby and offers room sharing', () => {
      const step = resolveHostConsolePrimary(build(lobbyState(false))!);
      expect(step).toMatchObject({ actionKey: 'assign-roles', label: '分配角色' });
      if (step?.kind !== 'blocked') throw new Error('expected a blocked console primary');
      expect(step.reason).toBe('座位尚未坐满（还差 3 人）');
      expect(step.remedy?.label).toBe('分享房间');
    });

    it('offers identity assignment once the room is full', () => {
      const step = resolveHostConsolePrimary(build(lobbyState(true))!);
      if (step?.kind !== 'ready') throw new Error('expected a ready console primary');
    });

    it('blocks game start while viewing is incomplete, then offers it', () => {
      const blocked = resolveHostConsolePrimary(build(viewingState())!);
      expect(blocked).toMatchObject({ actionKey: 'start-game', label: '开始游戏' });
      if (blocked?.kind !== 'blocked') throw new Error('expected a blocked console primary');
      expect(blocked.reason).toBe('0/4 位玩家已查看身份，等待剩余玩家');
      expect(blocked.remedy).toBeNull();

      let state = viewingState();
      state = drive(state, { type: '__GAME_ID__.role.viewed' });
      state = drive(state, { type: '__GAME_ID__.bots.markAllBotsViewed' });
      const ready = resolveHostConsolePrimary(build(state)!);
      if (ready?.kind !== 'ready') throw new Error('expected a ready console primary');
    });
  });
//#end
});
