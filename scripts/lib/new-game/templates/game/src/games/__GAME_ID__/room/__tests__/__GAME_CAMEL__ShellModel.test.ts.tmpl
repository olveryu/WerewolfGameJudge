    const screen = render(renderPanel(model));
    expect(screen.queryByText(AUDIO_WAITING_LABEL)).toBeNull();

    const queued = __GAME_CAMEL__Engine.evolve(state, {
      type: '__GAME_ID__.audio.queued',
      effects: [{ audioKey: 'night' }],
    });
    const during = create__GAME_PASCAL__RoomShellModel({ ...input, state: queued });
    expect(during.isAudioPlaying).toBe(true);
    screen.rerender(renderPanel(during));
    expect(screen.getByText(AUDIO_WAITING_LABEL)).toBeTruthy();

    const after = create__GAME_PASCAL__RoomShellModel({
      ...input,
      state: drive(queued, { type: '__GAME_ID__.audio.ack', audioBatchId: queued.audioBatchId }),
