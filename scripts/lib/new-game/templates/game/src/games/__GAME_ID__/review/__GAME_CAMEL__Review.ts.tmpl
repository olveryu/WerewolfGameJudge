/**
 * __GAME_DISPLAY_NAME__本局复盘贡献：终局后对所有观看者开放（终局身份全公开），任何读者都
 * 可分享，打开前无需确认。TODO(gameplay): 有中止局（isAborted）或局中
 * 复盘时在这里按阶段补可用条件；有真实分享权限规则时改 sharing。
 */

import type { __GAME_PASCAL__State } from '@game-judge/game-engine/games/__GAME_ID__/public';

import type { RoomReviewContribution } from '@/features/room/review/types';

import { to__GAME_PASCAL__ReviewDocument } from './to__GAME_PASCAL__ReviewDocument';

/** The __GAME_PASCAL__ review: available to every viewer once the game ended. */
export const __GAME_CAMEL__Review: RoomReviewContribution<__GAME_PASCAL__State> = {
  resolve: ({ state, roomCode }) =>
    state.phase.kind === 'ended'
      ? {
          kind: 'available',
          document: to__GAME_PASCAL__ReviewDocument({ state, roomCode }),
          sharing: { isAllowed: true },
          confirmation: null,
        }
      : { kind: 'notEnded' },
};
