/** 本游戏房主面板没有只读动作，播报锁无豁免（与阿瓦隆同口径）；将来面板加只读动作时把其 key 登记在这里。 */
const __GAME_UPPER___AUDIO_LOCK_EXEMPT_ACTION_KEYS: ReadonlySet<string> = new Set();
//#end
import { get__GAME_PASCAL__RoomCommandFailureMessage } from '../__GAME_CAMEL__RoomCommandFailureMessage';
//#cap audioOrchestration
import { use__GAME_PASCAL__AudioOrchestration } from './use__GAME_PASCAL__AudioOrchestration';
