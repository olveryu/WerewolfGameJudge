} from '../__GAME_CAMEL__RoomAdapter';
//#cap audioOrchestration

/** 本游戏房主面板没有只读动作，播报锁无豁免（与阿瓦隆同口径）；将来面板加只读动作时把其 key 登记在这里。 */
const __GAME_UPPER___AUDIO_LOCK_EXEMPT_ACTION_KEYS: ReadonlySet<string> = new Set();
//#end
import { get__GAME_PASCAL__RoomCommandFailureMessage } from '../__GAME_CAMEL__RoomCommandFailureMessage';
//#cap audioOrchestration
import { use__GAME_PASCAL__AudioOrchestration } from './use__GAME_PASCAL__AudioOrchestration';
//#end

/**
//#cap identityViewing
 * __GAME_DISPLAY_NAME__房间 Screen 的显式契约：领域推导（视图模型、身份卡锚点）
//#end
//#cap !identityViewing
 * __GAME_DISPLAY_NAME__房间 Screen 的显式契约：领域推导（视图模型、阶段截止）
//#end
 * 全部在本 hook 内组装，Screen 只消费本接口渲染。末尾 return 不许 spread。
 */
export interface __GAME_PASCAL__RoomScreenState {
  readonly state: __GAME_PASCAL__State;
  readonly shellModel: RoomShellModel;
//#cap identityViewing
  /** 当前视角的视图模型（按有效席位裁剪）；大厅为 null。 */
  readonly viewModel: __GAME_PASCAL__ViewModel | null;
//#end
//#cap !identityViewing
  /** 当前视角的视图模型（按有效席位裁剪）。 */
  readonly viewModel: __GAME_PASCAL__ViewModel;
//#end
//#cap publicExpire
  /** 当前阶段剩余秒数；无截止阶段为 null。到期由本 hook 统一派发阶段推进。 */
  readonly remainingSeconds: number | null;
//#end
  readonly roomCode: string;
  readonly userId: string;
  readonly mySeat: number | null;
  readonly effectiveSeat: number | null;
  readonly controlledSeat: number | null;
  readonly isHost: boolean;
  /** 平台单飞提交：座位动作由调用点显式传 `{ controlledSeat }`，房主命令不传。 */
  readonly submit: ReadyRoomSession<__GAME_PASCAL__State, __GAME_PASCAL__Command>['submit'];
  readonly session: __GAME_PASCAL__RoomSession;
  readonly openRules: () => void;
//#cap identityViewing
  /** 身份卡：先落查看记录、确认后再弹卡（平台 useRoleViewing）。 */
  readonly roleViewing: RoleViewing;
  readonly roleCardAllRoles: readonly RevealRoleData[];
//#end
}

/** 把当前就绪 session 绑定到房间壳控制器与命令上。 */
export function use__GAME_PASCAL__RoomState(
  props: GameRoomScreenProps<'__GAME_ID__'> & {
    readonly session: __GAME_PASCAL__RoomSession;
    readonly entryController: RoomEntryController;
  },
): __GAME_PASCAL__RoomScreenState {
  const { session, room, navigation, entryController } = props;
  const { user, state, revision, submit, isSubmitting } = useReadyRoomSession(
    session,
    get__GAME_PASCAL__RoomCommandFailureMessage,
  );
  const isHost = state.hostUserId === user.id;
  const mySeat = get__GAME_PASCAL__UserSeat(state, user.id);
  const viewer: RoomViewer = { userId: user.id, isHost, seat: mySeat };
  const isLobby = state.phase.kind === 'lobby';
  // 机器人接管：房主随时可接管；失去房主身份或座位不再是机器人时由共享守卫释放。
  const bots = useBotTakeover({
    viewer,
    isBotSeat: (seat) => isBotSeat(state.roster, seat),
    gameName: '__GAME_PASCAL__',
  });
  const { controlledSeat, effectiveSeat } = bots;
  const { share, titleActions, gachaStatus } = useRoomPresentationController({
    roomCode: room.roomCode,
    gameDisplayName: '__GAME_DISPLAY_NAME__',
    isHost,
    entryReason: props.entryReason,
  });
  const { seatController, profile, capabilities: setupCapabilities } = useRoomSetupController({
    session,
    user,
    isSetup: isLobby,
    isHost,
    mySeat,
    supportsBots: true,
    hasOccupiedSeats: get__GAME_PASCAL__OccupiedSeatCount(state) > 0,
    isRoomFull: get__GAME_PASCAL__OccupiedSeatCount(state) === state.config.numberOfPlayers,
    configureGame: () =>
      navigation.navigate('GameConfig', {
        gameType: '__GAME_ID__',
        mode: 'edit',
        roomCode: room.roomCode,
      }),
    shareRoom: share.open,
  });
//#cap audioOrchestration
  // 播报绑定：房主端按权威队列顺序播放、播完提交 ack（共享运行核的薄绑定）。
  // 音频运行时是本游戏资产（播放器 + 资源 registry），骨架阶段传 null 保持
  // 静默；就绪后把运行时实例传进这里，绑定即刻生效。
  use__GAME_PASCAL__AudioOrchestration({ session, isHost, audio: null });
//#end
//#cap publicExpire
  // 阶段截止：剩余秒数与到期推进。服务端定时 settle effect 是正确性
  // 路径；这里的前台派发只是加速，守卫保证不重复结算。
  const deadlineAt = state.phase.kind === 'playing' ? state.phase.deadlineAt : null;
  const shouldExpire = useCallback(() => {
    const current = session.getSnapshot();
    return (
      current.phase === 'ready' &&
      current.status.kind === 'live' &&
      current.pendingDurableCount === 0 &&
      current.room.state.phaseRevision === state.phaseRevision
    );
  }, [session, state.phaseRevision]);
  const onExpire = useCallback(
    () =>
      session.dispatch(
        { type: '__GAME_ID__.phase.expire' },
        { controlledSeat: null, label: '推进舞台阶段', durable: true },
      ),
    [session],
  );
  const { remainingSeconds } = useStageDeadline({
    deadlineAt,
    shouldExpire,
    onExpire,
    label: '推进舞台阶段',
    silentExpire: true,
  });
//#end
//#cap !identityViewing
  const viewModel = get__GAME_PASCAL__ViewModel(state, effectiveSeat);
//#end
//#cap identityViewing
  // 身份查看协议：查看记录先落（接管时是被接管座位），服务端确认后才弹卡。
  const roleViewing = useRoleViewing({
    effectiveSeat,
    identityKey: isLobby ? null : state.gameSequence,
    hasViewed:
      state.phase.kind === 'ended' ||
      (effectiveSeat !== null && state.roleViewedSeats.includes(effectiveSeat)),
    occupiedSeatCount: get__GAME_PASCAL__OccupiedSeatCount(state),
    viewedSeatCount: state.roleViewedSeats.length,
    submitViewed: () =>
      submit('查看身份', { type: '__GAME_ID__.role.viewed' }, { controlledSeat }),
  });
//#end
  const capabilities: RoomCapabilities = {
    ...setupCapabilities,
    canTakeOverBots: bots.capability,
  };
  const onSeatPress = createRoomSeatPressHandler({
    isSetup: isLobby,
    state,
    currentSeat: mySeat,
    resolveIntent: get__GAME_PASCAL__SeatTapIntent,
    profile,
    seatController,
  });
//#cap audioOrchestration
  // 房主面板模型在离开本 hook 前过一遍播报锁（组合子在共享层一份）：
  // 播报期内非豁免动作翻禁用且点不动，两个渲染面（折叠控制台与展开
  // 面板）同时生效。工厂本体多出口且各出口在其他 cap 段内，无法在工厂
  // 里再嵌一层 cap，故锁点在本 hook 的组装出口——模型到达任何渲染面
  // 之前必经此处，与已落地两家「组装后统一过锁」的语义一致。
  const buildHostManagement = () =>
    applyAudioPlaybackLock(
      create__GAME_PASCAL__HostManagement({
        state,
        capabilities,
        isSubmitting,
        submit,
      }),
      {
        isAudioPlaying: state.isAudioPlaying,
        exemptActionKeys: __GAME_UPPER___AUDIO_LOCK_EXEMPT_ACTION_KEYS,
      },
    );
//#end
//#cap !audioOrchestration
  const buildHostManagement = () =>
    create__GAME_PASCAL__HostManagement({
      state,
      capabilities,
      isSubmitting,
      submit,
    });
//#end

  const shellModel: RoomShellModel = create__GAME_PASCAL__RoomShellModel({
    roomCode: room.roomCode,
    viewer,
    capabilities,
    onBack: () => entryController.requestExit(capabilities.shouldConfirmExit),
    onTitlePress: titleActions.handleTitlePress,
    onTitleLongPress: titleActions.handleTitleLongPress,
    user,
    gachaStatus,
    onUserActionPress: () => navigation.navigate('Settings', { roomCode: room.roomCode }),
    connection: entryController.connection,
    state,
    revision,
    controlledSeat,
    seatsVisuallyDisabled: isSubmitting || seatController.isSubmitting,
    onSeatPress,
    onBotSeatLongPress: bots.capability.isAllowed ? bots.onBotSeatLongPress : null,
    seatController,
    profileSelection: profile.selection,
    onProfileClose: profile.close,
    onProfileLeaveSeat: profile.leaveSelf,
    share,
    isLobby,
    buildHostManagement,
    releaseBot: bots.release,
  });
//#cap identityViewing
  const viewModel = isLobby ? null : get__GAME_PASCAL__ViewModel(state, effectiveSeat);
//#end
  return {
    state,
    shellModel,
    viewModel,
//#cap publicExpire
    remainingSeconds,
//#end
    roomCode: room.roomCode,
    userId: user.id,
    mySeat,
    effectiveSeat,
    controlledSeat,
    isHost,
    submit,
    session,
    openRules: () =>
      navigation.navigate('GameGuide', { gameType: '__GAME_ID__', roomCode: room.roomCode }),
//#cap identityViewing
    roleViewing,
    roleCardAllRoles: Object.values(state.identities).map(toRevealRoleData),
//#end
  };
}
