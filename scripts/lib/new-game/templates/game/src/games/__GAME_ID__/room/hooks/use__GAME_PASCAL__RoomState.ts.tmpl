/**
//#cap identityViewing
 * __GAME_DISPLAY_NAME__房间 Screen 的显式契约：领域推导（视图模型、身份卡锚点）
//#end
//#cap !identityViewing
 * __GAME_DISPLAY_NAME__房间 Screen 的显式契约：领域推导（视图模型、阶段截止）
//#end
 * 全部在本 hook 内组装，Screen 只消费本接口渲染。末尾 return 不许 spread。
 */
export interface __GAME_PASCAL__RoomScreenState {
  readonly state: __GAME_PASCAL__State;
  readonly shellModel: RoomShellModel;
//#cap identityViewing
  /** 当前视角的视图模型（按有效席位裁剪）；大厅为 null。 */
  readonly viewModel: __GAME_PASCAL__ViewModel | null;
//#end
//#cap !identityViewing
  /** 当前视角的视图模型（按有效席位裁剪）。 */
  readonly viewModel: __GAME_PASCAL__ViewModel;
//#end
//#cap publicExpire
  /** 当前阶段剩余秒数；无截止阶段为 null。到期由本 hook 统一派发阶段推进。 */
  readonly remainingSeconds: number | null;
//#end
  readonly roomCode: string;
  readonly userId: string;
  readonly mySeat: number | null;
  readonly effectiveSeat: number | null;
  readonly controlledSeat: number | null;
  readonly isHost: boolean;
  readonly canControlBots: boolean;
  readonly takeOver: RoomBotControl['takeOver'];
  readonly releaseBot: RoomBotControl['release'];
  readonly submit: (
    label: string,
    command: __GAME_PASCAL__Command,
    control?: number | null,
  ) => Promise<boolean>;
  readonly session: __GAME_PASCAL__RoomSession;
  readonly openRules: () => void;
//#cap identityViewing
  /** 身份卡弹窗开关与打开动作（打开即落查看记录）。 */
  readonly roleCardVisible: boolean;
  readonly setRoleCardVisible: (visible: boolean) => void;
  readonly onViewRolePress: () => void;
  /** 首次查看才播揭示动画（服务端查看记录锚点）；接管机器人时恒 false。 */
  readonly roleCardShouldPlay: boolean;
  readonly roleCardAllRoles: readonly RevealRoleData[];
  readonly roleCardRemainingCards: number;
//#end
}

/** 把当前就绪 session 绑定到房间壳控制器与命令上。 */
export function use__GAME_PASCAL__RoomState(
  props: GameRoomScreenProps<'__GAME_ID__'> & {
    readonly session: __GAME_PASCAL__RoomSession;
    readonly entryController: RoomEntryController;
  },
): __GAME_PASCAL__RoomScreenState {
  const { session, room, navigation, entryController } = props;
  const { user } = useAuthContext();
  const snapshot = useRoomSessionSnapshot(session);
  if (user === null || snapshot.phase !== 'ready')
    throw new Error('__GAME_PASCAL__ requires an authenticated ready session');
  const state = snapshot.snapshot.state;
  const isHost = state.hostUserId === user.id;
  const mySeat = get__GAME_PASCAL__UserSeat(state, user.id);
  const isLobby = state.phase.kind === 'lobby';
  const botControl = useRoomBotControl();
  const { controlledSeat, release: releaseBot, takeOver } = botControl;
  const effectiveSeat = controlledSeat ?? mySeat;
  const seats = useStandardSeatCommands(session, user);
  const seatController = useRoomSeatController({ currentSeat: mySeat, takeSeat: seats.takeSeat });
  const profile = useRoomProfileController({
    myUserId: user.id,
    kickSeat: seats.kickSeat,
    leaveSeat: seats.leaveSeat,
  });
  const host = useRoomHostOperations({ clearSeats: seats.clearSeats, fillBots: seats.fillBots });
  const share = useRoomShareController({
    roomCode: room.roomCode,
    gameDisplayName: '__GAME_DISPLAY_NAME__',
  });
  const titleActions = useRoomTitleActions();
  const { data: gachaStatus } = useGachaStatusQuery();
  const submission = useRoomCommandSubmission(get__GAME_PASCAL__RoomCommandFailureMessage);
  // 派发纪律（#149 定版）：默认不带接管座位。房主命令的平台门只认未接管
//#cap identityViewing
  // 身份；座位动作（以被接管机器人身份发出的查看等）由调用方显式传
//#end
//#cap !identityViewing
  // 身份；座位动作由调用方显式传 controlledSeat。
//#end
//#cap identityViewing
  // controlledSeat。
//#end
  const submit = (label: string, command: __GAME_PASCAL__Command, control: number | null = null) =>
    submission.submit(label, () => session.dispatch(command, { controlledSeat: control, label }));
//#cap audioOrchestration
  // 播报绑定：房主端按权威队列顺序播放、播完提交 ack（共享运行核的薄绑定）。
  // 音频运行时是本游戏资产（播放器 + 资源 registry），骨架阶段传 null 保持
  // 静默；就绪后把运行时实例传进这里，绑定即刻生效。
  use__GAME_PASCAL__AudioOrchestration({ session, isHost, audio: null });
//#end
//#cap publicExpire
  // 阶段截止：剩余秒数与到期推进。服务端定时 settle effect 是正确性
  // 路径；这里的前台派发只是加速，守卫保证不重复结算。
  const deadlineAt = state.phase.kind === 'playing' ? state.phase.deadlineAt : null;
  const shouldExpire = useCallback(() => {
    const current = session.getSnapshot();
    return (
      current.phase === 'ready' &&
      current.connection === 'live' &&
      current.pendingCommandCount === 0 &&
      current.snapshot.state.phaseRevision === state.phaseRevision
    );
  }, [session, state.phaseRevision]);
  const onExpire = useCallback(
    () =>
      session.dispatch(
        { type: '__GAME_ID__.phase.expire' },
        { controlledSeat: null, label: '推进舞台阶段', isRecoverable: true },
      ),
    [session],
  );
  const remainingSeconds = useStageDeadline({
    deadlineAt,
    shouldExpire,
    onExpire,
    label: '推进舞台阶段',
    silentExpire: true,
  });
//#end
//#cap !identityViewing
  const viewModel = get__GAME_PASCAL__ViewModel(state, effectiveSeat);
//#end
//#cap identityViewing
  const [roleCardVisible, setRoleCardVisible] = useState(false);
  const onViewRolePress = () => {
    setRoleCardVisible(true);
    // 身份查看协议：打开身份卡即为当前座位落查看记录
    //（接管时是被接管座位；引擎幂等，终局后不发）。
    if (
      effectiveSeat !== null &&
      state.phase.kind !== 'lobby' &&
      state.phase.kind !== 'ended' &&
      !state.roleViewedSeats.includes(effectiveSeat)
    ) {
      void submit('查看身份', { type: '__GAME_ID__.role.viewed' }, controlledSeat);
    }
  };
//#end
  // 机器人接管：房主随时可接管（无阶段条件）；失去房主身份或座位不再是机器人时自动释放。
  const canControlBots = isHost;
  useBotTakeoverGuard({
    controlledSeat,
    canControlBots,
    seatStillBot: controlledSeat === null || isBotSeat(state.roster, controlledSeat),
    release: releaseBot,
  });
  const capabilities: RoomCapabilities = {
    ...createRoomSetupCapabilities({
      isSetup: isLobby,
      isHost,
      mySeat,
      supportsBots: true,
      hasOccupiedSeats: get__GAME_PASCAL__OccupiedSeatCount(state) > 0,
      isRoomFull: get__GAME_PASCAL__OccupiedSeatCount(state) === state.config.numberOfPlayers,
      requestTakeSeat: seatController.requestTakeSeat,
      requestMoveSeat: seatController.requestMoveSeat,
      leaveSeat: profile.leaveSelf,
      kickSeat: profile.kick,
      clearSeats: host.requestClearSeats,
      fillBots: host.requestFillBots,
      configureGame: () =>
        navigation.navigate('GameConfig', {
          gameType: '__GAME_ID__',
          mode: 'edit',
          roomCode: room.roomCode,
        }),
      shareRoom: share.open,
    }),
    canViewProfiles: createViewProfilesCapability(isLobby, profile.open),
    canTakeOverBots: createBotTakeoverCapability(canControlBots, takeOver),
  };
  const isSeatBot = useCallback((seat: number) => isBotSeat(state.roster, seat), [state]);
  const onBotSeatLongPress = useBotTakeoverLongPress({
    controlledSeat,
    takeOver,
    release: releaseBot,
    canTakeOver: capabilities.canTakeOverBots.isAllowed,
    deniedReason: capabilities.canTakeOverBots.isAllowed
      ? undefined
      : (capabilities.canTakeOverBots.reason ?? undefined),
    isBotSeat: isSeatBot,
    gameName: '__GAME_PASCAL__',
  });
  const onSeatPress = (seat: number, disabledReason?: string) => {
    // 局内裁决走共享 resolveRoomInGameSeatTap（同一实现，全平台一份）。
    if (!isLobby) {
      const outcome = resolveRoomInGameSeatTap(disabledReason);
      if (outcome.kind === 'alert')
        return showErrorAlert(ROOM_SEAT_TAP_BLOCKED_TITLE, outcome.reason);
      return;
    }
    const intent = get__GAME_PASCAL__SeatTapIntent({
      state,
      seat,
      currentSeat: mySeat,
      disabledReason,
    });
    switch (intent.kind) {
      case 'blocked':
        return showErrorAlert(ROOM_SEAT_TAP_BLOCKED_TITLE, intent.reason);
      case 'profile':
        return profile.open(intent.target);
      case 'take':
        return seatController.requestTakeSeat(intent.seat);
      case 'move':
        return seatController.requestMoveSeat(intent.seat);
    }
  };
  const selection = profile.selection;
//#cap audioOrchestration
  // 房主面板模型在离开本 hook 前过一遍播报锁（组合子在共享层一份）：
  // 播报期内非豁免动作翻禁用且点不动，两个渲染面（折叠控制台与展开
  // 面板）同时生效。工厂本体多出口且各出口在其他 cap 段内，无法在工厂
  // 里再嵌一层 cap，故锁点在本 hook 的组装出口——模型到达任何渲染面
  // 之前必经此处，与已落地两家「组装后统一过锁」的语义一致。
  const hostManagement = applyAudioPlaybackLock(
    create__GAME_PASCAL__HostManagement({
      state,
      isHost,
      capabilities,
      isSubmitting: submission.isSubmitting,
      submit,
    }),
    {
      isAudioPlaying: state.isAudioPlaying,
      exemptActionKeys: __GAME_UPPER___AUDIO_LOCK_EXEMPT_ACTION_KEYS,
    },
  );
//#end
//#cap !audioOrchestration
  const hostManagement = create__GAME_PASCAL__HostManagement({
    state,
    isHost,
    capabilities,
    isSubmitting: submission.isSubmitting,
    submit,
  });
//#end

  const shellModel: RoomShellModel = create__GAME_PASCAL__RoomShellModel({
    roomCode: room.roomCode,
    capabilities,
    onBack: () => entryController.requestExit(capabilities.shouldConfirmExit),
    onTitlePress: titleActions.handleTitlePress,
    onTitleLongPress: titleActions.handleTitleLongPress,
    user,
    gachaStatus,
    onUserActionPress: () => navigation.navigate('Settings', { roomCode: room.roomCode }),
    connection: entryController.connection,
    state,
    revision: snapshot.snapshot.revision,
    userId: user.id,
    controlledSeat,
    seatsVisuallyDisabled: submission.isSubmitting || seatController.isSubmitting,
    onSeatPress,
    onBotSeatLongPress: canControlBots ? onBotSeatLongPress : null,
    seatController,
    profileSelection: selection,
    onProfileClose: profile.close,
    onProfileLeaveSeat: profile.leaveSelf,
    share,
    isLobby,
    isHost,
    mySeat,
    hostManagement,
    releaseBot,
  });
  const openShare = share.open;
  useAutoShowRoomShareQr({ isHost, entryReason: props.entryReason, openShare });
//#cap identityViewing
  const viewModel = isLobby ? null : get__GAME_PASCAL__ViewModel(state, effectiveSeat);
  const roleCardShouldPlay =
    controlledSeat === null &&
    effectiveSeat !== null &&
    !state.roleViewedSeats.includes(effectiveSeat);
  const roleCardAllRoles = Object.values(state.identities).map(toRevealRoleData);
  const roleCardRemainingCards = deriveRemainingRevealCards(
    get__GAME_PASCAL__OccupiedSeatCount(state),
    state.roleViewedSeats.length,
  );
//#end
  return {
    state,
    shellModel,
    viewModel,
//#cap publicExpire
    remainingSeconds,
//#end
    roomCode: room.roomCode,
    userId: user.id,
    mySeat,
    effectiveSeat,
    controlledSeat,
    isHost,
    canControlBots,
    takeOver,
    releaseBot,
    submit,
    session,
    openRules: () =>
      navigation.navigate('GameGuide', { gameType: '__GAME_ID__', roomCode: room.roomCode }),
//#cap identityViewing
    roleCardVisible,
    setRoleCardVisible,
    onViewRolePress,
    roleCardShouldPlay,
    roleCardAllRoles,
    roleCardRemainingCards,
//#end
  };
}
