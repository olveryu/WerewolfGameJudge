/** Strict __GAME_PASCAL__ persistence and transport codec; v1 is the current version. */

import {
  failDecode,
  finishObject,
//#cap identityViewing
  parseArray,
//#end
  parseBoolean,
  parseChoice,
  parseInteger,
  parseNonEmptyString,
//#cap stageDeadline
  parseNullable,
//#end
  parseObject,
//#cap identityViewing
  parseSeat,
//#end
} from '../../../platform/protocol/runtimeDecoder';
//#cap audioOrchestration
import { type AudioEffect, parseAudioBatchId } from '../../../platform/audio';
//#end
import { parseRoomRoster } from '../../../platform/room/roster';
import { normalize__GAME_PASCAL__State } from './normalize';
import {
  isValid__GAME_PASCAL__Config,
  __GAME_UPPER___GAME_TYPE,
  __GAME_UPPER___PHASES,
  type __GAME_PASCAL__Config,
  type __GAME_PASCAL__Phase,
  type __GAME_PASCAL__State,
} from './types';
import { __GAME_UPPER___STATE_VERSION } from './version';

/** Parses only the supported lobby settings. */
export function parse__GAME_PASCAL__Config(
  value: unknown,
  path = '__GAME_PASCAL__Config',
): __GAME_PASCAL__Config {
  const raw = parseObject(value, path);
  const config: __GAME_PASCAL__Config = finishObject(
    raw,
    { numberOfPlayers: parseInteger(raw.numberOfPlayers, `${path}.numberOfPlayers`) },
    path,
  );
  if (!isValid__GAME_PASCAL__Config(config))
    failDecode(`${path}.numberOfPlayers`, 'a supported player count');
  return config;
}

//#cap audioOrchestration
function audioEffect(value: unknown, path: string): AudioEffect {
  const raw = parseObject(value, path);
  return finishObject(
    raw,
    {
      audioKey: parseNonEmptyString(raw.audioKey, `${path}.audioKey`),
      isEndAudio:
        raw.isEndAudio === undefined
          ? undefined
          : parseBoolean(raw.isEndAudio, `${path}.isEndAudio`),
    },
    path,
  );
}

function audioEffects(value: unknown, path: string): readonly AudioEffect[] {
  if (!Array.isArray(value)) failDecode(path, 'an array');
  return value.map((item, index) => audioEffect(item, `${path}[${index}]`));
}

//#end
//#cap identityViewing
function identities(value: unknown, path: string): Readonly<Record<number, string>> {
  const raw = parseObject(value, path);
  const result: Record<number, string> = {};
  for (const [key, identity] of Object.entries(raw)) {
    if (!/^(0|[1-9]\d*)$/.test(key)) failDecode(`${path}.${key}`, 'a canonical seat key');
    result[parseSeat(Number(key), `${path}.${key}`)] = parseNonEmptyString(
      identity,
      `${path}.${key}`,
    );
  }
  return result;
}

//#end
function phase(value: unknown, path: string): __GAME_PASCAL__Phase {
  const raw = parseObject(value, path);
  const kind = parseChoice(raw.kind, `${path}.kind`, __GAME_UPPER___PHASES);
  switch (kind) {
    case 'lobby':
      return finishObject(raw, { kind: 'lobby' as const }, path);
//#cap identityViewing
    case 'viewing':
      return finishObject(raw, { kind: 'viewing' as const }, path);
//#end
//#cap !stageDeadline
    // TODO(gameplay): playing 阶段加字段时在这里逐字段严格解析。
    case 'playing':
      return finishObject(raw, { kind: 'playing' as const }, path);
//#end
//#cap stageDeadline
    // TODO(gameplay): playing 阶段加字段时在这里逐字段严格解析。
    case 'playing':
      return finishObject(
        raw,
        {
          kind: 'playing' as const,
          deadlineAt:
            raw.deadlineAt === undefined
              ? null
              : parseNullable(raw.deadlineAt, `${path}.deadlineAt`, parseInteger),
        },
        path,
      );
//#end
    case 'ended':
      return finishObject(raw, { kind: 'ended' as const }, path);
  }
}

/** Restores the complete authoritative state and rejects unknown or malformed fields. */
export function parse__GAME_PASCAL__State(value: unknown): __GAME_PASCAL__State {
  const path = '__GAME_PASCAL__State';
  const raw = parseObject(value, path);
  return normalize__GAME_PASCAL__State(
    finishObject(
      raw,
      {
        gameType: parseChoice(raw.gameType, `${path}.gameType`, [__GAME_UPPER___GAME_TYPE]),
        stateVersion: parseChoice(raw.stateVersion, `${path}.stateVersion`, [
          __GAME_UPPER___STATE_VERSION,
        ]),
        roomCode: parseNonEmptyString(raw.roomCode, `${path}.roomCode`),
        hostUserId: parseNonEmptyString(raw.hostUserId, `${path}.hostUserId`),
        phase: phase(raw.phase, `${path}.phase`),
        phaseRevision: parseInteger(raw.phaseRevision, `${path}.phaseRevision`),
        config: parse__GAME_PASCAL__Config(raw.config, `${path}.config`),
        roster: parseRoomRoster(raw.roster, `${path}.roster`),
//#cap identityViewing
        identities: identities(raw.identities, `${path}.identities`),
        roleViewedSeats: parseArray(raw.roleViewedSeats, `${path}.roleViewedSeats`, parseSeat),
//#end
        gameSequence: parseInteger(raw.gameSequence, `${path}.gameSequence`),
        xpSettled: parseBoolean(raw.xpSettled, `${path}.xpSettled`),
//#cap audioOrchestration
        pendingAudioEffects: audioEffects(
          raw.pendingAudioEffects,
          `${path}.pendingAudioEffects`,
        ),
        isAudioPlaying: parseBoolean(raw.isAudioPlaying, `${path}.isAudioPlaying`),
        audioBatchId: parseAudioBatchId(raw.audioBatchId, `${path}.audioBatchId`),
//#end
      },
      path,
    ),
  );
}

/**
 * Upgrades stored states to the current version. v1 is current, so this
 * is the strict parser itself; when the state version bumps, older
 * payloads are upgraded here field by field before the strict parse.
 */
export function migratePersisted__GAME_PASCAL__State(value: unknown): __GAME_PASCAL__State {
  return parse__GAME_PASCAL__State(value);
}
