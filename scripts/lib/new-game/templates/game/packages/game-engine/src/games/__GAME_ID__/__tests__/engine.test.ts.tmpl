//#cap identityViewing
describe('__GAME_PASCAL__ identity viewing checkpoint', () => {
  it('deals identities into the viewing stage with an empty view record', () => {
    const session = game({ numberOfPlayers: 4 }, 2);
    session.send({ type: '__GAME_ID__.roles.assign' });
    expect(session.state.phase.kind).toBe('viewing');
    expect(Object.keys(session.state.identities)).toHaveLength(4);
    expect(session.state.roleViewedSeats).toEqual([]);
  });

  it('rejects role.viewed in the lobby', () => {
    const session = game({ numberOfPlayers: 4 });
    const decision = session.decideAs({ type: '__GAME_ID__.role.viewed' }, session.seatUser(1));
    expect(decision.kind).toBe('reject');
    if (decision.kind === 'reject') expect(decision.reason).toBe(__GAME_UPPER___REASONS.phase);
  });

  it('holds begin until every seat — bots included — has viewed', () => {
    const session = game({ numberOfPlayers: 4 }, 2);
    session.send({ type: '__GAME_ID__.roles.assign' });
    session.send({ type: '__GAME_ID__.role.viewed' }, session.seatUser(0));
    session.send({ type: '__GAME_ID__.role.viewed' }, session.seatUser(1));
    const blocked = session.decideAs({ type: '__GAME_ID__.game.begin' });
    expect(blocked.kind).toBe('reject');
    if (blocked.kind === 'reject')
      expect(blocked.reason).toBe(__GAME_UPPER___REASONS.notAllViewed);
//#cap botBulkViewing
    session.send({ type: '__GAME_ID__.bots.markAllBotsViewed' });
//#end
//#cap !botBulkViewing
    for (const seat of getBotSeats(session.state.roster)) {
      session.send({ type: '__GAME_ID__.role.viewed' }, 'host', seat);
    }
//#end
    session.send({ type: '__GAME_ID__.game.begin' });
    expect(session.state.phase.kind).toBe('playing');
  });

  it('projects identities per viewer: self visible, others hidden until the end', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    viewAllAndBegin(session);
    const ownView = get__GAME_PASCAL__ViewModel(session.state, 1);
    expect(ownView.myIdentity).toBe(session.state.identities[1]);
    expect(ownView.seats.every((seat) => seat.identity === null)).toBe(true);

    const spectatorView = get__GAME_PASCAL__ViewModel(session.state, null);
    expect(spectatorView.myIdentity).toBeNull();
    expect(spectatorView.seats.every((seat) => seat.identity === null)).toBe(true);

    const endDecision = end__GAME_PASCAL__Game(
      session.state,
      session.session.context('host'),
    );
    if (endDecision.kind !== 'commit') throw new Error(endDecision.reason);
    const ended = endDecision.events.reduce(__GAME_CAMEL__Engine.evolve, session.state);
    const endedSpectatorView = get__GAME_PASCAL__ViewModel(ended, null);
    expect(endedSpectatorView.myIdentity).toBeNull();
    expect(endedSpectatorView.seats.map((seat) => seat.identity)).toEqual(
      Object.values(ended.identities),
    );
  });
});

describe('__GAME_PASCAL__ terminal review', () => {
  it('tracks terminal review for eligible users without blocking restart', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    const command = { type: '__GAME_ID__.review.complete', gameSequence: 1 } as const;
    session.session.expectReject(command, REASON_GAME_IN_PROGRESS);
    viewAllAndBegin(session);
    const endDecision = end__GAME_PASCAL__Game(session.state, session.session.context('host'));
    if (endDecision.kind !== 'commit') throw new Error(endDecision.reason);
    const ended = parse__GAME_PASCAL__State(
      JSON.parse(JSON.stringify(endDecision.events.reduce(__GAME_CAMEL__Engine.evolve, session.state))),
    );
    const decide = (userId: string, controlledSeat: number | null = null) =>
      __GAME_CAMEL__Engine.decide(ended, command, session.session.context(userId, controlledSeat));
    expect(decide('spectator')).toEqual({ kind: 'reject', reason: REASON_REVIEW_NOT_ELIGIBLE });
    expect(decide('host', 1)).toEqual({ kind: 'reject', reason: REASON_CONTROLLED_SEAT_NOT_ALLOWED });
    expect(
      __GAME_CAMEL__Engine.decide(
        ended,
        { ...command, gameSequence: 0 },
        session.session.context('host'),
      ),
    ).toEqual({ kind: 'reject', reason: REASON_REVIEW_IDENTITY_MISMATCH });
    expect(
      __GAME_CAMEL__Engine.decide(ended, command, session.session.systemContext('review')),
    ).toEqual({ kind: 'reject', reason: REASON_USER_ACTOR_REQUIRED });

    const restart = {
      type: '__GAME_ID__.game.restart',
      gameSequence: ended.gameSequence,
      wasEnded: true,
    } as const;
    const resetWithoutReview = dispatchCommand(
      __GAME_CAMEL__Engine, ended, restart, session.session.context('host'), parse__GAME_PASCAL__State,
    );
    expect(resetWithoutReview.phase.kind).toBe('lobby');
    let completed = dispatchCommand(
      __GAME_CAMEL__Engine, ended, command, session.session.context('host'), parse__GAME_PASCAL__State,
    );
    completed = dispatchCommand(
      __GAME_CAMEL__Engine, completed, command, session.session.context('u1'), parse__GAME_PASCAL__State,
    );
    expect(completed.reviewCompletedUserIds).toEqual(['host', 'u1']);
    expect(__GAME_CAMEL__Engine.decide(completed, command, session.session.context('u1'))).toMatchObject({
      kind: 'commit', events: [], broadcast: 'none',
    });
    const reset = dispatchCommand(
      __GAME_CAMEL__Engine, completed, restart, session.session.context('host'), parse__GAME_PASCAL__State,
    );
    expect(reset.reviewCompletedUserIds).toEqual([]);
    expect(
      __GAME_CAMEL__Engine.decide(reset, command, session.session.context('host')),
    ).toEqual({ kind: 'reject', reason: REASON_GAME_IN_PROGRESS });
  });

  it('allows the host to complete a review without occupying a seat', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    session.send({ type: 'room.seat.leave' });
    session.send({ type: 'room.seat.fillBots' });
    viewAllAndBegin(session);
    const endDecision = end__GAME_PASCAL__Game(session.state, session.session.context('host'));
    if (endDecision.kind !== 'commit') throw new Error(endDecision.reason);
    const ended = endDecision.events.reduce(__GAME_CAMEL__Engine.evolve, session.state);
    const completed = dispatchCommand(
      __GAME_CAMEL__Engine,
      ended,
      { type: '__GAME_ID__.review.complete', gameSequence: ended.gameSequence },
      session.session.context('host'),
      parse__GAME_PASCAL__State,
    );
    expect(completed.reviewCompletedUserIds).toEqual(['host']);
  });
});

