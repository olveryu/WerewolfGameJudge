//#cap stageDeadlineAtStart
// The no-viewing deadline path starts immediately.
describe('__GAME_PASCAL__ stage deadline settlement', () => {
  it('opens the playing stage with an armed deadline and a settle.due effect', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    const startedAt = session.session.now();
    session.send({ type: '__GAME_ID__.game.begin' });
    expect(session.state.phase).toEqual({
      kind: 'playing',
      deadlineAt: startedAt + __GAME_UPPER___STAGE_DURATION_MS,
    });
    expect(session.effects).toEqual([
      {
        type: '__GAME_ID__.settle.due',
        payload: { gameSequence: 1, deadlineAt: startedAt + __GAME_UPPER___STAGE_DURATION_MS },
      },
    ]);
    expect(get__GAME_PASCAL__ViewModel(session.state, 0).stageDeadlineAt).toBe(
      startedAt + __GAME_UPPER___STAGE_DURATION_MS,
    );
  });

  it('rejects settle before the deadline, then settles exactly once at the deadline', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    session.send({ type: '__GAME_ID__.game.begin' });
    const early = __GAME_CAMEL__Engine.decide(
      session.state,
      { type: '__GAME_ID__.phase.settleExpired' },
      session.session.systemContext('settle-effect'),
    );
    expect(early.kind).toBe('reject');
    if (early.kind === 'reject') expect(early.reason).toBe(__GAME_UPPER___REASONS.deadline);
    session.session.advance(__GAME_UPPER___STAGE_DURATION_MS);
    const state = session.session.sendAs(
      { type: '__GAME_ID__.phase.settleExpired' },
      session.session.systemContext('settle-effect'),
    );
    expect(state.phase.kind).toBe('ended');
    expect(state.xpSettled).toBe(true);
    const completions = session.effects.filter(
      (effect) => effect.type === '__GAME_ID__.game.completed',
    );
    expect(completions).toHaveLength(1);
    expect(completions[0]?.payload.participantUserIds).toEqual(['host', 'u1', 'u2', 'u3']);
  });

  it('rejects the internal settle channel for a user actor', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    session.send({ type: '__GAME_ID__.game.begin' });
    session.session.advance(__GAME_UPPER___STAGE_DURATION_MS);
    const internalAsUser = session.decideAs({ type: '__GAME_ID__.phase.settleExpired' }, 'u1');
    expect(internalAsUser.kind).toBe('reject');
  });
});

//#end

