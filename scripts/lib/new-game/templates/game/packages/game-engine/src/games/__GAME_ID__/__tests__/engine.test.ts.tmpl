import {
  DEFAULT___GAME_UPPER___CONFIG,
  type __GAME_PASCAL__Config,
  type __GAME_PASCAL__State,
} from '../state/types';

function game(
  configOverrides: Partial<__GAME_PASCAL__Config> = {},
  humanCount?: number,
  fillRemainingWithBots = true,
) {
  const numberOfPlayers =
    configOverrides.numberOfPlayers ?? DEFAULT___GAME_UPPER___CONFIG.numberOfPlayers;
  const session = createEngineSession(__GAME_CAMEL__Engine, {
    config: { ...DEFAULT___GAME_UPPER___CONFIG, ...configOverrides },
    parse: parse__GAME_PASCAL__State,
  });
  const send = (
    command: __GAME_PASCAL__Command,
    userId = 'host',
    controlledSeat: number | null = null,
  ) => session.send(command, userId, controlledSeat);
  const decideAs = (
    command: __GAME_PASCAL__Command,
    userId = 'host',
    controlledSeat: number | null = null,
  ) => session.decide(command, userId, controlledSeat);
  const seatUser = (seat: number) => (seat === 0 ? 'host' : `u${seat}`);
  const seatCount = humanCount ?? numberOfPlayers;
  for (let seat = 0; seat < seatCount; seat += 1) {
    send({ type: 'room.seat.take', seat, profile: { displayName: `P${seat}` } }, seatUser(seat));
  }
  if (humanCount !== undefined && humanCount < numberOfPlayers && fillRemainingWithBots) {
    send({ type: 'room.seat.fillBots' });
  }
  return {
    get state(): __GAME_PASCAL__State {
      return session.state;
    },
    effects: session.effects,
    session,
    send,
    decideAs,
    seatUser,
  };
}

//#cap identityViewing
function viewAllAndBegin(session: ReturnType<typeof game>): void {
  session.send({ type: '__GAME_ID__.roles.assign' });
  for (let seat = 0; seat < session.state.config.numberOfPlayers; seat += 1) {
    if (isBotSeat(session.state.roster, seat)) continue;
    session.send({ type: '__GAME_ID__.role.viewed' }, session.seatUser(seat));
  }
  const botSeats = getBotSeats(session.state.roster);
  if (botSeats.length > 0) {
//#cap botBulkViewing
    session.send({ type: '__GAME_ID__.bots.markAllBotsViewed' });
//#end
//#cap !botBulkViewing
    for (const seat of botSeats) {
      session.send({ type: '__GAME_ID__.role.viewed' }, 'host', seat);
    }
//#end
  }
  session.send({ type: '__GAME_ID__.game.begin' });
}

//#end
describe('__GAME_PASCAL__ restart', () => {
  it('resets to preparation only for the host and the intended game and phase', () => {
    const session = game({ numberOfPlayers: 4 }, 2);
    __GAME_TEST_BEGIN__
    const before = session.state;
    const command = { type: '__GAME_ID__.game.restart', gameSequence: before.gameSequence, wasEnded: false } as const;
    session.session.expectReject(command, __GAME_UPPER___REASONS.notHostRestart, 'u1');
    session.session.expectReject(command, REASON_CONTROLLED_SEAT_NOT_ALLOWED, 'host', 2);
    session.session.expectReject({ ...command, gameSequence: before.gameSequence + 1 }, __GAME_UPPER___REASONS.phase);
    session.session.expectReject({ ...command, wasEnded: true }, __GAME_UPPER___REASONS.phase);
    const effectsBefore = session.effects.length;
    session.send(command);
    expect(session.state.phase).toEqual({ kind: 'lobby' });
    expect(session.state.roster).toEqual(before.roster);
    expect(session.state.config).toEqual(before.config);
    expect(session.state.gameSequence).toBe(before.gameSequence);
    expect(session.state.xpSettled).toBe(false);
    expect(session.effects).toHaveLength(effectsBefore);
    session.session.expectReject(command, __GAME_UPPER___REASONS.phase);
  });

  it('returns an ended game to preparation without another settlement', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    __GAME_TEST_BEGIN__
    const ended = __GAME_CAMEL__Engine.evolve(session.state, { type: '__GAME_ID__.game.ended' });
    const decision = __GAME_CAMEL__Engine.decide(
      ended,
      { type: '__GAME_ID__.game.restart', gameSequence: ended.gameSequence, wasEnded: true },
      session.session.context('host'),
    );
    expect(decision.kind).toBe('commit');
    if (decision.kind !== 'commit') throw new Error(decision.reason);
    expect(decision.effects).toEqual([]);
    const reset = decision.events.reduce(__GAME_CAMEL__Engine.evolve, ended);
    expect(reset.phase).toEqual({ kind: 'lobby' });
    expect(reset.roster).toEqual(ended.roster);
    expect(reset.config).toEqual(ended.config);
  });
});

//#cap businessStats
describe('__GAME_PASCAL__ completion statistics eligibility', () => {
  it('emits ordered v2 facts at the exact human threshold and never settles twice', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    __GAME_TEST_BEGIN__
    const decision = end__GAME_PASCAL__Game(session.state, session.session.context('host'));
    if (decision.kind !== 'commit') throw new Error(decision.reason);
    const effect = decision.effects.find((entry) => entry.type === '__GAME_ID__.game.completed');
    expect(effect?.payload).toMatchObject({
      completionVersion: 2,
      participantUserIds: ['host', 'u1', 'u2', 'u3'],
      stats: ['host', 'u1', 'u2', 'u3'].map((userId) => ({ userId, gamesPlayed: 1 })),
    });
    const ended = decision.events.reduce(__GAME_CAMEL__Engine.evolve, session.state);
    expect(end__GAME_PASCAL__Game(ended, session.session.context('host')).kind).toBe('reject');
  });

  it('does not settle a bot-filled game below the human threshold', () => {
    const session = game({ numberOfPlayers: 4 }, 3);
    __GAME_TEST_BEGIN__
    const decision = end__GAME_PASCAL__Game(session.state, session.session.context('host'));
    if (decision.kind !== 'commit') throw new Error(decision.reason);
    expect(decision.effects).toEqual([]);
    expect(decision.events.reduce(__GAME_CAMEL__Engine.evolve, session.state).phase.kind).toBe('ended');
  });

  it('does not settle a game that has not reached its terminal seam', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    expect(end__GAME_PASCAL__Game(session.state, session.session.context('host')).kind).toBe('reject');
    expect(session.effects.some((effect) => effect.type === '__GAME_ID__.game.completed')).toBe(false);
  });
});
