/** __GAME_PASCAL__ semantic invariants; invalid persisted or evolved states fail explicitly. */

import {
  assertStateIdentity,
  createStateInvariant,
  type StateInvariant,
} from '../../../platform/protocol/stateInvariant';
import { isBotOccupant } from '../../../platform/room/seating';
//#cap sharedSteps
import { __GAME_UPPER___NIGHT_STEP_IDS } from './types';
//#end
import {
  isValid__GAME_PASCAL__Config,
//#cap identityViewing
  is__GAME_PASCAL__OccupiedSeat,
//#end
  type __GAME_PASCAL__HumanSeat,
  type __GAME_PASCAL__State,
} from './types';

const invariant: StateInvariant = createStateInvariant('__GAME_PASCAL__');

/** Validates authoritative state without repairing or dropping submitted content. */
export function normalize__GAME_PASCAL__State(
  state: __GAME_PASCAL__State,
): __GAME_PASCAL__State {
  assertStateIdentity(state, '__GAME_ID__', '__GAME_PASCAL__');
  invariant(isValid__GAME_PASCAL__Config(state.config), 'configuration');
  const count = state.config.numberOfPlayers;
  const isSeat = (seat: number) => Number.isSafeInteger(seat) && seat >= 0 && seat < count;
  invariant(
    Number.isSafeInteger(state.phaseRevision) && state.phaseRevision >= 0,
    'phase revision',
  );
  invariant(Number.isSafeInteger(state.gameSequence) && state.gameSequence >= 0, 'game sequence');
//#cap sharedSteps
  if (state.phase.kind === 'night') {
    const { steps } = state.phase;
    invariant(
      steps.order.length === __GAME_UPPER___NIGHT_STEP_IDS.length &&
        steps.order.every((id, index) => id === __GAME_UPPER___NIGHT_STEP_IDS[index]),
      'night execution order',
    );
    invariant(steps.current === null || (
      __GAME_UPPER___NIGHT_STEP_IDS.some((id) => id === steps.current?.stepId) &&
      Number.isSafeInteger(steps.current.serial) && steps.current.serial > 0
    ), 'night position');
    invariant(steps.deadlineMs === null || (Number.isSafeInteger(steps.deadlineMs) && steps.deadlineMs >= 0), 'night deadline');
    invariant(Object.keys(steps.records).every((key) => __GAME_UPPER___NIGHT_STEP_IDS.some((id) => id === key)), 'night record ids');
    for (const id of __GAME_UPPER___NIGHT_STEP_IDS) {
      for (const [seat, record] of Object.entries(steps.records[id]?.bySeat ?? {})) {
        invariant(isSeat(Number(seat)) && state.roster[Number(seat)] !== undefined, 'night record seat');
        invariant(record !== undefined && record.result === null, 'night result');
      }
    }
  }
//#end
//#cap identityViewing
  invariant(
    new Set(state.reviewCompletedUserIds).size === state.reviewCompletedUserIds.length &&
      state.reviewCompletedUserIds.every((userId) => userId.trim().length > 0) &&
      (state.phase.kind === 'ended' || state.reviewCompletedUserIds.length === 0),
    'review completion',
  );
//#end
//#cap completion
  invariant(typeof state.xpSettled === 'boolean', 'xp settled flag');
//#end
  const entries = Object.entries(state.roster);
  invariant(
    entries.every(
      ([seat, occupant]) =>
        occupant != null &&
        isSeat(Number(seat)) &&
        occupant.seat === Number(seat) &&
        (isBotOccupant(occupant) || occupant.profile.displayName.trim().length > 0),
    ),
    'roster seats',
  );
//#cap !botsAndTakeover
  invariant(
    entries.every(([, occupant]) => occupant != null && !isBotOccupant(occupant)),
    'game without bots seats only humans',
  );
//#end
  const users = entries.filter(
    (entry): entry is [string, __GAME_PASCAL__HumanSeat] =>
      entry[1] != null && !isBotOccupant(entry[1]),
  );
  invariant(
    new Set(users.map(([, occupant]) => occupant.userId)).size === users.length,
    'duplicate user',
  );
//#cap identityViewing
  invariant(
    state.roleViewedSeats.every((seat) => isSeat(seat) && is__GAME_PASCAL__OccupiedSeat(state, seat)) &&
      new Set(state.roleViewedSeats).size === state.roleViewedSeats.length,
    'role viewed seats',
  );
  // 发牌后身份表必须恰好覆盖全部已占座位；大厅里必须为空。
  const identitySeats = Object.keys(state.identities).map(Number);
  if (state.phase.kind === 'lobby') {
    invariant(identitySeats.length === 0, 'lobby identities');
    invariant(state.roleViewedSeats.length === 0, 'lobby viewed seats');
  } else {
    invariant(
      identitySeats.every((seat) => isSeat(seat) && is__GAME_PASCAL__OccupiedSeat(state, seat)) &&
        identitySeats.length === entries.length,
      'dealt identities',
    );
  }
//#end
//#cap stageDeadline
  if (state.phase.kind === 'playing') {
    invariant(
      state.phase.deadlineAt === null ||
        (Number.isSafeInteger(state.phase.deadlineAt) && state.phase.deadlineAt >= 0),
      'stage deadline',
    );
  }
//#end
//#cap completion
  if (state.phase.kind === 'ended') invariant(state.xpSettled, 'ended settles exactly once');
//#end
  return state;
}
