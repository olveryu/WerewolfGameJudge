/** Applies __GAME_PASCAL__ domain events; reset paths clear all game-owned state. */

//#cap audioOrchestration
import { acknowledgeAudioQueue, queueAudioBatch } from '../../../platform/audio';
//#end
//#cap identityViewing
import { markSeatViewed } from '../../../platform/room/identityViewing';
//#end
import { applyRosterChanges } from '../../../platform/room/seating';
//#cap sharedSteps
import { evolveStepSlice } from '../../../platform/steps';
import { create__GAME_PASCAL__NightSlice } from './nightSteps';
//#end
import type { __GAME_PASCAL__State } from '../state/types';
import type { __GAME_PASCAL__Event } from './decision';

/** Resets mutable game data while preserving room configuration and seats. */
function reset__GAME_PASCAL__Game(state: __GAME_PASCAL__State): __GAME_PASCAL__State {
  return {
    ...state,
    phase: { kind: 'lobby' },
    phaseRevision: state.phaseRevision + 1,
//#cap identityViewing
    identities: {},
    roleViewedSeats: [],
    reviewCompletedUserIds: [],
//#end
//#cap completion
    xpSettled: false,
//#end
//#cap audioOrchestration
    pendingAudioEffects: [],
    isAudioPlaying: false,
//#end
  };
}

/** Evolves a committed domain event without persistence or broadcasts. */
export function evolve__GAME_PASCAL__State(
  state: __GAME_PASCAL__State,
  event: __GAME_PASCAL__Event,
): __GAME_PASCAL__State {
  const bumped = { ...state, phaseRevision: state.phaseRevision + 1 };
  switch (event.type) {
    case '__GAME_ID__.seats.changed':
      return { ...bumped, roster: applyRosterChanges(state.roster, event.changes) };
    case '__GAME_ID__.config.updated':
      return { ...bumped, config: event.config };
//#cap identityViewing
    case '__GAME_ID__.game.started':
      return {
        ...reset__GAME_PASCAL__Game(state),
        phaseRevision: state.phaseRevision + 1,
        // 发牌落入独立查看阶段；开始玩由房主在全员查看后手动 begin。
        phase: { kind: 'viewing' },
        // 发牌时无人落标记；房主逐个接管机器人确认，批量标记仅在可选能力开启时提供。
        roleViewedSeats: [],
        identities: { ...event.identities },
        gameSequence: event.gameSequence,
      };
//#end
//#cap stageDeadlineAtStart
    case '__GAME_ID__.game.started':
      return {
        ...reset__GAME_PASCAL__Game(state),
        phaseRevision: state.phaseRevision + 1,
//#cap sharedSteps
        phase: { kind: 'night', steps: create__GAME_PASCAL__NightSlice() },
//#end
//#cap !sharedSteps
        phase: { kind: 'playing', deadlineAt: event.deadlineAt },
//#end
        gameSequence: event.gameSequence,
      };
//#end
//#cap !identityViewing
//#cap !stageDeadline
    case '__GAME_ID__.game.started':
      return {
        ...reset__GAME_PASCAL__Game(state),
        phaseRevision: state.phaseRevision + 1,
//#cap sharedSteps
        phase: { kind: 'night', steps: create__GAME_PASCAL__NightSlice() },
//#end
//#cap !sharedSteps
        phase: { kind: 'playing' },
//#end
        gameSequence: event.gameSequence,
      };
//#end
//#end
//#cap identityViewing
//#cap !stageDeadline
    case '__GAME_ID__.game.begun': {
      if (state.phase.kind !== 'viewing') return state;
//#cap sharedSteps
      return { ...bumped, phase: { kind: 'night', steps: create__GAME_PASCAL__NightSlice() } };
//#end
//#cap !sharedSteps
      return { ...bumped, phase: { kind: 'playing' } };
//#end
    }
//#end
//#cap armDeadlineAtBegin
    case '__GAME_ID__.game.begun': {
      if (state.phase.kind !== 'viewing') return state;
//#cap sharedSteps
      return { ...bumped, phase: { kind: 'night', steps: create__GAME_PASCAL__NightSlice() } };
//#end
//#cap !sharedSteps
      return { ...bumped, phase: { kind: 'playing', deadlineAt: event.deadlineAt } };
//#end
    }
//#end
//#end
//#cap identityViewing
    case '__GAME_ID__.role.viewed': {
      if (state.roleViewedSeats.includes(event.seat)) return state;
      return { ...bumped, roleViewedSeats: markSeatViewed(state.roleViewedSeats, event.seat) };
    }
    case '__GAME_ID__.review.completed':
      return state.reviewCompletedUserIds.includes(event.userId)
        ? state
        : { ...bumped, reviewCompletedUserIds: [...state.reviewCompletedUserIds, event.userId] };
//#end
//#cap audioOrchestration
    case '__GAME_ID__.audio.queued': {
      // The shared machine owns the transition (replace + gate close + next batch id);
      // an empty batch cannot reach here — queueing fail-fasts in decide.
      return { ...bumped, ...queueAudioBatch(state, event.effects) };
    }
    case '__GAME_ID__.audio.cleared': {
      const ack = acknowledgeAudioQueue(state, event.audioBatchId);
      if (ack.kind !== 'cleared') return state;
      return { ...bumped, ...ack.slice };
    }
//#end
    // TODO(gameplay): 玩法事件在这里逐个落状态；阶段推进只许由事件驱动。
//#cap sharedSteps
    case '__GAME_ID__.night.step':
      if (state.phase.kind !== 'night') throw new Error('[FAIL-FAST] Night event outside night');
      return { ...bumped, phase: { kind: 'night', steps: evolveStepSlice(state.phase.steps, event.event) } };
    case '__GAME_ID__.night.finished':
      if (state.phase.kind !== 'night' || state.phase.steps.current !== null || state.isAudioPlaying) {
        throw new Error('[FAIL-FAST] Night finished before actions and narration completed');
      }
//#cap stageDeadline
      return { ...bumped, phase: { kind: 'playing', deadlineAt: event.deadlineAt } };
//#end
//#cap !stageDeadline
      return { ...bumped, phase: { kind: 'playing' } };
//#end
//#end
    case '__GAME_ID__.game.ended': {
      if (state.phase.kind === 'ended') return state;
//#cap completion
      return { ...bumped, phase: { kind: 'ended' }, xpSettled: true };
//#end
//#cap !completion
      return { ...bumped, phase: { kind: 'ended' } };
//#end
    }
    case '__GAME_ID__.game.returnedToLobby':
      return reset__GAME_PASCAL__Game(state);
  }
}
