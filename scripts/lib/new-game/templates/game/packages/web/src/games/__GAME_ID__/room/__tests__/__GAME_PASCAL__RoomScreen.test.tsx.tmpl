//#cap identityViewing
it.each(['lobby', 'viewing', 'playing', 'ended'] as const)(
  'preserves the role-game board in %s',
  (phase) => {
    const lobby = build__GAME_PASCAL__TestLobby();
    state =
      phase === 'lobby'
        ? lobby
        : phase === 'viewing'
          ? drive__GAME_PASCAL__TestCommand(lobby, { type: '__GAME_ID__.roles.assign' })
          : phase === 'playing'
            ? start__GAME_PASCAL__TestGame(lobby)
            : end__GAME_PASCAL__TestGame(start__GAME_PASCAL__TestGame(lobby));
    renderRoom();
    expect(screen.getByRole('region', { name: '房间内容' })).toHaveAttribute('data-kind', 'seats');
    if (phase === 'lobby' || phase === 'viewing') {
      expect(screen.getByRole('button', { name: '收起配置' })).toBeInTheDocument();
      expect(screen.queryByRole('button', { name: '本局配置' })).not.toBeInTheDocument();
    } else {
      expect(screen.getByRole('button', { name: '本局配置' })).toBeInTheDocument();
      expect(screen.queryByRole('button', { name: '收起配置' })).not.toBeInTheDocument();
    }
  },
);

it('previews public role information without recording an identity view', async () => {
  const user = userEvent.setup();
  state = start__GAME_PASCAL__TestGame(build__GAME_PASCAL__TestLobby());
  dispatch.mockClear();
  renderRoom();
  await user.click(screen.getByRole('button', { name: '本局配置' }));
  const configurationDialog = screen.getByRole('dialog', { name: '本局配置' });
  const roleButton = screen.getByRole('button', { name: /^待定身份/ });
  await user.click(roleButton);
  expect(screen.getByRole('dialog', { name: '待定身份' })).toBeInTheDocument();
  expect(configurationDialog).toBeInTheDocument();
  await user.click(screen.getByRole('button', { name: '知道了' }));
  expect(screen.getByRole('dialog', { name: '本局配置' })).toBe(configurationDialog);
  await waitFor(() => expect(roleButton).toHaveFocus());
  expect(dispatch).not.toHaveBeenCalled();
});
//#end

it('opens the same guide in the room without navigating', async () => {
  const user = userEvent.setup();
  state = build__GAME_PASCAL__TestLobby();
  renderRoom();
  await user.click(screen.getByRole('button', { name: '玩法' }));
  expect(screen.getByRole('dialog', { name: '__GAME_DISPLAY_NAME__玩法' })).toBeInTheDocument();
  expect(screen.getByText('坐满开局')).toBeInTheDocument();
  await user.click(screen.getByRole('button', { name: '关闭详情' }));
  expect(screen.queryByRole('dialog')).not.toBeInTheDocument();
});

//#cap !identityViewing
it('offers the stage menu while playing and the bottom configuration after ending', async () => {
  const user = userEvent.setup();
  const lobby = build__GAME_PASCAL__TestLobby();
  state = start__GAME_PASCAL__TestGame(lobby);
  const view = renderRoom();
  await user.click(screen.getByRole('button', { name: '舞台配置' }));
  expect(screen.getByRole('dialog', { name: '本局配置' })).toHaveTextContent('__GAME_DISPLAY_NAME__');
  expect(screen.getByText('TODO(gameplay):玩法阶段界面随玩法状态机落地。')).toBeInTheDocument();
  await user.click(screen.getByRole('button', { name: '关闭详情' }));
  await user.click(screen.getByRole('button', { name: '舞台玩法' }));
  expect(screen.getByRole('dialog', { name: '__GAME_DISPLAY_NAME__玩法' })).toBeInTheDocument();
  state = end__GAME_PASCAL__TestGame(state);
  view.unmount();
  renderRoom();
  expect(screen.queryByRole('button', { name: '舞台玩法' })).not.toBeInTheDocument();
  expect(screen.getByRole('button', { name: '本局配置' })).toBeInTheDocument();
});
//#end

//#cap identityViewing
it('shows assigned bot identities to the room host only', () => {
  const lobby = build__GAME_PASCAL__TestLobby();
  const createSeatSource = (currentState: __GAME_PASCAL__State, userId: string) =>
    create__GAME_PASCAL__SeatDataSource({
      state: currentState,
      revision: 1,
      userId,
      controlledSeat: null,
    });
  expect(createSeatSource(lobby, 'host').getSeat(2).secondaryLabel).toBeNull();

  const viewing = drive__GAME_PASCAL__TestCommand(lobby, {
    type: '__GAME_ID__.roles.assign',
  });
  const identity = viewing.identities[2];
  if (identity === undefined) throw new Error('Missing assigned bot identity');
  expect(createSeatSource(viewing, 'host').getSeat(2).secondaryLabel).toBe(
    toRevealRoleData(identity).name,
  );
  expect(createSeatSource(viewing, 'host').getSeat(0).secondaryLabel).toBeNull();
  expect(createSeatSource(viewing, 'u1').getSeat(2).secondaryLabel).toBeNull();
  expect(createSeatSource(viewing, 'spectator').getSeat(2).secondaryLabel).toBeNull();
});
//#end
