import type { __GAME_PASCAL__Command, __GAME_PASCAL__State } from '@game-judge/game-engine/games/__GAME_ID__/public';
import { createRoomSnapshot } from '@game-judge/game-engine/platform/protocol/roomSnapshot';
import { act, renderHook, waitFor } from '@testing-library/react';

import type { AudioClip } from '@/features/product/model/AudioClip';
import { build__GAME_PASCAL__TestLobby } from '@/test-utils/__GAME_ID__State';
import { createFakeBgm } from '@/test-utils/fakeBgm';
import { createFakeRoomLink, readyLinkSnapshot, testIdentity } from '@/test-utils/linkSnapshot';
import { successfulRoomCommand } from '@/test-utils/roomCommand';
import * as errors from '@/utils/errorPipeline';

import { use__GAME_PASCAL__AudioOrchestration } from '../../room/hooks/use__GAME_PASCAL__AudioOrchestration';
import * as registry from '../__GAME_CAMEL__AudioRegistry';
import { __GAME_PASCAL__AudioPlayer, type __GAME_PASCAL__AudioRuntime } from '../__GAME_CAMEL__AudioRuntime';

afterEach(() => vi.restoreAllMocks());

it('plays and preloads bundled clips through the shared audio service', async () => {
  const clip: AudioClip = { key: 'test-cue', url: '/test-cue.mp3' };
  vi.spyOn(registry, 'resolve__GAME_PASCAL__Audio').mockReturnValue(clip);
  vi.spyOn(registry, 'get__GAME_PASCAL__PreloadAudio').mockReturnValue([clip]);
  const service = {
    playClip: vi.fn(async () => undefined),
    preloadClips: vi.fn(),
    stop: vi.fn(),
    ...createFakeBgm(),
    setBgmVolume: vi.fn(),
    setGameAudioVolume: vi.fn(),
  };
  const player = new __GAME_PASCAL__AudioPlayer(service);
  player.preload();
  await player.playEffect({ audioKey: 'test-cue' });
  expect(service.preloadClips).toHaveBeenCalledWith([clip]);
  expect(service.playClip).toHaveBeenCalledWith(clip);
});

it('rejects unknown engine cues instead of skipping missing audio', () => {
  expect(() => registry.resolve__GAME_PASCAL__Audio('unregistered-cue')).toThrow(/Missing/);
});

it('retains the failed batch and retries every pending cue before acknowledging', async () => {
  const state = {
    ...build__GAME_PASCAL__TestLobby(),
    pendingAudioEffects: [{ audioKey: 'test-cue' }, { audioKey: 'closing-test-cue' }],
    audioBatchId: 1,
    isAudioPlaying: true,
  };
  const session = createFakeRoomLink<__GAME_PASCAL__State, __GAME_PASCAL__Command>(
    readyLinkSnapshot(testIdentity('__GAME_ID__'), createRoomSnapshot(state, 1)),
    async () => successfulRoomCommand(
      { ...state, pendingAudioEffects: [], isAudioPlaying: false }, 'audio-ack', 2,
    ),
  );
  const failure = new Error('media output unavailable');
  const audio: __GAME_PASCAL__AudioRuntime = {
    playEffect: vi.fn(async () => { throw failure; }),
    preload: vi.fn(),
    stopNarration: vi.fn(),
    ...createFakeBgm(),
    setBgmVolume: vi.fn(),
    setGameAudioVolume: vi.fn(),
  };
  const handleError = vi.spyOn(errors, 'handleError').mockImplementation(() => undefined);
  const { result } = renderHook(() => use__GAME_PASCAL__AudioOrchestration({ session, isHost: true, audio }));
  expect(result.current.isResumeRequired).toBe(true);
  expect(audio.playEffect).not.toHaveBeenCalled();
  await act(async () => { await result.current.resumeAfterRejoin(); });
  await waitFor(() => expect(handleError).toHaveBeenCalledWith(failure, expect.objectContaining({ feedback: 'toast' })));
  expect(result.current.isResumeRequired).toBe(true);
  expect(session.dispatch).not.toHaveBeenCalled();
  vi.mocked(audio.playEffect).mockClear().mockResolvedValue(undefined);
  await act(async () => { await result.current.resumeAfterRejoin(); });
  expect(vi.mocked(audio.playEffect).mock.calls.map(([effect]) => effect.audioKey)).toEqual([
    'test-cue', 'closing-test-cue',
  ]);
  expect(session.dispatch).toHaveBeenCalledExactlyOnceWith(
    { type: '__GAME_ID__.audio.ack', audioBatchId: 1 },
    { controlledSeat: null, label: '播报确认', durable: true },
  );
  expect(result.current.isResumeRequired).toBe(false);
});
