type CommandContext = Parameters<typeof __GAME_CAMEL__Engine.decide>[2];

function drive(
  state: __GAME_PASCAL__State,
  command: __GAME_PASCAL__Command,
  options: {
    userId?: string;
    nowMs?: number;
    system?: boolean;
    controlledSeat?: number | null;
  } = {},
): __GAME_PASCAL__State {
  const context: CommandContext =
    options.system === true
      ? {
          actor: { kind: 'system', effectId: 'settle-effect' },
          controlledSeat: null,
          nowMs: options.nowMs ?? 1000,
          commandId: command.type,
          randomSeed: 'seed',
        }
      : {
          actor: { kind: 'user', userId: options.userId ?? 'host' },
          controlledSeat: options.controlledSeat ?? null,
          nowMs: options.nowMs ?? 1000,
          commandId: command.type,
          randomSeed: 'seed',
        };
  const decision = __GAME_CAMEL__Engine.decide(state, command, context);
  if (decision.kind === 'reject') throw new Error(`rejected: ${decision.reason}`);
  return decision.events.reduce(__GAME_CAMEL__Engine.evolve, state);
}

function lobbyState(fillBots = true): __GAME_PASCAL__State {
  let state = __GAME_CAMEL__Engine.createInitialState(
    { ...DEFAULT___GAME_UPPER___CONFIG, numberOfPlayers: 4 },
    { roomCode: '1234', hostUserId: 'host', nowMs: 1000, commandId: 'create' },
  );
  state = drive(state, { type: 'room.seat.take', seat: 0, profile: { displayName: '房主' } });
  state = drive(
    state,
    { type: 'room.seat.take', seat: 1, profile: { displayName: 'P1' } },
    {
      userId: 'u1',
    },
  );
  if (fillBots) state = drive(state, { type: 'room.seat.fillBots' });
  return state;
}
//#cap identityViewing

function viewingState(): __GAME_PASCAL__State {
  const state = drive(lobbyState(), { type: '__GAME_ID__.roles.assign' });
  if (state.phase.kind !== 'viewing') throw new Error('expected viewing');
  return state;
}
//#end

function playingState(): __GAME_PASCAL__State {
//#cap identityViewing
  let state = viewingState();
  state = drive(state, { type: '__GAME_ID__.role.viewed' });
  state = drive(state, { type: '__GAME_ID__.role.viewed' }, { userId: 'u1' });
//#cap botBulkViewing
  state = drive(state, { type: '__GAME_ID__.bots.markAllBotsViewed' });
//#end
//#cap !botBulkViewing
  state = drive(state, { type: '__GAME_ID__.role.viewed' }, { controlledSeat: 2 });
  state = drive(state, { type: '__GAME_ID__.role.viewed' }, { controlledSeat: 3 });
//#end
  state = drive(state, { type: '__GAME_ID__.game.begin' });
//#end
//#cap !identityViewing
  const state = drive(lobbyState(), { type: '__GAME_ID__.game.begin' });
//#end
  if (state.phase.kind !== 'playing') throw new Error('expected playing');
  return state;
}

function stateFor(phase: __GAME_PASCAL__PhaseKind): __GAME_PASCAL__State {
  switch (phase) {
    case 'lobby':
      return lobbyState();
//#cap identityViewing
    case 'viewing':
      return viewingState();
//#end
    case 'playing':
      return playingState();
    case 'ended': {
//#cap stageDeadline
      const state = drive(
        playingState(),
        { type: '__GAME_ID__.phase.settleExpired' },
        { system: true, nowMs: 1000 + __GAME_UPPER___STAGE_DURATION_MS },
      );
//#end
//#cap !stageDeadline
      const playing = playingState();
      const decision = end__GAME_PASCAL__Game(playing, {
        actor: { kind: 'user', userId: 'host' },
        controlledSeat: null,
        nowMs: 1000,
        commandId: 'end-game',
        randomSeed: 'seed',
      });
      if (decision.kind === 'reject') throw new Error(`rejected: ${decision.reason}`);
      const state = decision.events.reduce(__GAME_CAMEL__Engine.evolve, playing);
//#end
      if (state.phase.kind !== 'ended') throw new Error('expected ended');
      return state;
    }
  }
}

function capabilities(isSetup = true, isRoomFull = true): RoomCapabilities {
  return {
    ...createRoomSetupCapabilities({
      isSetup,
      isHost: true,
      mySeat: 0,
      supportsBots: true,
      hasOccupiedSeats: true,
      isRoomFull,
      requestTakeSeat: vi.fn(),
      requestMoveSeat: vi.fn(),
      leaveSeat: vi.fn(),
      kickSeat: vi.fn(),
      clearSeats: vi.fn(),
      fillBots: vi.fn(),
      configureGame: vi.fn(),
      shareRoom: vi.fn(),
    }),
    canViewProfiles: { isAllowed: true, execute: vi.fn() },
    canTakeOverBots: createBotTakeoverCapability(true, vi.fn()),
  };
}

describe('__GAME_PASCAL__ host controls', () => {
  const submit = vi.fn(async () => true);
  function hostModel(
    state: __GAME_PASCAL__State,
    isSubmitting = false,
    roomCapabilities = capabilities(
      state.phase.kind === 'lobby',
      get__GAME_PASCAL__OccupiedSeatCount(state) === state.config.numberOfPlayers,
    ),
  ) {
    return create__GAME_PASCAL__HostManagement({
      state, submit, capabilities: roomCapabilities, isSubmitting,
      review: state.phase.kind === 'ended' ? {
        isEnabled: true,
        onPress: vi.fn(),
//#cap identityViewing
        isPending: !state.reviewCompletedUserIds.includes('host'),
//#end
      } : null,
//#cap audioOrchestration
      onMusicSettings: vi.fn(),
//#end
    });
  }
  it.each(__GAME_UPPER___PHASES)('exposes only the expected host actions in %s', (phase) => {
    const actions = hostModel(stateFor(phase)).actions;
    const actualKeys = actions.map((action) => action.key).sort();
    const expectedKeys: string[] = [];
    if (phase === 'lobby') {
      expectedKeys.push(
//#cap identityViewing
        HOST_ACTION_KEYS.assignRoles,
//#end
//#cap !identityViewing
        HOST_ACTION_KEYS.startGame,
//#end
        HOST_ACTION_KEYS.configureGame,
        HOST_ACTION_KEYS.clearSeats,
      );
    }
//#cap identityViewing
    if (phase === 'viewing') {
      expectedKeys.push(HOST_ACTION_KEYS.startGame);
//#cap botBulkViewing
      expectedKeys.push(HOST_ACTION_KEYS.markBotsViewed);
//#end
    }
//#end
    if (phase === 'playing') expectedKeys.push(HOST_ACTION_KEYS.restart);
//#cap identityViewing
    if (phase === 'viewing') expectedKeys.push(HOST_ACTION_KEYS.restart);
//#end
    if (phase === 'ended') {
      expectedKeys.push(
        HOST_ACTION_KEYS.review,
        HOST_ACTION_KEYS.restart,
      );
    }
//#cap audioOrchestration
    if (phase !== 'playing' && phase !== 'ended') expectedKeys.push('music-settings');
//#end
    expect(actualKeys).toEqual(expectedKeys.sort());
  });

  it('marks the lobby host task as pending even when seats are missing', () => {
    expect(hostModel(lobbyState(false)).pendingActionKeys).toEqual([
//#cap identityViewing
      HOST_ACTION_KEYS.assignRoles,
//#end
//#cap !identityViewing
      HOST_ACTION_KEYS.startGame,
//#end
    ]);
  });

//#cap identityViewing
  it('enables begin only after every human and bot identity has been viewed', () => {
    let state = viewingState();
    const getBeginAction = () =>
      hostModel(state).actions
        .find((entry) => entry.key === HOST_ACTION_KEYS.startGame);
    expect(getBeginAction()?.state.kind).toBe('blocked');

    state = drive(state, { type: '__GAME_ID__.role.viewed' });
    state = drive(state, { type: '__GAME_ID__.role.viewed' }, { userId: 'u1' });
//#cap botBulkViewing
    state = drive(state, { type: '__GAME_ID__.bots.markAllBotsViewed' });
//#end
//#cap !botBulkViewing
    state = drive(state, { type: '__GAME_ID__.role.viewed' }, { controlledSeat: 2 });
    state = drive(state, { type: '__GAME_ID__.role.viewed' }, { controlledSeat: 3 });
//#end
    expect(getBeginAction()?.state.kind).toBe('ready');
  });

  it('marks start pending only after the host has viewed their own identity', () => {
    const viewing = viewingState();
    expect(hostModel(viewing).pendingActionKeys).toEqual([]);
    const hostViewed = drive(viewing, { type: '__GAME_ID__.role.viewed' });
    expect(hostModel(hostViewed).pendingActionKeys).toEqual([HOST_ACTION_KEYS.startGame]);
    const begin = hostModel(hostViewed).actions
      .find((action) => action.key === HOST_ACTION_KEYS.startGame);
    expect(begin?.state.kind).toBe('blocked');

    let unseated = drive(lobbyState(false), { type: 'room.seat.leave' });
    unseated = drive(unseated, { type: 'room.seat.fillBots' });
    unseated = drive(unseated, { type: '__GAME_ID__.roles.assign' });
    expect(hostModel(unseated).pendingActionKeys).toEqual([HOST_ACTION_KEYS.startGame]);
  });
//#end

  it('offers fill-bots only for an open lobby and runs each setup action through its capability', () => {
    const roomCapabilities = capabilities(true, false);
    const actions = hostModel(lobbyState(false), false, roomCapabilities).actions;
    for (const [actionKey, capability] of [
      [HOST_ACTION_KEYS.configureGame, roomCapabilities.canConfigureGame],
      [HOST_ACTION_KEYS.fillBots, roomCapabilities.canFillBots],
      [HOST_ACTION_KEYS.clearSeats, roomCapabilities.canClearSeats],
    ] as const) {
      const action = actions.find((entry) => entry.key === actionKey);
      if (action?.state.kind !== 'ready' || !capability.isAllowed)
        throw new Error(`Missing enabled setup action: ${actionKey}`);
      action.state.onPress();
      expect(capability.execute).toHaveBeenCalledOnce();
    }
    expect(actions.map((action) => action.key)).toContain(HOST_ACTION_KEYS.fillBots);
  });

//#cap identityViewing
  it('dispatches the role assignment only after host confirmation', async () => {
    submit.mockClear();
    const action = hostModel(lobbyState()).actions
      .find((entry) => entry.key === HOST_ACTION_KEYS.assignRoles);
    if (action?.state.kind !== 'ready') throw new Error('Missing enabled role assignment');
    action.state.onPress();
    expect(submit).not.toHaveBeenCalled();
    const confirm = vi.mocked(showConfirmAlert).mock.calls.at(-1)?.[2];
    if (confirm === undefined) throw new Error('Missing role assignment confirmation');
    await confirm();
    expect(submit).toHaveBeenCalledWith('分配角色', { type: '__GAME_ID__.roles.assign' });
  });
//#end
//#cap !identityViewing
  it('dispatches game start only after host confirmation', async () => {
    submit.mockClear();
    const action = hostModel(lobbyState()).actions
      .find((entry) => entry.key === HOST_ACTION_KEYS.startGame);
    if (action?.state.kind !== 'ready') throw new Error('Missing enabled game start');
    action.state.onPress();
    expect(submit).not.toHaveBeenCalled();
    const confirm = vi.mocked(showConfirmAlert).mock.calls.at(-1)?.[2];
    if (confirm === undefined) throw new Error('Missing game start confirmation');
    await confirm();
    expect(submit).toHaveBeenCalledWith('开始游戏', { type: '__GAME_ID__.game.begin' });
  });
//#end

  it('confirms terminal restart before dispatch', async () => {
    submit.mockClear();
    const state = stateFor('ended');
    const action = hostModel(state).actions
      .find((entry) => entry.key === HOST_ACTION_KEYS.restart);
    if (action?.state.kind !== 'ready') throw new Error('Missing enabled terminal restart');
    action.state.onPress();
    expect(submit).not.toHaveBeenCalled();
    const confirm = vi.mocked(showDestructiveAlert).mock.calls.at(-1)?.[3];
    if (confirm === undefined) throw new Error('Missing restart confirmation');
    await confirm();
    expect(submit).toHaveBeenCalledWith('重新开始', {
      type: '__GAME_ID__.game.restart', gameSequence: state.gameSequence, wasEnded: true,
    });
  });

//#cap identityViewing
  it('marks terminal review pending without blocking confirmed restart', async () => {
    submit.mockClear();
    vi.mocked(showDestructiveAlert).mockClear();
    const state = stateFor('ended');
    const model = hostModel(state);
    expect(model.task).toEqual({
      kind: 'choice',
      actionKeys: [HOST_ACTION_KEYS.review, HOST_ACTION_KEYS.restart],
    });
    expect(model.pendingActionKeys).toEqual([HOST_ACTION_KEYS.review]);
    const restart = model.actions
      .find((entry) => entry.key === HOST_ACTION_KEYS.restart);
    if (restart?.state.kind !== 'ready') throw new Error('Missing enabled terminal restart');
    restart.state.onPress();
    expect(showDestructiveAlert).toHaveBeenCalledWith(
      '重新开始？', expect.stringContaining('尚未查看'), '重新开始', expect.any(Function),
    );
    expect(submit).not.toHaveBeenCalled();
    const confirm = vi.mocked(showDestructiveAlert).mock.calls.at(-1)?.[3];
    if (confirm === undefined) throw new Error('Missing restart confirmation');
    await confirm();
    expect(submit).toHaveBeenCalledWith('重新开始', {
      type: '__GAME_ID__.game.restart', gameSequence: state.gameSequence, wasEnded: true,
    });
    const reviewed = drive(state, { type: '__GAME_ID__.review.complete', gameSequence: state.gameSequence });
    expect(hostModel(reviewed).pendingActionKeys).toEqual([]);
  });

//#end
  it('disables the lobby transition while a host command is submitting', () => {
    const key =
//#cap identityViewing
      HOST_ACTION_KEYS.assignRoles;
//#end
//#cap !identityViewing
      HOST_ACTION_KEYS.startGame;
//#end
    const action = hostModel(lobbyState(), true).actions
      .find((entry) => entry.key === key);
    expect(action?.state.kind).toBe('busy');
  });

  it('submits in-game restart only after confirmation', async () => {
    submit.mockClear();
    const state = playingState();
    const action = hostModel(state).actions.find((entry) => entry.key === HOST_ACTION_KEYS.restart);
    if (action?.state.kind !== 'ready') throw new Error('Missing restart action');
    action.state.onPress();
    expect(submit).not.toHaveBeenCalled();
    const confirm = vi.mocked(showDestructiveAlert).mock.calls.at(-1)?.[3];
    if (confirm === undefined) throw new Error('Missing restart confirmation');
    await confirm();
    expect(submit).toHaveBeenCalledWith('重新开始', {
      type: '__GAME_ID__.game.restart', gameSequence: state.gameSequence, wasEnded: false,
    });
  });
//#cap botBulkViewing
  it('wires bulk viewing and removes it after all bots are marked', () => {
    const state = viewingState();
    const panel = hostModel(state);
    expect(panel.task).toMatchObject({ kind: 'action', actionKey: 'start-game' });
    const action = panel.actions.find((entry) => entry.key === 'mark-bots-viewed');
    if (action?.state.kind !== 'ready') throw new Error('Missing bot viewing action');
    action.state.onPress();
    expect(submit).toHaveBeenCalledWith('标记机器人已查看', { type: '__GAME_ID__.bots.markAllBotsViewed' });
    const marked = drive(state, { type: '__GAME_ID__.bots.markAllBotsViewed' });
    expect(hostModel(marked).actions.some((entry) => entry.key === 'mark-bots-viewed')).toBe(false);
  });
//#end
//#cap audioOrchestration
  it('keeps abort visible but inert while narration is playing', () => {
    const locked = applyAudioPlaybackLock(hostModel(playingState()), {
      isAudioPlaying: true, exemptActionKeys: new Set<string>(),
