/**
 * __GAME_PASCAL__ guidance matrix: every (phase × viewer) cell declared in
 * __GAME_CAMEL__GuidanceMatrix.ts is held true against create__GAME_PASCAL__RoomShellModel,
//#cap stageDeadline
 * with states produced by the real engine (the playing phase settles
 * through its deadline system command, as in the engine full-chain
 * test).
//#end
//#cap !stageDeadline
 * with states produced by the real engine (the game ends through the
 * engine's terminal seam).
//#end
 */
import {
  DEFAULT___GAME_UPPER___CONFIG,
//#cap !stageDeadline
  end__GAME_PASCAL__Game,
//#end
  __GAME_UPPER___PHASES,
//#cap stageDeadline
  __GAME_UPPER___STAGE_DURATION_MS,
//#end
  type __GAME_PASCAL__Command,
  __GAME_CAMEL__Engine,
  type __GAME_PASCAL__PhaseKind,
  type __GAME_PASCAL__State,
} from '@game-judge/game-engine/games/__GAME_ID__/public';

import type { RoomSeatController } from '@/features/room/controllers/useRoomSeatController';
import type { RoomCapabilities } from '@/features/room/model/RoomCapabilities';
import {
  createBotTakeoverCapability,
  createRoomSetupCapabilities,
} from '@/features/room/model/RoomCapabilities';
import type { RoomViewerAudience } from '@/features/room/model/RoomViewer';
import { viewerFor } from '@/test-utils/roomViewer';

import { __GAME_UPPER___GUIDANCE_MATRIX } from '../__GAME_CAMEL__GuidanceMatrix';
import { create__GAME_PASCAL__RoomShellModel } from '../__GAME_CAMEL__RoomAdapter';

type CommandContext = Parameters<typeof __GAME_CAMEL__Engine.decide>[2];

function drive(
  state: __GAME_PASCAL__State,
  command: __GAME_PASCAL__Command,
  options: { userId?: string; nowMs?: number; system?: boolean } = {},
): __GAME_PASCAL__State {
  const context: CommandContext =
    options.system === true
      ? {
          actor: { kind: 'system', effectId: 'settle-effect' },
          controlledSeat: null,
          nowMs: options.nowMs ?? 1000,
          commandId: command.type,
          randomSeed: 'seed',
        }
      : {
          actor: { kind: 'user', userId: options.userId ?? 'host' },
          controlledSeat: null,
          nowMs: options.nowMs ?? 1000,
          commandId: command.type,
          randomSeed: 'seed',
        };
  const decision = __GAME_CAMEL__Engine.decide(state, command, context);
  if (decision.kind === 'reject') throw new Error(`rejected: ${decision.reason}`);
  return decision.events.reduce(__GAME_CAMEL__Engine.evolve, state);
}

function lobbyState(): __GAME_PASCAL__State {
  let state = __GAME_CAMEL__Engine.createInitialState(
    { ...DEFAULT___GAME_UPPER___CONFIG, numberOfPlayers: 4 },
    { roomCode: '1234', hostUserId: 'host', nowMs: 1000, commandId: 'create' },
  );
  state = drive(state, { type: 'room.seat.take', seat: 0, profile: { displayName: '房主' } });
  state = drive(
    state,
    { type: 'room.seat.take', seat: 1, profile: { displayName: 'P1' } },
    {
      userId: 'u1',
    },
  );
  state = drive(state, { type: 'room.seat.fillBots' });
  return state;
}
//#cap identityViewing

function viewingState(): __GAME_PASCAL__State {
  const state = drive(lobbyState(), { type: '__GAME_ID__.roles.assign' });
  if (state.phase.kind !== 'viewing') throw new Error('expected viewing');
  return state;
}
//#end

function playingState(): __GAME_PASCAL__State {
//#cap identityViewing
  let state = viewingState();
  state = drive(state, { type: '__GAME_ID__.role.viewed' });
  state = drive(state, { type: '__GAME_ID__.role.viewed' }, { userId: 'u1' });
  state = drive(state, { type: '__GAME_ID__.bots.markAllBotsViewed' });
  state = drive(state, { type: '__GAME_ID__.game.begin' });
//#end
//#cap !identityViewing
  const state = drive(lobbyState(), { type: '__GAME_ID__.game.begin' });
//#end
  if (state.phase.kind !== 'playing') throw new Error('expected playing');
  return state;
}

function stateFor(phase: __GAME_PASCAL__PhaseKind): __GAME_PASCAL__State {
  switch (phase) {
    case 'lobby':
      return lobbyState();
//#cap identityViewing
    case 'viewing':
      return viewingState();
//#end
    case 'playing':
      return playingState();
    case 'ended': {
//#cap stageDeadline
      const state = drive(
        playingState(),
        { type: '__GAME_ID__.phase.settleExpired' },
        { system: true, nowMs: 1000 + __GAME_UPPER___STAGE_DURATION_MS },
      );
//#end
//#cap !stageDeadline
      const playing = playingState();
      const decision = end__GAME_PASCAL__Game(playing, {
        actor: { kind: 'user', userId: 'host' },
        controlledSeat: null,
        nowMs: 1000,
        commandId: 'end-game',
        randomSeed: 'seed',
      });
      if (decision.kind === 'reject') throw new Error(`rejected: ${decision.reason}`);
      const state = decision.events.reduce(__GAME_CAMEL__Engine.evolve, playing);
//#end
      if (state.phase.kind !== 'ended') throw new Error('expected ended');
      return state;
    }
  }
}

function capabilities(): RoomCapabilities {
  return {
    ...createRoomSetupCapabilities({
      isSetup: true,
      isHost: true,
      mySeat: 0,
      supportsBots: true,
      hasOccupiedSeats: true,
      isRoomFull: true,
      requestTakeSeat: vi.fn(),
      requestMoveSeat: vi.fn(),
      leaveSeat: vi.fn(),
      kickSeat: vi.fn(),
      clearSeats: vi.fn(),
      fillBots: vi.fn(),
      configureGame: vi.fn(),
      shareRoom: vi.fn(),
    }),
    canViewProfiles: { isAllowed: true, execute: vi.fn() },
    canTakeOverBots: createBotTakeoverCapability(true, vi.fn()),
  };
}

const seatController: RoomSeatController = {
  pendingAction: null,
  isSubmitting: false,
  requestTakeSeat: vi.fn(),
  requestMoveSeat: vi.fn(),
  confirm: vi.fn(async () => undefined),
  cancel: vi.fn(),
};

function bottomMessage(state: __GAME_PASCAL__State, audience: RoomViewerAudience): string | null {
  const viewer = viewerFor(audience);
  const model = create__GAME_PASCAL__RoomShellModel({
    roomCode: '1234',
    viewer,
    capabilities: capabilities(),
    onBack: vi.fn(),
    onTitlePress: vi.fn(),
    onTitleLongPress: vi.fn(),
    user: { id: viewer.userId, avatarUrl: null },
    gachaStatus: null,
    onUserActionPress: vi.fn(),
    connection: {
      status: { kind: 'live' },
      pendingDurableCount: 0,
      onRetryNow: vi.fn(),
    },
    state,
    revision: 5,
    controlledSeat: null,
    seatsVisuallyDisabled: false,
    onSeatPress: vi.fn(),
    onBotSeatLongPress: null,
    seatController,
    profileSelection: null,
//#cap businessStats
    gameDetails: null,
//#end
    onProfileClose: vi.fn(),
    onProfileLeaveSeat: vi.fn(),
    share: {
      isVisible: false,
      roomCode: '1234',
      roomUrl: 'https://example.test/1234',
      open: vi.fn(),
      close: vi.fn(),
      copyLink: vi.fn(async () => undefined),
      shareImage: vi.fn(async () => undefined),
    },
    isLobby: state.phase.kind === 'lobby',
    buildHostManagement: () => ({ task: null, sections: [] }),
    releaseBot: vi.fn(),
    review: state.phase.kind === 'ended' ? { isEnabled: true, onPress: vi.fn() } : null,
  });
  return model.bottomActions.message;
}

describe('__GAME_UPPER___GUIDANCE_MATRIX', () => {
  it('covers exactly the engine phase list, each exempt cell with a reason', () => {
    expect(Object.keys(__GAME_UPPER___GUIDANCE_MATRIX).sort()).toEqual([...__GAME_UPPER___PHASES].sort());
    for (const row of Object.values(__GAME_UPPER___GUIDANCE_MATRIX)) {
      for (const cell of Object.values(row)) {
        if (cell.kind === 'exempt') expect(cell.reason.length).toBeGreaterThan(0);
      }
    }
  });

  it.each(__GAME_UPPER___PHASES)('holds every viewer cell in phase %s', (phase) => {
    const state = stateFor(phase);
    for (const viewer of ['host', 'seated', 'spectator'] as const) {
      const cell = __GAME_UPPER___GUIDANCE_MATRIX[phase][viewer];
      const message = bottomMessage(state, viewer);
      if (cell.kind === 'message') {
        if (typeof message !== 'string' || message === '') {
          throw new Error(
            `${phase} x ${viewer}: declared a message cell, got ${JSON.stringify(message)}`,
          );
        }
      } else if (message !== null) {
        throw new Error(
          `${phase} x ${viewer}: declared exempt (${cell.reason}), got ${JSON.stringify(message)}`,
        );
      }
    }
  });
});
