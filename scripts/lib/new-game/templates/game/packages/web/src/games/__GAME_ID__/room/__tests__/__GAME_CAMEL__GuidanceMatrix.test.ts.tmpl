//#cap identityViewing
function renderRoomState(state: __GAME_PASCAL__State, userId = 'host', rejectCompletion = false) {
  testAuth.userId = userId;
  const identity = testIdentity('__GAME_ID__', { userId });
  const session = createFakeRoomLink<__GAME_PASCAL__State, __GAME_PASCAL__Command>(
    readyLinkSnapshot(identity, createRoomSnapshot(state, 1)),
    async () => rejectCompletion
      ? rejectedRoomCommand(REASON_REVIEW_IDENTITY_MISMATCH)
      : successfulRoomCommand(state),
  );
  const review: RoomReviewContribution<__GAME_PASCAL__State> = {
    resolve: (input) => {
      const availability = __GAME_CAMEL__Review.resolve(input);
      return availability.kind === 'available'
        ? { ...availability, sharing: { isAllowed: false, reason: '测试期间不分享' } }
        : availability;
    },
  };
  const props = {
    session,
    review,
    room: identity.room,
    entryReason: null,
    onOpenMusicSettings: vi.fn(),
    onOpenRoomSettings: vi.fn(),
    onOpenUserSettings: vi.fn(),
    entryController: {
      requestExit: vi.fn(),
      connection: { status: { kind: 'live' }, pendingDurableCount: 0, onRetryNow: vi.fn() },
    },
//#cap audioOrchestration
    audio: {
      preload: vi.fn(async () => undefined),
      playEffect: vi.fn(async () => undefined),
      stopNarration: vi.fn(),
      ...createFakeBgm(),
      setBgmVolume: vi.fn(),
      setGameAudioVolume: vi.fn(),
    },
//#end
  } as unknown as Parameters<typeof use__GAME_PASCAL__RoomState>[0];
  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
  const hook = renderHook(() => use__GAME_PASCAL__RoomState(props), {
    wrapper: ({ children }: { readonly children: ReactNode }) =>
      createElement(QueryClientProvider, { client: queryClient }, createElement(MemoryRouter, null, children)),
  });
  return { session, ...hook };
}

function reviewAction(room: ReturnType<typeof use__GAME_PASCAL__RoomState>) {
  if (room.isHost) {
    const model = room.shellModel.hostManagement;
    const action = model?.actions
      .find((entry) => entry.key === HOST_ACTION_KEYS.review);
    return action === undefined
      ? null
      : { action, isPending: model?.pendingActionKeys?.includes(HOST_ACTION_KEYS.review) ?? false };
  }
  const action = room.shellModel.playerActions.actions
    .find((entry) => entry.key === HOST_ACTION_KEYS.review);
  return action === undefined
    ? null
    : { action, isPending: action.isPending === true };
}

describe('__GAME_PASCAL__ identity action', () => {
  it('opens the actual role-viewing flow and confirms for the controlled bot seat', async () => {
    const state = viewingState();
    const { session, result } = renderRoomState(state);
    act(() => result.current.shellModel.seats.onBotSeatLongPress?.(2));
    const buttons = result.current.shellModel.playerActions.actions;
    const button = buttons.find((entry) => entry.key === 'view-identity');
    if (button?.state.kind !== 'ready') throw new Error('missing identity action');
    const openIdentity = button.state.onPress;
    vi.mocked(showConfirmAlert).mockClear();
    act(() => openIdentity());
    const confirm = vi.mocked(showConfirmAlert).mock.calls.at(-1)?.[2];
    if (confirm === undefined) throw new Error('missing identity confirmation');
    act(() => { void confirm(); });
    expect(result.current.roleViewing.isOpen).toBe(true);
    expect(session.dispatch).not.toHaveBeenCalled();
    await act(async () => result.current.roleViewing.close());
    expect(session.dispatch).toHaveBeenCalledWith(
      { type: '__GAME_ID__.role.viewed' },
      expect.objectContaining({ controlledSeat: 2 }),
    );
  });

  it('is pending and opens the identity card for a seated player in viewing', () => {
    const onViewRolePress = vi.fn();
    const model = shellModel(viewingState(), 'seated', undefined, { onViewRolePress });
    const button = model.playerActions.actions.find((action) => action.key === 'view-identity');
    expect(button).toMatchObject({ label: '查看身份', audience: 'participant', isPending: true, state: { kind: 'ready' } });
    if (button?.state.kind !== 'ready') throw new Error('missing identity action');
    button.state.onPress();
    expect(onViewRolePress).toHaveBeenCalledOnce();
  });

  it('tracks the effective seat, including a bot controlled by the host', () => {
    const viewed = drive(viewingState(), { type: '__GAME_ID__.role.viewed' }, { userId: 'u1' });
    const playerButtons = shellModel(viewed, 'seated').playerActions.actions;
    expect(playerButtons.find((button) => button.key === 'view-identity')).toMatchObject({ isPending: false });

    const hostViewed = drive(viewed, { type: '__GAME_ID__.role.viewed' });
    const botModel = shellModel(hostViewed, 'host', undefined, { controlledSeat: 2 });
    expect(botModel.playerActions.actions.find((button) => button.key === 'view-identity'))
      .toMatchObject({ isPending: true });
    const botViewed = drive(hostViewed, { type: '__GAME_ID__.role.viewed' }, { controlledSeat: 2 });
    const viewedBotModel = shellModel(botViewed, 'host', undefined, { controlledSeat: 2 });
    expect(viewedBotModel.playerActions.actions.find((button) => button.key === 'view-identity'))
      .toMatchObject({ isPending: false });
  });

  it('hides identity in the lobby and from spectators, and locks it while submitting', () => {
    expect(shellModel(lobbyState(), 'seated').playerActions.actions).toEqual([]);
    expect(shellModel(viewingState(), 'spectator').playerActions.actions).toEqual([]);
    const locked = shellModel(viewingState(), 'seated', undefined, { isSubmitting: true });
    const button = locked.playerActions.actions.find((entry) => entry.key === 'view-identity');
    expect(button?.state.kind).toBe('blocked');
    expect(button?.state).not.toHaveProperty('onPress');
  });

  it.each(['playing', 'ended'] as const)('keeps identity available in %s', (phase) => {
    const model = shellModel(stateFor(phase), 'seated');
    expect(model.playerActions.actions.find((action) => action.key === 'view-identity'))
      .toMatchObject({ state: { kind: 'ready' } });
  });
});

describe('__GAME_PASCAL__ terminal review action', () => {
  it.each([
    ['host', true],
    ['u1', true],
    ['spectator', false],
  ] as const)('marks and completes review for %s only when eligible', async (userId, pending) => {
    const state = stateFor('ended');
    const { session, result } = renderRoomState(state, userId);
    if (userId === 'host') act(() => result.current.shellModel.seats.onBotSeatLongPress?.(2));
    const entry = reviewAction(result.current);
    expect(entry?.isPending ?? false).toBe(pending);
    if (entry === null || entry.action.state.kind !== 'ready') throw new Error('Missing enabled review');
    const openReview = entry.action.state.onPress;
    act(() => openReview());
    render(result.current.reviewOverlay);
    fireEvent.click(screen.getByLabelText('关闭详情'));
    if (!pending) {
      expect(session.dispatch).not.toHaveBeenCalled();
      return;
    }
    await waitFor(() => expect(session.dispatch).toHaveBeenCalledWith(
      { type: '__GAME_ID__.review.complete', gameSequence: state.gameSequence },
      expect.objectContaining({ controlledSeat: null }),
    ));
    await waitFor(() => expect(result.current.isSubmitting).toBe(false));
    const completed = drive(
      state, { type: '__GAME_ID__.review.complete', gameSequence: state.gameSequence }, { userId },
    );
    act(() => session.publishRoom(createRoomSnapshot(completed, 2)));
    expect(reviewAction(result.current)?.isPending ?? false).toBe(false);
  });

  it('keeps the review pending and reports a rejected completion', async () => {
    vi.mocked(showErrorAlert).mockClear();
    const state = stateFor('ended');
    const { session, result } = renderRoomState(state, 'u1', true);
    const entry = reviewAction(result.current);
    if (entry === null || entry.action.state.kind !== 'ready') throw new Error('Missing enabled review');
    const openReview = entry.action.state.onPress;
    act(() => openReview());
    render(result.current.reviewOverlay);
    fireEvent.click(screen.getByLabelText('关闭详情'));
    await waitFor(() => expect(showErrorAlert).toHaveBeenCalledOnce());
    expect(session.dispatch).toHaveBeenCalledOnce();
    expect(reviewAction(result.current)?.isPending).toBe(true);
  });
});
//#end

describe('__GAME_UPPER___GUIDANCE_MATRIX', () => {
  it('builds host controls only for the host viewer', () => {
    const buildHostManagement = vi.fn(() => ({ task: null, actions: [] }));
    bottomMessage(lobbyState(), 'seated', buildHostManagement);
    bottomMessage(lobbyState(), 'spectator', buildHostManagement);
    expect(buildHostManagement).not.toHaveBeenCalled();

    bottomMessage(lobbyState(), 'host', buildHostManagement);
    expect(buildHostManagement).toHaveBeenCalledOnce();
  });

  it('covers exactly the engine phase list, each exempt cell with a reason', () => {
    expect(Object.keys(__GAME_UPPER___GUIDANCE_MATRIX).sort()).toEqual([...__GAME_UPPER___PHASES].sort());
    for (const row of Object.values(__GAME_UPPER___GUIDANCE_MATRIX)) {
      for (const cell of Object.values(row)) {
        if (cell.kind === 'exempt') expect(cell.reason.length).toBeGreaterThan(0);
      }
    }
  });

  it.each(__GAME_UPPER___PHASES)('holds every viewer cell in phase %s', (phase) => {
    const state = stateFor(phase);
    for (const viewer of ['host', 'seated', 'spectator'] as const) {
      const cell = __GAME_UPPER___GUIDANCE_MATRIX[phase][viewer];
      const message = bottomMessage(state, viewer);
      if (cell.kind === 'message') {
        if (typeof message !== 'string' || message === '') {
          throw new Error(
            `${phase} x ${viewer}: declared a message cell, got ${JSON.stringify(message)}`,
          );
        }
      } else if (message !== null) {
        throw new Error(
          `${phase} x ${viewer}: declared exempt (${cell.reason}), got ${JSON.stringify(message)}`,
        );
      }
    }
  });
});
