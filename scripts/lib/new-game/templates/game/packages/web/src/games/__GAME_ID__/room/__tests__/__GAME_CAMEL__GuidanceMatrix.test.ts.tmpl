/**
 * __GAME_PASCAL__ guidance matrix: every (phase × viewer) cell declared in
 * __GAME_CAMEL__GuidanceMatrix.ts is held true against create__GAME_PASCAL__RoomShellModel,
//#cap stageDeadline
 * with states produced by the real engine (the playing phase settles
 * through its deadline system command, as in the engine full-chain
 * test).
//#end
//#cap !stageDeadline
 * with states produced by the real engine (the game ends through the
 * engine's terminal seam).
//#end
 */
import {
  DEFAULT___GAME_UPPER___CONFIG,
  get__GAME_PASCAL__OccupiedSeatCount,
//#cap !stageDeadline
  end__GAME_PASCAL__Game,
//#end
  __GAME_UPPER___PHASES,
//#cap stageDeadline
  __GAME_UPPER___STAGE_DURATION_MS,
//#end
  type __GAME_PASCAL__Command,
  __GAME_CAMEL__Engine,
  type __GAME_PASCAL__PhaseKind,
  type __GAME_PASCAL__State,
} from '@game-judge/game-engine/games/__GAME_ID__/public';

import type { RoomSeatController } from '@/features/room/controllers/useRoomSeatController';
import type { RoomCapabilities } from '@/features/room/model/RoomCapabilities';
import {
  createBotTakeoverCapability,
  createRoomSetupCapabilities,
} from '@/features/room/model/RoomCapabilities';
import { HOST_ACTION_KEYS } from '@/features/room/model/hostManagementActions';
import type { RoomViewerAudience } from '@/features/room/model/RoomViewer';
import { viewerFor } from '@/test-utils/roomViewer';

import { __GAME_UPPER___GUIDANCE_MATRIX } from '../__GAME_CAMEL__GuidanceMatrix';
import { create__GAME_PASCAL__HostManagement, create__GAME_PASCAL__RoomShellModel } from '../__GAME_CAMEL__RoomAdapter';
import { showConfirmAlert } from '@/utils/alertPresets';
//#cap audioOrchestration
import { applyAudioPlaybackLock } from '@/features/room/model/audioPlaybackLock';
//#end

vi.mock('@/utils/alertPresets', () => ({ showConfirmAlert: vi.fn() }));

type CommandContext = Parameters<typeof __GAME_CAMEL__Engine.decide>[2];

function drive(
  state: __GAME_PASCAL__State,
  command: __GAME_PASCAL__Command,
  options: {
    userId?: string;
    nowMs?: number;
    system?: boolean;
    controlledSeat?: number | null;
  } = {},
): __GAME_PASCAL__State {
  const context: CommandContext =
    options.system === true
      ? {
          actor: { kind: 'system', effectId: 'settle-effect' },
          controlledSeat: null,
          nowMs: options.nowMs ?? 1000,
          commandId: command.type,
          randomSeed: 'seed',
        }
      : {
          actor: { kind: 'user', userId: options.userId ?? 'host' },
          controlledSeat: options.controlledSeat ?? null,
          nowMs: options.nowMs ?? 1000,
          commandId: command.type,
          randomSeed: 'seed',
        };
  const decision = __GAME_CAMEL__Engine.decide(state, command, context);
  if (decision.kind === 'reject') throw new Error(`rejected: ${decision.reason}`);
  return decision.events.reduce(__GAME_CAMEL__Engine.evolve, state);
}

function lobbyState(fillBots = true): __GAME_PASCAL__State {
  let state = __GAME_CAMEL__Engine.createInitialState(
    { ...DEFAULT___GAME_UPPER___CONFIG, numberOfPlayers: 4 },
    { roomCode: '1234', hostUserId: 'host', nowMs: 1000, commandId: 'create' },
  );
  state = drive(state, { type: 'room.seat.take', seat: 0, profile: { displayName: '房主' } });
  state = drive(
    state,
    { type: 'room.seat.take', seat: 1, profile: { displayName: 'P1' } },
    {
      userId: 'u1',
    },
  );
  if (fillBots) state = drive(state, { type: 'room.seat.fillBots' });
  return state;
}
//#cap identityViewing

function viewingState(): __GAME_PASCAL__State {
  const state = drive(lobbyState(), { type: '__GAME_ID__.roles.assign' });
  if (state.phase.kind !== 'viewing') throw new Error('expected viewing');
  return state;
}
//#end

function playingState(): __GAME_PASCAL__State {
//#cap identityViewing
  let state = viewingState();
  state = drive(state, { type: '__GAME_ID__.role.viewed' });
  state = drive(state, { type: '__GAME_ID__.role.viewed' }, { userId: 'u1' });
//#cap botBulkViewing
  state = drive(state, { type: '__GAME_ID__.bots.markAllBotsViewed' });
//#end
//#cap !botBulkViewing
  state = drive(state, { type: '__GAME_ID__.role.viewed' }, { controlledSeat: 2 });
  state = drive(state, { type: '__GAME_ID__.role.viewed' }, { controlledSeat: 3 });
//#end
  state = drive(state, { type: '__GAME_ID__.game.begin' });
//#end
//#cap !identityViewing
  const state = drive(lobbyState(), { type: '__GAME_ID__.game.begin' });
//#end
  if (state.phase.kind !== 'playing') throw new Error('expected playing');
  return state;
}

function stateFor(phase: __GAME_PASCAL__PhaseKind): __GAME_PASCAL__State {
  switch (phase) {
    case 'lobby':
      return lobbyState();
//#cap identityViewing
    case 'viewing':
      return viewingState();
//#end
    case 'playing':
      return playingState();
    case 'ended': {
//#cap stageDeadline
      const state = drive(
        playingState(),
        { type: '__GAME_ID__.phase.settleExpired' },
        { system: true, nowMs: 1000 + __GAME_UPPER___STAGE_DURATION_MS },
      );
//#end
//#cap !stageDeadline
      const playing = playingState();
      const decision = end__GAME_PASCAL__Game(playing, {
        actor: { kind: 'user', userId: 'host' },
        controlledSeat: null,
        nowMs: 1000,
        commandId: 'end-game',
        randomSeed: 'seed',
      });
      if (decision.kind === 'reject') throw new Error(`rejected: ${decision.reason}`);
      const state = decision.events.reduce(__GAME_CAMEL__Engine.evolve, playing);
//#end
      if (state.phase.kind !== 'ended') throw new Error('expected ended');
      return state;
    }
  }
}

function capabilities(isSetup = true, isRoomFull = true): RoomCapabilities {
  return {
    ...createRoomSetupCapabilities({
      isSetup,
      isHost: true,
      mySeat: 0,
      supportsBots: true,
      hasOccupiedSeats: true,
      isRoomFull,
      requestTakeSeat: vi.fn(),
      requestMoveSeat: vi.fn(),
      leaveSeat: vi.fn(),
      kickSeat: vi.fn(),
      clearSeats: vi.fn(),
      fillBots: vi.fn(),
      configureGame: vi.fn(),
      shareRoom: vi.fn(),
    }),
    canViewProfiles: { isAllowed: true, execute: vi.fn() },
    canTakeOverBots: createBotTakeoverCapability(true, vi.fn()),
  };
}

describe('__GAME_PASCAL__ host controls', () => {
  const submit = vi.fn(async () => true);
  function hostModel(
    state: __GAME_PASCAL__State,
    isSubmitting = false,
    roomCapabilities = capabilities(
      state.phase.kind === 'lobby',
      get__GAME_PASCAL__OccupiedSeatCount(state) === state.config.numberOfPlayers,
    ),
  ) {
    return create__GAME_PASCAL__HostManagement({
      state, submit, capabilities: roomCapabilities, isSubmitting,
      review: state.phase.kind === 'ended' ? { isEnabled: true, onPress: vi.fn() } : null,
//#cap audioOrchestration
      onMusicSettings: vi.fn(),
//#end
    });
  }
  it.each(__GAME_UPPER___PHASES)('exposes only the expected host actions in %s', (phase) => {
    const actions = hostModel(stateFor(phase)).sections.flatMap((section) => section.actions);
    const actualKeys = actions.map((action) => action.key).sort();
    const expectedKeys: string[] = [];
    if (phase === 'lobby') {
      expectedKeys.push(
//#cap identityViewing
        HOST_ACTION_KEYS.assignRoles,
//#end
//#cap !identityViewing
        HOST_ACTION_KEYS.startGame,
//#end
        HOST_ACTION_KEYS.configureGame,
        HOST_ACTION_KEYS.clearSeats,
        HOST_ACTION_KEYS.shareRoom,
      );
    }
//#cap identityViewing
    if (phase === 'viewing') {
      expectedKeys.push(HOST_ACTION_KEYS.startGame);
//#cap botBulkViewing
      expectedKeys.push(HOST_ACTION_KEYS.markBotsViewed);
//#end
    }
//#end
    if (phase === 'playing') expectedKeys.push(HOST_ACTION_KEYS.abortGame);
//#cap identityViewing
    if (phase === 'viewing') expectedKeys.push(HOST_ACTION_KEYS.abortGame);
//#end
    if (phase === 'ended') {
      expectedKeys.push(
        HOST_ACTION_KEYS.review,
        HOST_ACTION_KEYS.nextRound,
        HOST_ACTION_KEYS.returnLobby,
      );
    }
//#cap audioOrchestration
    if (phase !== 'playing') expectedKeys.push('music-settings');
//#end
    expect(actualKeys).toEqual(expectedKeys.sort());
  });

//#cap identityViewing
  it('enables begin only after every human and bot identity has been viewed', () => {
    let state = viewingState();
    const getBeginAction = () =>
      hostModel(state).sections
        .flatMap((section) => section.actions)
        .find((entry) => entry.key === HOST_ACTION_KEYS.startGame);
    expect(getBeginAction()?.isEnabled).toBe(false);

    state = drive(state, { type: '__GAME_ID__.role.viewed' });
    state = drive(state, { type: '__GAME_ID__.role.viewed' }, { userId: 'u1' });
//#cap botBulkViewing
    state = drive(state, { type: '__GAME_ID__.bots.markAllBotsViewed' });
//#end
//#cap !botBulkViewing
    state = drive(state, { type: '__GAME_ID__.role.viewed' }, { controlledSeat: 2 });
    state = drive(state, { type: '__GAME_ID__.role.viewed' }, { controlledSeat: 3 });
//#end
    expect(getBeginAction()?.isEnabled).toBe(true);
  });
//#end

  it('offers fill-bots only for an open lobby and runs each setup action through its capability', () => {
    const roomCapabilities = capabilities(true, false);
    const actions = hostModel(lobbyState(false), false, roomCapabilities).sections.flatMap(
      (section) => section.actions,
    );
    for (const [actionKey, capability] of [
      [HOST_ACTION_KEYS.configureGame, roomCapabilities.canConfigureGame],
      [HOST_ACTION_KEYS.fillBots, roomCapabilities.canFillBots],
      [HOST_ACTION_KEYS.clearSeats, roomCapabilities.canClearSeats],
      [HOST_ACTION_KEYS.shareRoom, roomCapabilities.canShareRoom],
    ] as const) {
      const action = actions.find((entry) => entry.key === actionKey);
      if (!action?.isEnabled || action.onPress === undefined || !capability.isAllowed)
        throw new Error(`Missing enabled setup action: ${actionKey}`);
      action.onPress();
      expect(capability.execute).toHaveBeenCalledOnce();
    }
    expect(actions.map((action) => action.key)).toContain(HOST_ACTION_KEYS.fillBots);
  });

//#cap identityViewing
  it('dispatches the role assignment only after host confirmation', async () => {
    submit.mockClear();
    const action = hostModel(lobbyState()).sections
      .flatMap((section) => section.actions)
      .find((entry) => entry.key === HOST_ACTION_KEYS.assignRoles);
    if (!action?.isEnabled) throw new Error('Missing enabled role assignment');
    action.onPress();
    expect(submit).not.toHaveBeenCalled();
    const confirm = vi.mocked(showConfirmAlert).mock.calls.at(-1)?.[2];
    if (confirm === undefined) throw new Error('Missing role assignment confirmation');
    await confirm();
    expect(submit).toHaveBeenCalledWith('分配角色', { type: '__GAME_ID__.roles.assign' });
  });
//#end
//#cap !identityViewing
  it('dispatches game start only after host confirmation', async () => {
    submit.mockClear();
    const action = hostModel(lobbyState()).sections
      .flatMap((section) => section.actions)
      .find((entry) => entry.key === HOST_ACTION_KEYS.startGame);
    if (!action?.isEnabled) throw new Error('Missing enabled game start');
    action.onPress();
    expect(submit).not.toHaveBeenCalled();
    const confirm = vi.mocked(showConfirmAlert).mock.calls.at(-1)?.[2];
    if (confirm === undefined) throw new Error('Missing game start confirmation');
    await confirm();
    expect(submit).toHaveBeenCalledWith('开始游戏', { type: '__GAME_ID__.game.begin' });
  });
//#end

  it.each([
    [
      HOST_ACTION_KEYS.nextRound,
      '再来一局',
//#cap identityViewing
      { type: '__GAME_ID__.roles.assign' },
//#end
//#cap !identityViewing
      { type: '__GAME_ID__.game.begin' },
//#end
    ],
    [HOST_ACTION_KEYS.returnLobby, '返回大厅', { type: '__GAME_ID__.game.returnToLobby' }],
  ] as const)('confirms terminal action %s before dispatch', async (key, label, command) => {
    submit.mockClear();
    const action = hostModel(stateFor('ended')).sections
      .flatMap((section) => section.actions)
      .find((entry) => entry.key === key);
    if (!action?.isEnabled) throw new Error(`Missing enabled terminal action: ${key}`);
    action.onPress();
    expect(submit).not.toHaveBeenCalled();
    const confirm = vi.mocked(showConfirmAlert).mock.calls.at(-1)?.[2];
    if (confirm === undefined) throw new Error(`Missing confirmation for ${key}`);
    await confirm();
    expect(submit).toHaveBeenCalledWith(label, command);
  });

  it('disables the lobby transition while a host command is submitting', () => {
    const key =
//#cap identityViewing
      HOST_ACTION_KEYS.assignRoles;
//#end
//#cap !identityViewing
      HOST_ACTION_KEYS.startGame;
//#end
    const action = hostModel(lobbyState(), true).sections
      .flatMap((section) => section.actions)
      .find((entry) => entry.key === key);
    expect(action?.isEnabled).toBe(false);
  });

  it('submits abort only after confirmation', async () => {
    submit.mockClear();
    const action = hostModel(playingState()).sections.flatMap((section) => section.actions).find((entry) => entry.key === 'abort-game');
    if (!action?.isEnabled) throw new Error('Missing abort action');
    action.onPress();
    expect(submit).not.toHaveBeenCalled();
    const confirm = vi.mocked(showConfirmAlert).mock.calls.at(-1)?.[2];
    if (confirm === undefined) throw new Error('Missing abort confirmation');
    await confirm();
    expect(submit).toHaveBeenCalledWith('中止本局', { type: '__GAME_ID__.game.abort' });
  });
//#cap botBulkViewing
  it('wires bulk viewing and removes its remedy after all bots are marked', () => {
    const state = viewingState();
    const panel = hostModel(state);
    expect(panel.task).toMatchObject({ remedyActionKey: 'mark-bots-viewed' });
    const action = panel.sections.flatMap((section) => section.actions).find((entry) => entry.key === 'mark-bots-viewed');
    if (!action?.isEnabled) throw new Error('Missing bot viewing action');
    action.onPress();
    expect(submit).toHaveBeenCalledWith('标记机器人已查看', { type: '__GAME_ID__.bots.markAllBotsViewed' });
    const marked = drive(state, { type: '__GAME_ID__.bots.markAllBotsViewed' });
    expect(hostModel(marked).sections.flatMap((section) => section.actions).some((entry) => entry.key === 'mark-bots-viewed')).toBe(false);
  });
//#end
//#cap audioOrchestration
  it('keeps abort visible but inert while narration is playing', () => {
    const locked = applyAudioPlaybackLock(hostModel(playingState()), {
      isAudioPlaying: true, exemptActionKeys: new Set<string>(),
    });
    const action = locked.sections.flatMap((section) => section.actions).find((entry) => entry.key === 'abort-game');
    expect(action?.isEnabled).toBe(false);
    expect(action).not.toHaveProperty('onPress');
  });
//#end
});

const seatController: RoomSeatController = {
  pendingAction: null,
  isSubmitting: false,
  requestTakeSeat: vi.fn(),
  requestMoveSeat: vi.fn(),
  confirm: vi.fn(async () => undefined),
  cancel: vi.fn(),
};

function bottomMessage(
  state: __GAME_PASCAL__State,
  audience: RoomViewerAudience,
  buildHostManagement = () => ({ task: null, sections: [] }),
): string | null {
  const viewer = viewerFor(audience);
  const model = create__GAME_PASCAL__RoomShellModel({
    roomCode: '1234',
    viewer,
    capabilities: capabilities(),
    onBack: vi.fn(),
    onTitlePress: vi.fn(),
    onTitleLongPress: vi.fn(),
    user: { id: viewer.userId, avatarUrl: null },
    gachaStatus: null,
    onUserActionPress: vi.fn(),
    connection: {
      status: { kind: 'live' },
      pendingDurableCount: 0,
      onRetryNow: vi.fn(),
    },
    state,
    revision: 5,
    controlledSeat: null,
    seatsVisuallyDisabled: false,
    onSeatPress: vi.fn(),
    onBotSeatLongPress: null,
    seatController,
    profileSelection: null,
//#cap businessStats
    gameDetails: null,
//#end
    onProfileClose: vi.fn(),
    onProfileLeaveSeat: vi.fn(),
    share: {
      isVisible: false,
      roomCode: '1234',
      roomUrl: 'https://example.test/1234',
      open: vi.fn(),
      close: vi.fn(),
      copyLink: vi.fn(async () => undefined),
      shareImage: vi.fn(async () => undefined),
    },
    isLobby: state.phase.kind === 'lobby',
    buildHostManagement,
    releaseBot: vi.fn(),
    review: state.phase.kind === 'ended' ? { isEnabled: true, onPress: vi.fn() } : null,
  });
  return model.bottomActions.message;
}

describe('__GAME_UPPER___GUIDANCE_MATRIX', () => {
  it('builds host controls only for the host viewer', () => {
    const buildHostManagement = vi.fn(() => ({ task: null, sections: [] }));
    bottomMessage(lobbyState(), 'seated', buildHostManagement);
    bottomMessage(lobbyState(), 'spectator', buildHostManagement);
    expect(buildHostManagement).not.toHaveBeenCalled();

    bottomMessage(lobbyState(), 'host', buildHostManagement);
    expect(buildHostManagement).toHaveBeenCalledOnce();
  });

  it('covers exactly the engine phase list, each exempt cell with a reason', () => {
    expect(Object.keys(__GAME_UPPER___GUIDANCE_MATRIX).sort()).toEqual([...__GAME_UPPER___PHASES].sort());
    for (const row of Object.values(__GAME_UPPER___GUIDANCE_MATRIX)) {
      for (const cell of Object.values(row)) {
        if (cell.kind === 'exempt') expect(cell.reason.length).toBeGreaterThan(0);
      }
    }
  });

  it.each(__GAME_UPPER___PHASES)('holds every viewer cell in phase %s', (phase) => {
    const state = stateFor(phase);
    for (const viewer of ['host', 'seated', 'spectator'] as const) {
      const cell = __GAME_UPPER___GUIDANCE_MATRIX[phase][viewer];
      const message = bottomMessage(state, viewer);
      if (cell.kind === 'message') {
        if (typeof message !== 'string' || message === '') {
          throw new Error(
            `${phase} x ${viewer}: declared a message cell, got ${JSON.stringify(message)}`,
          );
        }
      } else if (message !== null) {
        throw new Error(
          `${phase} x ${viewer}: declared exempt (${cell.reason}), got ${JSON.stringify(message)}`,
        );
      }
    }
  });
});
