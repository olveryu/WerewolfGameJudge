/**
 * __GAME_PASCAL__ 身份 → 通用 RevealRoleData 适配器。
 *
 * TODO(gameplay): 身份构成定稿后，在这里把每个身份映射到展示名、阵营
 * （视觉主题）、立绘与结构化介绍；介绍文案与说明页/图鉴同源消费，
 * 不许在别处再手写一份。
 */
import { __GAME_UPPER___TODO_IDENTITY } from '@game-judge/game-engine/games/__GAME_ID__/public';

import type { RevealRoleData } from '@/features/room/model/RevealRoleData';
import type { BoardInfoSection } from '@/features/room/model/BoardInfoSection';

import { getRoleAvatar } from '../assets/roleAvatars';

/** Public board composition only; never derive this from privately dealt seat identities. */
export function create__GAME_PASCAL__BoardInfoSections(playerCount: number): readonly BoardInfoSection[] {
  // TODO(gameplay): replace the placeholder with the approved public role-count table.
  return [{
    title: '身份',
    tone: 'muted',
    items: [{
      roleId: __GAME_UPPER___TODO_IDENTITY,
      displayName: toRevealRoleData(__GAME_UPPER___TODO_IDENTITY).name,
      count: playerCount,
    }],
  }];
}

/** 将本游戏身份转换为通用揭示数据。 */
export function toRevealRoleData(identity: string): RevealRoleData {
  if (identity === __GAME_UPPER___TODO_IDENTITY) {
    return {
      id: identity,
      name: '待定身份',
      alignment: 'neutral',
      imageUrl: getRoleAvatar(identity),
      description: 'TODO(gameplay):身份介绍随身份构成定稿后填写。',
    };
  }
  throw new Error(`[FAIL-FAST] Unknown __GAME_DISPLAY_NAME__ identity: ${identity}`);
}
