import type { AudioEffect } from '@game-judge/game-engine/games/__GAME_ID__/public';

import type { AudioClip } from '@/features/product/model/AudioClip';
import type { RoomBgmPlaybackPort } from '@/features/room/audio/useRoomBgmControl';

import { get__GAME_PASCAL__PreloadAudio, resolve__GAME_PASCAL__Audio } from './__GAME_CAMEL__AudioRegistry';

export interface __GAME_PASCAL__AudioRuntime extends RoomBgmPlaybackPort {
  readonly playEffect: (effect: AudioEffect) => Promise<void>;
  readonly preload: () => void;
  readonly stopNarration: () => void;
  readonly stopBgm: () => void;
}

/** Platform audio operations used by the game-owned player. */
export interface __GAME_PASCAL__AudioPlaybackPort extends RoomBgmPlaybackPort {
  playClip(clip: AudioClip): Promise<void>;
  preloadClips(clips: readonly AudioClip[]): void;
  stop(): void;
  stopBgm(): void;
}

/** Adapts the approved cue registry to the shared AudioService. */
export class __GAME_PASCAL__AudioPlayer implements __GAME_PASCAL__AudioRuntime {
  readonly #audioService: __GAME_PASCAL__AudioPlaybackPort;

  constructor(audioService: __GAME_PASCAL__AudioPlaybackPort) {
    this.#audioService = audioService;
  }

  readonly playEffect = (effect: AudioEffect): Promise<void> =>
    this.#audioService.playClip(resolve__GAME_PASCAL__Audio(effect.audioKey));

  readonly preload = (): void => this.#audioService.preloadClips(get__GAME_PASCAL__PreloadAudio());

  readonly stopNarration = (): void => this.#audioService.stop();

  readonly stopBgm = (): void => this.#audioService.stopBgm();
  readonly startBgm = (urls: readonly string[]): void => this.#audioService.startBgm(urls);
  readonly isBgmPlaying = (): boolean => this.#audioService.isBgmPlaying();
  readonly subscribeBgm = (listener: () => void): (() => void) =>
    this.#audioService.subscribeBgm(listener);
  readonly setBgmVolume = (volume: number): void => this.#audioService.setBgmVolume(volume);
  readonly setGameAudioVolume = (volume: number): void =>
    this.#audioService.setGameAudioVolume(volume);
}
