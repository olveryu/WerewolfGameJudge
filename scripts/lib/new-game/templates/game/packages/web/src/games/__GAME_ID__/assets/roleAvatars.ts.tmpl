/**
 * __GAME_DISPLAY_NAME__ role-card image registry: the compressed 512px WebP portraits.
 *
 * TODO(gameplay): 身份构成定稿后，把每个身份的立绘放进 `assets/avatars/web/`
 * 并在这里登记（例如 `import example from '../../../../../../assets/avatars/web/example.webp'`）；
 * `getBoardRolePortraits` 只返回公开板子上可能出现的身份，绝不读玩家的秘密分配。
 * 进房间时由共享 `useRoomImagePreload` 一次预加载（见 `use__GAME_PASCAL__RoomState`）。
 */

/** Resolve __GAME_DISPLAY_NAME__ role IDs to the game's hand-drawn role-card asset URLs. */
export function getRoleAvatar(roleId: string): string {
  const url = __GAME_UPPER___ROLE_IMAGE_MAP[roleId];
  if (url === undefined) throw new Error(`Missing portrait for role ${roleId}`);
  return url;
}

/** Portraits for the public board: every public role kind. */
export function getBoardRolePortraits(): readonly string[] {
  return Object.values(__GAME_UPPER___ROLE_IMAGE_MAP);
}

/** TODO(gameplay): 身份构成定稿后登记每个身份的立绘地址。 */
const __GAME_UPPER___ROLE_IMAGE_MAP: Readonly<Record<string, string>> = {};
