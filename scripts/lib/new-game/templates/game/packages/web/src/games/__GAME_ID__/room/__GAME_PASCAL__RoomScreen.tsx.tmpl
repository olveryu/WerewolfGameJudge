//#cap identityViewing
/** __GAME_DISPLAY_NAME__房间：大厅走共享座位表；发牌后是身份查看与对局工作区。 */
//#end
//#cap !identityViewing
/** __GAME_DISPLAY_NAME__房间：大厅走共享座位表；开局后是舞台工作区。 */
//#end
import './__GAME_PASCAL__RoomScreen.css';

import type { __GAME_PASCAL__State } from '@game-judge/game-engine/games/__GAME_ID__/public';
import { useNavigate } from 'react-router';

//#cap identityViewing
import { Button } from '@/components/Button';
import { RevealRoleCardModal } from '@/features/room/components/RevealRoleCardModal';
//#end
import { RoomEntryBoundary } from '@/features/room/components/RoomEntryBoundary';
import { RoomGameSummary, RoomGuideButton } from '@/features/room/components/RoomGameSummary';
import { RoomShell } from '@/features/room/components/RoomShell';
//#cap !identityViewing
import { StageSettleRescue } from '@/features/room/components/StageSettleRescue';
//#end
import type { RoomEntryController } from '@/features/room/controllers/useRoomEntryController';
//#cap !identityViewing
import { formatCountdownSeconds } from '@/features/room/model/formatCountdown';
//#end
//#cap identityViewing
import { resolveViewIdentityAction } from '@/features/room/model/RoomBottomActions';
//#end
import type { GameRoomScreenProps } from '@/features/room/model/RoomUiModule';
import { exitRoomFlow } from '@/features/room/navigation/roomFlowNavigation';
import type { RoomReviewContribution } from '@/features/room/review/types';
import type { __GAME_PASCAL__RoomSession } from '@/games/__GAME_ID__/model/__GAME_PASCAL__RoomSession';
//#cap businessStats
import { __GAME_PASCAL__StatsPanel } from '../components/__GAME_PASCAL__StatsPanel';
//#end

//#cap identityViewing
import { toRevealRoleData } from '../components/__GAME_PASCAL__RoleCardAdapter';
//#end
import {
  type __GAME_PASCAL__RoomScreenState,
  use__GAME_PASCAL__RoomState,
} from './hooks/use__GAME_PASCAL__RoomState';

type __GAME_PASCAL__RoomScreenProps = GameRoomScreenProps<'__GAME_ID__'> & {
  readonly session: __GAME_PASCAL__RoomSession;
  /** 模块声明的本局复盘（defineClientGameModule 的 review）；房间只渲染这一份。 */
  readonly review: RoomReviewContribution<__GAME_PASCAL__State>;
};

/** 使用平台入场生命周期处理直链、加入与重连。 */
export function __GAME_PASCAL__RoomScreen(props: __GAME_PASCAL__RoomScreenProps) {
  const navigate = useNavigate();
  return (
    <RoomEntryBoundary
      room={props.room}
      session={props.session}
      onExit={() => exitRoomFlow(navigate)}
    >
      {(entryController) => (
        <__GAME_PASCAL__RoomContent {...props} entryController={entryController} />
      )}
    </RoomEntryBoundary>
  );
}

function __GAME_PASCAL__RoomContent(
  props: __GAME_PASCAL__RoomScreenProps & { readonly entryController: RoomEntryController },
) {
  const screen = use__GAME_PASCAL__RoomState(props);
  const config = screen.state.config;
  const isLobby = screen.state.phase.kind === 'lobby';
  return (
    <RoomShell
      model={screen.shellModel}
      content={
        isLobby
          ? {
              kind: 'seats',
              contextHeader: null,
              afterSeatBoard: null,
              sideInspector: null,
              beforeSeatBoard: (
                <RoomGameSummary
                  icon="__GAME_ICON_NAME__"
                  title={`__GAME_DISPLAY_NAME__ · ${config.numberOfPlayers}人局`}
                  subtitle="__GAME_SUBTITLE__"
                  headerRight={
                    <RoomGuideButton onPress={screen.openRules} label="查看__GAME_DISPLAY_NAME__玩法" />
                  }
                />
              ),
            }
          : { kind: 'workspace', element: <__GAME_PASCAL__StageArea screen={screen} /> }
      }
      leadingExtraActions={null}
      trailingExtraActions={null}
//#cap businessStats
      profileDetailsRenderer={(userId, onGamesPlayedChange) => (
        <__GAME_PASCAL__StatsPanel userId={userId} onGamesPlayedChange={onGamesPlayedChange} />
      )}
//#end
//#cap identityViewing
      gameOverlays={
        <>
          <RevealRoleCardModal
            visible={screen.roleViewing.isOpen}
            roleKey={screen.viewModel?.myIdentity ?? null}
            toRoleData={toRevealRoleData}
            onClose={screen.roleViewing.close}
          />
          {screen.reviewOverlay}
        </>
      }
//#end
//#cap !identityViewing
      gameOverlays={screen.reviewOverlay}
//#end
    />
  );
}

//#cap identityViewing
/**
 * 对局工作区（座位表之外的阶段层）。TODO(gameplay): 玩法阶段 UI 在这里按落点总规则组装——
 * 公共步进进度归底部进度行、个人指令归底部消息、个人动作归底部按钮、逐座状态归座位徽标、
 * 一次性信息归弹窗；座位表下方不加阶段层（afterSeatBoard 恒为 null）。
 */
function __GAME_PASCAL__StageArea({ screen }: { readonly screen: __GAME_PASCAL__RoomScreenState }) {
  const phase = screen.state.phase;
  // 查看动作定义走共享解析（身份模板同形态）：此处是 stage 区表面渲染。
  const viewIdentityAction = resolveViewIdentityAction({
    isVisible: phase.kind !== 'ended',
    label: '查看我的身份',
    onPress: screen.roleViewing.open,
  });
  return (
    <section className="__GAME_ID__-stage">
      <h2 className="__GAME_ID__-stage-title">
        {phase.kind === 'viewing'
          ? '身份查看'
          : phase.kind === 'ended'
            ? '本局已结束'
            : '对局进行中'}
      </h2>
      <p className="__GAME_ID__-stage-hint">
        {phase.kind === 'viewing'
          ? '点下方按钮查看你的身份；全员查看完后由房主开始游戏。'
          : 'TODO(gameplay):玩法阶段界面随玩法状态机落地。'}
      </p>
      {viewIdentityAction !== null && (
        <Button
          variant="secondary"
          size="lg"
          disabled={screen.isSubmitting}
          onClick={viewIdentityAction.onPress}
        >
          {viewIdentityAction.label}
        </Button>
      )}
    </section>
  );
}
//#end
//#cap !identityViewing
/**
 * 舞台工作区（座位表之外的阶段层）：标题与倒计时在顶部，截止过后由共享 StageSettleRescue
 * 承载等待与房主自救。TODO(gameplay): 玩法阶段 UI 在这里按落点总规则组装——公共步进进度归
 * 底部进度行、个人指令归底部消息、个人动作归底部按钮、逐座状态归座位徽标、一次性信息归
 * 弹窗；座位表下方不加阶段层（afterSeatBoard 恒为 null）。
 */
function __GAME_PASCAL__StageArea({ screen }: { readonly screen: __GAME_PASCAL__RoomScreenState }) {
  const phase = screen.state.phase;
  return (
    <section className="__GAME_ID__-stage">
      <div className="__GAME_ID__-stage-header">
        <h2 className="__GAME_ID__-stage-title">
          {phase.kind === 'ended' ? '本局已结束' : '舞台进行中'}
        </h2>
        {screen.remainingSeconds !== null && (
          <span className="__GAME_ID__-stage-countdown" role="timer" aria-label="本阶段剩余时间">
            {formatCountdownSeconds(screen.remainingSeconds)}
          </span>
        )}
      </div>
      <StageSettleRescue
        remainingSeconds={screen.remainingSeconds}
        isOverdue={screen.isOverdue}
        isHost={screen.isHost}
        isRetrying={screen.isSubmitting}
        onRetry={() => void screen.submit('重新推进', { type: '__GAME_ID__.phase.retrySettle' })}
        waitingLabel="等待推进…"
      />
      <p className="__GAME_ID__-stage-hint">TODO(gameplay):玩法阶段界面随玩法状态机落地。</p>
    </section>
  );
}
//#end
