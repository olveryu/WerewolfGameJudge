//#cap identityViewing
/** __GAME_DISPLAY_NAME__房间：全程保留共享座位表和公开身份配置。 */
//#end
//#cap !identityViewing
/** __GAME_DISPLAY_NAME__房间：大厅走共享座位表；开局后是舞台工作区。 */
//#end
import './__GAME_PASCAL__RoomScreen.css';

import {
  get__GAME_PASCAL__OccupiedSeatCount,
  type __GAME_PASCAL__State,
} from '@game-judge/game-engine/games/__GAME_ID__/public';
import { useState } from 'react';
import { useNavigate } from 'react-router';

//#cap identityViewing
import { BoardInfoContent } from '@/features/room/components/BoardInfoContent';
import { RevealRoleCardModal } from '@/features/room/components/RevealRoleCardModal';
import { RoleCardDialog } from '@/features/room/components/RoleCard';
//#end
import { RoomEntryBoundary } from '@/features/room/components/RoomEntryBoundary';
import { RoomGameSummary } from '@/features/room/components/RoomGameSummary';
import { type RoomInformation, RoomInformationDialog } from '@/features/room/components/RoomInformationDialog';
import { RoomShell } from '@/features/room/components/RoomShell';
//#cap audioOrchestration
import { RoomAudioResumeDialog } from '@/features/room/components/RoomAudioResumeDialog';
import { RoomBgmToggle } from '@/features/room/components/RoomBgmToggle';
//#end
//#cap stageDeadline
import { StageSettleRescue } from '@/features/room/components/StageSettleRescue';
//#end
import type { RoomEntryController } from '@/features/room/controllers/useRoomEntryController';
//#cap stageDeadline
import { formatCountdownSeconds } from '@/features/room/model/formatCountdown';
//#end
import type { GameRoomScreenProps } from '@/features/room/model/RoomUiModule';
import { exitRoomFlow } from '@/features/room/navigation/roomFlowNavigation';
import type { RoomReviewContribution } from '@/features/room/review/types';
//#cap audioOrchestration
import type { __GAME_PASCAL__AudioRuntime } from '../audio/__GAME_CAMEL__AudioRuntime';
//#end
import type { __GAME_PASCAL__RoomSession } from '@/games/__GAME_ID__/model/__GAME_PASCAL__RoomSession';
import { TESTIDS } from '@/testids';
//#cap businessStats
import { __GAME_PASCAL__StatsPanel } from '../components/__GAME_PASCAL__StatsPanel';
//#end

import { __GAME_PASCAL__Rules } from '../screens/__GAME_PASCAL__RulesScreen';
//#cap identityViewing
import { create__GAME_PASCAL__BoardInfoSections, toRevealRoleData } from '../components/__GAME_PASCAL__RoleCardAdapter';
//#end
import {
//#cap !identityViewing
  type __GAME_PASCAL__RoomScreenState,
//#end
//#cap identityViewing
//#cap stageDeadline
  type __GAME_PASCAL__RoomScreenState,
//#end
//#end
  use__GAME_PASCAL__RoomState,
} from './hooks/use__GAME_PASCAL__RoomState';

type __GAME_PASCAL__RoomScreenProps = GameRoomScreenProps<'__GAME_ID__'> & {
  readonly session: __GAME_PASCAL__RoomSession;
//#cap audioOrchestration
  readonly audio: __GAME_PASCAL__AudioRuntime;
//#end
  /** 模块声明的本局复盘（defineClientGameModule 的 review）；房间只渲染这一份。 */
  readonly review: RoomReviewContribution<__GAME_PASCAL__State>;
};

/** 使用平台入场生命周期处理直链、加入与重连。 */
export function __GAME_PASCAL__RoomScreen(props: __GAME_PASCAL__RoomScreenProps) {
  const navigate = useNavigate();
  return (
    <RoomEntryBoundary
      room={props.room}
      session={props.session}
      onExit={() => exitRoomFlow(navigate)}
    >
      {(entryController) => (
        <__GAME_PASCAL__RoomContent {...props} entryController={entryController} />
      )}
    </RoomEntryBoundary>
  );
}

function __GAME_PASCAL__RoomContent(
  props: __GAME_PASCAL__RoomScreenProps & { readonly entryController: RoomEntryController },
) {
  const screen = use__GAME_PASCAL__RoomState(props);
  const config = screen.state.config;
  const isLobby = screen.state.phase.kind === 'lobby';
  const [information, setInformation] = useState<RoomInformation>(null);
  const openGuide = () => setInformation('guide');
  const openConfiguration = () => setInformation('configuration');
//#cap identityViewing
  const isPreGame = isLobby || screen.state.phase.kind === 'viewing';
  const [previewRole, setPreviewRole] = useState<string | null>(null);
  const board = (
    <BoardInfoContent
      sections={create__GAME_PASCAL__BoardInfoSections(config.numberOfPlayers)}
      onRolePress={setPreviewRole}
      footer={null}
    />
  );
//#end
  return (
    <RoomShell
      model={screen.shellModel}
      phaseLabel={
        isLobby
          ? '待开局'
//#cap identityViewing
          : screen.state.phase.kind === 'viewing'
            ? '已发牌'
//#end
            : screen.state.phase.kind === 'ended'
              ? '本局结束'
              : '游戏进行中'
      }
      lobbyAction={
        isLobby
          ? {
//#cap identityViewing
              label: '分配角色',
//#end
//#cap !identityViewing
              label: '开始游戏',
//#end
              occupiedSeats: get__GAME_PASCAL__OccupiedSeatCount(screen.state),
            }
          : null
      }
//#cap identityViewing
      configurationEntry={isPreGame ? null : { onOpen: openConfiguration }}
//#end
//#cap !identityViewing
      stageMenu={screen.state.phase.kind === 'playing' ? { onOpenGuide: openGuide, onOpenConfiguration: openConfiguration } : null}
      configurationEntry={isLobby ? null : { onOpen: openConfiguration }}
//#end
      manualEntries={[{ label: '玩法', onOpen: openGuide, testId: TESTIDS.roomGuideButton('__GAME_ID__') }]}
      content={
//#cap identityViewing
        {
          kind: 'seats',
//#cap stageDeadline
          contextHeader: isLobby ? null : (
            <__GAME_PASCAL__StageDeadlineControls
              screen={screen}
              title={screen.state.phase.kind === 'viewing' ? '身份查看' : screen.state.phase.kind === 'ended' ? '本局已结束' : '对局进行中'}
            />
          ),
//#end
//#cap !stageDeadline
          contextHeader: null,
//#end
          bottomSummary: null,
          afterSeatBoard: null,
          sideInspector: null,
          beforeSeatBoard: (
            <>
            {isPreGame && (
            <RoomGameSummary
              title="__GAME_DISPLAY_NAME__"
              playerCount={config.numberOfPlayers}
              guide={null}
            >
              {board}
            </RoomGameSummary>
            )}
            </>
          ),
        }
//#end
//#cap !identityViewing
        isLobby
          ? {
              kind: 'seats',
              contextHeader: null,
              bottomSummary: null,
              afterSeatBoard: null,
              sideInspector: null,
              beforeSeatBoard: (
                <RoomGameSummary
                  title="__GAME_DISPLAY_NAME__"
                  playerCount={config.numberOfPlayers}
                  guide={null}
                />
              ),
            }
          : { kind: 'workspace', element: <__GAME_PASCAL__StageArea screen={screen} /> }
//#end
      }
//#cap audioOrchestration
      leadingExtraActions={screen.isHost && screen.state.phase.kind === 'playing' ? <RoomBgmToggle bgm={screen.bgm} /> : null}
//#end
//#cap !audioOrchestration
      leadingExtraActions={null}
//#end
      trailingExtraActions={null}
//#cap businessStats
      profileDetailsRenderer={(userId, onGamesPlayedChange) => (
        <__GAME_PASCAL__StatsPanel userId={userId} onGamesPlayedChange={onGamesPlayedChange} />
      )}
//#end
      gameOverlays={
        <>
          <RoomInformationDialog
            information={information}
            guideTitle="__GAME_DISPLAY_NAME__玩法"
            guide={<__GAME_PASCAL__Rules embedded />}
            configuration={
              <>
                <p>{`__GAME_DISPLAY_NAME__（${config.numberOfPlayers}人）`}</p>
//#cap identityViewing
                {board}
//#end
              </>
            }
            onClose={() => setInformation(null)}
          />
//#cap audioOrchestration
          <RoomAudioResumeDialog visible={screen.audioResume.isDue} onContinue={screen.audioResume.continueGame} />
//#end
//#cap identityViewing
          <RevealRoleCardModal
            visible={screen.roleViewing.isOpen}
            roleKey={screen.viewModel?.myIdentity ?? null}
            toRoleData={toRevealRoleData}
            shouldPlay={screen.roleViewing.shouldPlayAnimation}
            allRoles={screen.roleCardAllRoles}
            remainingCards={screen.roleViewing.remainingCards}
            onClose={screen.roleViewing.close}
          />
          {previewRole !== null && (
            <RoleCardDialog role={toRevealRoleData(previewRole)} onClose={() => setPreviewRole(null)} />
          )}
//#end
          {screen.reviewOverlay}
        </>
      }
    />
  );
}

//#cap !identityViewing
/**
 * 舞台工作区（座位表之外的阶段层）：标题与倒计时在顶部，截止过后由共享 StageSettleRescue
 * 承载等待与房主自救。TODO(gameplay): 玩法阶段 UI 在这里按落点总规则组装——公共步进进度归
 * 底部进度行、个人指令归底部消息、个人动作归底部按钮、逐座状态归座位徽标、一次性信息归
 * 弹窗；座位表下方不加阶段层（afterSeatBoard 恒为 null）。
 */
function __GAME_PASCAL__StageArea({ screen }: { readonly screen: __GAME_PASCAL__RoomScreenState }) {
  const phase = screen.state.phase;
  return (
    <section className="__GAME_ID__-stage">
//#cap stageDeadline
      <__GAME_PASCAL__StageDeadlineControls
        screen={screen}
        title={phase.kind === 'ended' ? '本局已结束' : '舞台进行中'}
      />
//#end
//#cap !stageDeadline
      <h2 className="__GAME_ID__-stage-title">
        {phase.kind === 'ended' ? '本局已结束' : '舞台进行中'}
      </h2>
//#end
      <p className="__GAME_ID__-stage-hint">TODO(gameplay):玩法阶段界面随玩法状态机落地。</p>
    </section>
  );
}
//#end

//#cap stageDeadline
function __GAME_PASCAL__StageDeadlineControls({
  screen,
  title,
}: {
  readonly screen: __GAME_PASCAL__RoomScreenState;
  readonly title: string;
}) {
  return (
    <>
      <div className="__GAME_ID__-stage-header">
        <h2 className="__GAME_ID__-stage-title">{title}</h2>
        {screen.remainingSeconds !== null && (
          <span className="__GAME_ID__-stage-countdown" role="timer" aria-label="本阶段剩余时间">
            {formatCountdownSeconds(screen.remainingSeconds)}
          </span>
        )}
      </div>
      <StageSettleRescue
        remainingSeconds={screen.remainingSeconds}
        isOverdue={screen.isOverdue}
        isHost={screen.isHost}
        isRetrying={screen.isSubmitting}
        onRetry={() => void screen.submit('重新推进', { type: '__GAME_ID__.phase.retrySettle' })}
        waitingLabel="等待推进…"
      />
    </>
  );
}
//#end
