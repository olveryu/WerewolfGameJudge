import type {
  AudioEffect,
  __GAME_PASCAL__Command,
} from '@game-judge/game-engine/games/__GAME_ID__/public';
import { useMemo } from 'react';

import type { RoomAudioPlayerPort } from '@/features/room/audio/RoomAudioOrchestrator';
import {
  type RoomAudioOrchestration,
  useRoomAudioOrchestration,
} from '@/features/room/audio/useRoomAudioOrchestration';
import { log } from '@/utils/logger';

import type { __GAME_PASCAL__AudioRuntime } from '../../audio/__GAME_CAMEL__AudioRuntime';
import type { __GAME_PASCAL__RoomSession } from '../../model/__GAME_PASCAL__RoomSession';

const logger = log.extend('__GAME_PASCAL__Audio');
const ackCommand = (audioBatchId: number): __GAME_PASCAL__Command => ({
  type: '__GAME_ID__.audio.ack',
  audioBatchId,
});

/** Required narration uses the shared playback, durable ack and rejoin lifecycle. */
export function use__GAME_PASCAL__AudioOrchestration({
  session,
  isHost,
  audio,
}: {
  readonly session: __GAME_PASCAL__RoomSession;
  readonly isHost: boolean;
  readonly audio: __GAME_PASCAL__AudioRuntime;
}): RoomAudioOrchestration {
  const player = useMemo(
    (): RoomAudioPlayerPort<AudioEffect> & { readonly stopNarration: () => void } => ({
      playEffect: audio.playEffect,
      stopBgm: audio.stopBgm,
      stopNarration: audio.stopNarration,
      prepareQueue: () => {
        audio.preload();
        return Promise.resolve();
      },
    }),
    [audio],
  );
  return useRoomAudioOrchestration({
    session,
    isHost,
    player,
    ackCommand,
    ackLabel: '播报确认',
    logger,
  });
}
