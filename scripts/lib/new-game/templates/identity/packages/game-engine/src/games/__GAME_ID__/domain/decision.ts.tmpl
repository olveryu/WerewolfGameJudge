/** __GAME_PASCAL__ decision outcomes and permission gates; no IO. */

import { commit, type Decision } from '../../../platform/engine';
import { type RosterChange } from '../../../platform/room/seating';
import type { __GAME_PASCAL__HumanSeat, __GAME_PASCAL__State } from '../state/types';

/**
 * Stable English rejection codes (AU-48). The user-facing copy for each
 * code lives in the client presenter; engines never emit display text
 * as a reason.
 */
export const __GAME_UPPER___REASONS = {
  config: '__GAME_ID___config_invalid',
  phase: '__GAME_ID___phase_invalid',
  notHostStart: '__GAME_ID___not_host_start',
  notHostBegin: '__GAME_ID___not_host_begin',
  notAllViewed: '__GAME_ID___not_all_viewed',
  notHostMarkBots: '__GAME_ID___not_host_mark_bots',
  noBotSeats: '__GAME_ID___no_bot_seats',
  full: '__GAME_ID___room_not_full',
  notHostReturnToLobby: '__GAME_ID___not_host_return_to_lobby',
  occupied: '__GAME_ID___occupied_seat_out_of_range',
  notImplemented: '__GAME_ID___not_implemented',
} as const;

export type __GAME_PASCAL__Event =
  | {
      readonly type: '__GAME_ID__.seats.changed';
      readonly changes: readonly RosterChange<__GAME_PASCAL__HumanSeat>[];
    }
  | { readonly type: '__GAME_ID__.config.updated'; readonly config: __GAME_PASCAL__State['config'] }
  | {
      readonly type: '__GAME_ID__.game.started';
      readonly identities: Readonly<Record<number, string>>;
      readonly gameSequence: number;
    }
  | { readonly type: '__GAME_ID__.game.begun' }
  | { readonly type: '__GAME_ID__.role.viewed'; readonly seat: number }
  // TODO(gameplay): 玩法事件随玩法状态机加在这里，evolve.ts 逐个落状态。
  | { readonly type: '__GAME_ID__.game.ended' }
  | { readonly type: '__GAME_ID__.game.returnedToLobby' };

/**
 * Effect 词汇：终局结算只是第一个成员。给游戏加定时/异步流程时，
 * 把本类型改成判别联合并追加成员（如舞台型的 `settle.due` 写
 * `| { readonly type: '...'; readonly payload: {...} }`）。消费方
 * （引擎测试、Worker schemas）一律按 `type` 窄化后读 payload，
 * 不许直取某个成员的字段——加第二个成员时它们不需要改。
 */
export type __GAME_PASCAL__Effect = {
  /** 终局 growth settlement effect：Worker 据此发 XP 奖励，xpSettled 保证恰好一次。 */
  readonly type: '__GAME_ID__.game.completed';
  readonly payload: {
    readonly roundId: string;
    readonly completedAt: number;
    readonly participantUserIds: readonly string[];
  };
};

export type __GAME_PASCAL__Decision = Decision<__GAME_PASCAL__Event, __GAME_PASCAL__Effect>;

/** Commits domain events and completion effects through the shared runtime. */
export function commit__GAME_PASCAL__(
  events: readonly __GAME_PASCAL__Event[],
  effects: readonly __GAME_PASCAL__Effect[] = [],
): __GAME_PASCAL__Decision {
  return commit({ events, effects });
}
