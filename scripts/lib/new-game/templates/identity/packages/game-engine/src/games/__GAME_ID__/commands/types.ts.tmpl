/** __GAME_PASCAL__ commands; actors come from platform authentication. */

import type {
  RoomProfileUpdateCommand,
  RoomSeatCommand,
} from '../../../platform/protocol/commands';
import type { RoomProfileUpdate, RoomSeatProfile } from '../../../platform/room/roster';
import type { __GAME_PASCAL__Config } from '../state/types';

export type __GAME_PASCAL__PublicCommand =
  | RoomSeatCommand<RoomSeatProfile>
  | RoomProfileUpdateCommand<RoomProfileUpdate>
  | { readonly type: '__GAME_ID__.config.update'; readonly config: __GAME_PASCAL__Config }
  | { readonly type: '__GAME_ID__.roles.assign' }
  | { readonly type: '__GAME_ID__.game.begin' }
  | { readonly type: '__GAME_ID__.game.returnToLobby' }
  | { readonly type: '__GAME_ID__.role.viewed' }
  | { readonly type: '__GAME_ID__.bots.markAllBotsViewed' }
  // TODO(gameplay): 玩法命令（行动、投票、技能……）逐条加在这里，并在
  // engine.ts 的 decide 分发与 Worker schemas.ts 的公开命令表同步登记；
  // 未实现的玩法命令必须显式 reject __GAME_UPPER___REASONS.notImplemented，不许假绿。
  | { readonly type: '__GAME_ID__.gameplay.example' };

/**
 * Worker-originated commands: the skeleton has no worker-originated
 * flow yet, so the partition is empty. The first asynchronous flow
 * (word supply, media, timers) adds its command here, unions it into
 * `__GAME_PASCAL__Command` below, and replaces the `z.never()`
 * internal schema in the Worker module.
 */
export type __GAME_PASCAL__InternalCommand = never;

/**
 * The full command surface the engine decides. While the internal
 * partition is empty this is the public surface alone — unioning
 * `never` in would be a redundant constituent; the first internal
 * command joins by extending this type to
 * `__GAME_PASCAL__PublicCommand | __GAME_PASCAL__InternalCommand`,
 * and the Worker dispatch typing fails until it does.
 */
export type __GAME_PASCAL__Command = __GAME_PASCAL__PublicCommand;
