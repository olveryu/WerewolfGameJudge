/** Exercises __GAME_PASCAL__ through authoritative commands, never injecting progressed state. */

import { createEngineSession } from '../../../platform/engine/__tests__/engineSession';
import { getBotSeats, isBotSeat } from '../../../platform/room/seating';
import type { __GAME_PASCAL__Command } from '../commands/types';
import { __GAME_UPPER___REASONS } from '../domain/decision';
import { get__GAME_PASCAL__ViewModel } from '../domain/visibility';
import { end__GAME_PASCAL__Game, __GAME_CAMEL__Engine } from '../engine';
import { parse__GAME_PASCAL__State } from '../state/parseState';
import {
  DEFAULT___GAME_UPPER___CONFIG,
  type __GAME_PASCAL__Config,
  type __GAME_PASCAL__State,
} from '../state/types';

function game(
  configOverrides: Partial<__GAME_PASCAL__Config> = {},
  humanCount?: number,
  fillRemainingWithBots = true,
) {
  const numberOfPlayers =
    configOverrides.numberOfPlayers ?? DEFAULT___GAME_UPPER___CONFIG.numberOfPlayers;
  const session = createEngineSession(__GAME_CAMEL__Engine, {
    config: { ...DEFAULT___GAME_UPPER___CONFIG, ...configOverrides },
    parse: parse__GAME_PASCAL__State,
  });
  const send = (
    command: __GAME_PASCAL__Command,
    userId = 'host',
    controlledSeat: number | null = null,
  ) => session.send(command, userId, controlledSeat);
  const decideAs = (
    command: __GAME_PASCAL__Command,
    userId = 'host',
    controlledSeat: number | null = null,
  ) => session.decide(command, userId, controlledSeat);
  const seatUser = (seat: number) => (seat === 0 ? 'host' : `u${seat}`);
  const seatCount = humanCount ?? numberOfPlayers;
  for (let seat = 0; seat < seatCount; seat += 1) {
    send({ type: 'room.seat.take', seat, profile: { displayName: `P${seat}` } }, seatUser(seat));
  }
  if (humanCount !== undefined && humanCount < numberOfPlayers && fillRemainingWithBots) {
    send({ type: 'room.seat.fillBots' });
  }
  return {
    get state(): __GAME_PASCAL__State {
      return session.state;
    },
    effects: session.effects,
    session,
    send,
    decideAs,
    seatUser,
  };
}

function viewAllAndBegin(session: ReturnType<typeof game>): void {
  session.send({ type: '__GAME_ID__.roles.assign' });
  for (let seat = 0; seat < session.state.config.numberOfPlayers; seat += 1) {
    if (isBotSeat(session.state.roster, seat)) continue;
    session.send({ type: '__GAME_ID__.role.viewed' }, session.seatUser(seat));
  }
  if (getBotSeats(session.state.roster).length > 0) {
    session.send({ type: '__GAME_ID__.bots.markAllBotsViewed' });
  }
  session.send({ type: '__GAME_ID__.game.begin' });
}

describe('__GAME_PASCAL__ lobby and seating', () => {
  it('creates an empty lobby and rejects an invalid config', () => {
    const session = game({ numberOfPlayers: 4 });
    expect(session.state.phase).toEqual({ kind: 'lobby' });
    expect(() =>
      __GAME_CAMEL__Engine.createInitialState(
        { numberOfPlayers: 3 },
        { roomCode: '1234', hostUserId: 'host', nowMs: 0, commandId: 'create' },
      ),
    ).toThrow(__GAME_UPPER___REASONS.config);
  });

  it('rejects starting before every seat is filled', () => {
    const session = game({ numberOfPlayers: 4 }, 2, false);
    const decision = session.decideAs({ type: '__GAME_ID__.roles.assign' });
    expect(decision.kind).toBe('reject');
    if (decision.kind === 'reject') expect(decision.reason).toBe(__GAME_UPPER___REASONS.full);
  });

  it('rejects config updates that strand occupied seats', () => {
    const session = game({ numberOfPlayers: 6 }, 5);
    const decision = session.decideAs({
      type: '__GAME_ID__.config.update',
      config: { numberOfPlayers: 4 },
    });
    expect(decision.kind).toBe('reject');
    if (decision.kind === 'reject') expect(decision.reason).toBe(__GAME_UPPER___REASONS.occupied);
  });
});

describe('__GAME_PASCAL__ identity viewing checkpoint', () => {
  it('deals identities into the viewing stage with an empty view record', () => {
    const session = game({ numberOfPlayers: 4 }, 2);
    session.send({ type: '__GAME_ID__.roles.assign' });
    expect(session.state.phase.kind).toBe('viewing');
    expect(Object.keys(session.state.identities)).toHaveLength(4);
    expect(session.state.roleViewedSeats).toEqual([]);
  });

  it('rejects role.viewed in the lobby', () => {
    const session = game({ numberOfPlayers: 4 });
    const decision = session.decideAs({ type: '__GAME_ID__.role.viewed' }, session.seatUser(1));
    expect(decision.kind).toBe('reject');
    if (decision.kind === 'reject') expect(decision.reason).toBe(__GAME_UPPER___REASONS.phase);
  });

  it('holds begin until every seat — bots included — has viewed', () => {
    const session = game({ numberOfPlayers: 4 }, 2);
    session.send({ type: '__GAME_ID__.roles.assign' });
    session.send({ type: '__GAME_ID__.role.viewed' }, session.seatUser(0));
    session.send({ type: '__GAME_ID__.role.viewed' }, session.seatUser(1));
    const blocked = session.decideAs({ type: '__GAME_ID__.game.begin' });
    expect(blocked.kind).toBe('reject');
    if (blocked.kind === 'reject')
      expect(blocked.reason).toBe(__GAME_UPPER___REASONS.notAllViewed);
    session.send({ type: '__GAME_ID__.bots.markAllBotsViewed' });
    session.send({ type: '__GAME_ID__.game.begin' });
    expect(session.state.phase.kind).toBe('playing');
  });

  it('projects identities per viewer: self visible, others hidden until the end', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    session.send({ type: '__GAME_ID__.roles.assign' });
    const view = get__GAME_PASCAL__ViewModel(session.state, 1);
    expect(view.myIdentity).not.toBeNull();
    expect(view.seats.every((seat) => seat.identity === null)).toBe(true);
    expect(view.unviewedRoleSeats).toEqual([0, 1, 2, 3]);
  });
});

describe('__GAME_PASCAL__ gameplay seam', () => {
  it('rejects the example gameplay command as not implemented (no fake green)', () => {
    const session = game({ numberOfPlayers: 4 }, 4);
    viewAllAndBegin(session);
    const decision = session.decideAs({ type: '__GAME_ID__.gameplay.example' });
    expect(decision.kind).toBe('reject');
    if (decision.kind === 'reject')
      expect(decision.reason).toBe(__GAME_UPPER___REASONS.notImplemented);
  });

  it('ends through the terminal seam with exactly one completion effect', () => {
    const session = game({ numberOfPlayers: 4 }, 3);
    viewAllAndBegin(session);
    const decision = end__GAME_PASCAL__Game(session.state, session.session.context('host'));
    expect(decision.kind).toBe('commit');
    if (decision.kind !== 'commit') return;
    expect(decision.effects).toHaveLength(1);
    const completion = decision.effects[0];
    expect(completion?.type).toBe('__GAME_ID__.game.completed');
    if (completion?.type === '__GAME_ID__.game.completed') {
      expect(completion.payload.participantUserIds).toEqual(['host', 'u1', 'u2']);
    }
    const ended = decision.events.reduce(__GAME_CAMEL__Engine.evolve, session.state);
    expect(ended.phase.kind).toBe('ended');
    expect(ended.xpSettled).toBe(true);
    const view = get__GAME_PASCAL__ViewModel(ended, 0);
    expect(view.seats.every((seat) => seat.identity !== null)).toBe(true);
  });
});
