{
  "@ark-ui/react": {
    "entries": [
      "@ark-ui/react/color-picker",
      "@ark-ui/react/dialog",
      "@ark-ui/react/portal",
      "@ark-ui/react/qr-code",
      "@ark-ui/react/tabs",
    ],
    "field": "dependencies",
    "importers": {
      "@ark-ui/react/color-picker": [
        "packages/web/src/features/drawing/components/DrawingToolbar.tsx",
      ],
      "@ark-ui/react/dialog": [
        "packages/web/src/components/AppDialog.tsx",
      ],
    },
    "why": "headless components; styles come from us",
  },
  "@sentry/react": {
    "field": "dependencies",
    "why": "error reporting; renders no UI",
  },
  "@tanstack/react-query": {
    "field": "dependencies",
    "why": "data fetching; renders no UI",
  },
  "@zumer/snapdom": {
    "field": "dependencies",
    "why": "screenshot capture of our own DOM",
  },
  "msw": {
    "field": "devDependencies",
    "why": "admin mock worker, started only in the admin-mock mode",
  },
  "pinyin-pro": {
    "field": "dependencies",
    "why": "text conversion; renders no UI",
  },
  "pixi.js": {
    "field": "dependencies",
    "why": "canvas renderer (D13: its own style writes)",
  },
  "react": {
    "entries": [
      "react",
    ],
    "field": "dependencies",
    "why": "UI runtime",
  },
  "react-dom": {
    "entries": [
      "react-dom/client",
    ],
    "field": "dependencies",
    "why": "createRoot only",
  },
  "react-router": {
    "field": "dependencies",
    "why": "routing; renders no UI",
  },
  "sonner": {
    "field": "dependencies",
    "why": "toasts (D13: injects its own <style>)",
  },
  "zod": {
    "field": "dependencies",
    "why": "validation; renders no UI",
  },
}
`;

